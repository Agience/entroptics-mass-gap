import Mathlib
import MassGap.ExistenceFlow

/-!
# MassGap.ObserverCarries — the observer carries the Hilbert space, and a flat flow carries none

`ClayStatement.ClayData` asks, in its last clause (`ObsGen`), that the Hilbert space of the witness
be generated by the observer: vectors `v P` of the compact margin monomials of every local field,
equal to the observer's compact vectors on `D`, with `⟪v P, v Q⟫ = S_W(θP ∪ Q)` the observer's
flowed Schwinger function (`contSF` of `energy0 W D hD`), carried by `X.base.time (a_m)` to the
vectors of the shifted monomials, and with closed span all of `X.base.H`. This module proves that
the clause excludes every flow under which each local field reads a constant, and every observer
whose form does not see one time step.

## The flat flow

`ExistenceFlow.flatFlow L` flattens the configuration inside the box `[-L_k, L_k]⁴` to a gauge
transform of the identity configuration. With `L_k → ∞`, every local gauge-invariant field reads,
from some step on, the constant `O(1)` at every configuration (`ExistenceFlow.flatFlow_fieldMap`).
The flowed field of `energy0 (flatFlow L) D hD` is a multiple of that field minus a constant, so it
is constant too (`energy0_flat_const`), at every class `D`.

## The steps

* `smear_const`, `state_prod_const`, `latSF_const`: a smeared constant field is a constant function,
  and a state reads a product of constant functions as the product of their values. So once the
  fields of a family are constant, its flowed lattice reading is the product of one number per field.
* `latSF_pair_factor`, `contSF_pair_factor`: for margin monomials `P`, `Q` and the empty monomial
  `E` (`emptyM`), `S_W(θP ∪ Q) = S_W(θP ∪ E) · S_W(θE ∪ Q)` at every large step, and in the limit
  along `ultra` under `UniformBoundF` (`ContinuumFlow.tendsto_contSF`); `contSF_empty`:
  `S_W(θE ∪ E) = 1`. The observer's form has rank one.
* `eq_zero_of_rankOne`: in a complex inner product space, vectors with a rank-one Gram matrix
  `k P Q = k P E · k E Q`, `k E E = 1`, and dense span lie on the line of `v E`; then every vector
  orthogonal to a non-zero vector is `0`.
* `not_clayData_flatFlow`, `not_clayStatementAt_flatFlow`: at `W = flatFlow L` with `L_k → ∞`, no
  witness satisfies `ClayData`, for any reflection-closed class `D`. The clauses read: the
  convergence half of `ApertureConv` (`UniformBoundF`), the Gram identity and `w ∅ = vac` of
  `LinkTS` (so `‖vac‖ = 1`), the non-zero vector of `HL` orthogonal to the vacuum, and `ObsGen`.
  `not_clayStatementAt_flatFlow_symPlaq` is the case `D = SymPlaqClass N`, the class at which
  `ExistenceFlow.flat_hU_hphys_hreach` meets the moment input `hU`.
* `not_clayData_of_timeIndep`: if for one `m` the form satisfies `S_W(θP ∪ s_m Q) = S_W(θP ∪ Q)`,
  no witness satisfies `ClayData`: the time covariance of `ObsGen` makes `X.base.time (a_m)` fix a
  dense set, hence all of `X.base.H`, and the last clause of `HamiltonianGap` puts every vector on
  the vacuum line.

Foundational footprint only (`#print axioms` at the end).

DERIVED (module-wide): `0` the empty monomial's length, the vanishing pairing and the zero vector;
`1` the identity configuration, the empty product and the norm of the vacuum; `4` in `Fin 4` the
spacetime dimension.
-/

noncomputable section

namespace MassGap.ObserverCarries

open MassGap MassGap.InfiniteLattice MassGap.ContinuumField MassGap.ContinuumSchwinger
  MassGap.ContinuumFlow MassGap.ObserverOS MassGap.ObserverEnergyMoments MassGap.ObserverOSLinked
  MassGap.ObserverOSReconstructionS MassGap.ObserverSymField MassGap.ClayStatement
  MassGap.ExistenceFlow Filter
open scoped Topology

variable {N : ℕ}

/-! ## 1. Constant fields -/

section Const

/-- **A smeared constant field is a constant function.**

DERIVED: `1` the identity configuration. -/
theorem smear_const {a : ℝ} (ha : 0 < a) (F : C(Cfg N, ℝ)) (hF : ∀ U, F U = F 1) (f : TestFn) :
    ∀ U, smear a F f U = smear a F f 1 := by
  intro U
  obtain ⟨R, M, hf⟩ := f.2
  rw [smear_eq_sum ha F f hf (Finset.Subset.refl _)]
  simp only [ContinuousMap.coe_sum, Finset.sum_apply, ContinuousMap.coe_smul, Pi.smul_apply,
    transObs_apply, smul_eq_mul]
  exact Finset.sum_congr rfl (fun x _ => by rw [hF, hF (transConf x 1)])

#print axioms smear_const

/-- **A state reads a product of constant functions as the product of their values.**

DERIVED: `1` the identity configuration and the unit observable. -/
theorem state_prod_const (ν : MassGap.DLRLimit.State (Cfg N)) {ι : Type} [Fintype ι]
    (g : ι → C(Cfg N, ℝ)) (h : ∀ i U, g i U = g i 1) : ν (∏ i, g i) = ∏ i, g i 1 := by
  have e : (∏ i, g i) = (∏ i, g i 1) • (1 : C(Cfg N, ℝ)) := by
    ext U
    simp only [ContinuousMap.coe_prod, Finset.prod_apply, ContinuousMap.smul_apply,
      ContinuousMap.one_apply, smul_eq_mul, mul_one]
    exact Finset.prod_congr rfl (fun i _ => h i U)
  rw [e, MassGap.DLRLimit.State.map_smul, MassGap.DLRLimit.State.map_one, mul_one]

#print axioms state_prod_const

/-- The flowed field of `O` at step `k` is constant. DERIVED: `1` the identity configuration. -/
def CstAt (Φ : Flow N) (k : ℕ) (O : LField (MassGap.SUN.SU N)) : Prop :=
  ∀ U : Cfg N, (Φ.map k O).1 U = (Φ.map k O).1 1

/-- The value of a smeared field at the identity configuration, at step `k`.

DERIVED: `1` the identity configuration. -/
def sval (Φ : Flow N) (k : ℕ) (p : SField N) : ℝ :=
  smear (dySpacing N k) (Φ.map k p.1).1 p.2 1

/-- **Once the fields of a family are constant, its flowed lattice reading is the product of one
number per field.**

DERIVED: `0` the excluded colour count. -/
theorem latSF_const (hN : N ≠ 0) (Φ : Flow N) (k : ℕ) {ι : Type} [Fintype ι] (F : ι → SField N)
    (h : ∀ i, CstAt Φ k (F i).1) : latSF hN Φ k F = ∏ i, sval Φ k (F i) := by
  show stateK hN k (∏ i, smear (dySpacing N k) (Φ.map k (F i).1).1 (F i).2) = _
  exact state_prod_const _ _ (fun i => smear_const (dySpacing_pos (one_le_of_ne_zero hN) k) _
    (h i) (F i).2)

#print axioms latSF_const

/-- **Through the flat flow every flowed field of `energy0` is eventually constant**, at every
class `D`: it is `z · (O ∘ V_k − c)`, and `O ∘ V_k` reads `O(1)` from some step on.

DERIVED: `1` the identity configuration. -/
theorem energy0_flat_const {L : ℕ → ℕ} (hL : Tendsto L atTop atTop)
    (D : Set (LField (MassGap.SUN.SU N)))
    (hD : ∀ (τ : Fin 4) (O : LField (MassGap.SUN.SU N)), O.refl τ ∈ D ↔ O ∈ D)
    (O : LField (MassGap.SUN.SU N)) :
    ∀ᶠ k in atTop, CstAt (energy0 (flatFlow (N := N) L) D hD) k O := by
  filter_upwards [flatFlow_fieldMap hL O] with k hk U
  change (zOn D k O • (((flatFlow (N := N) L).fieldMap k O).1
      - sOn D (s0 N) k O • (1 : C(Cfg N, ℝ)))) U
    = (zOn D k O • (((flatFlow (N := N) L).fieldMap k O).1
      - sOn D (s0 N) k O • (1 : C(Cfg N, ℝ)))) 1
  simp only [ContinuousMap.smul_apply, ContinuousMap.sub_apply, ContinuousMap.one_apply, hk U,
    hk 1]

#print axioms energy0_flat_const

end Const

/-! ## 2. The observer's form has rank one -/

section RankOne

variable {τ : Fin 4} {r : ℝ}

/-- **The empty margin monomial.** DERIVED: `0` its length; `1` the margin above `|r|`. -/
def emptyM (τ : Fin 4) (r : ℝ) : MarginMono N τ r :=
  ⟨⟨0, Fin.elim0⟩, ⟨|r| + 1, by positivity, by linarith [le_abs_self r], fun i => Fin.elim0 i⟩⟩

/-- **The flowed lattice reading of `θP ∪ Q` factors** once the fields of `P` and `Q` are
constant: `S_k(θP ∪ Q) = S_k(θP ∪ E) · S_k(θE ∪ Q)`.

DERIVED: `0` the excluded colour count; `1` the empty products. -/
theorem latSF_pair_factor (hN : N ≠ 0) (Φ : Flow N) (k : ℕ) (P Q : MarginMono N τ r)
    (hP : ∀ i, CstAt Φ k (SField.refl τ (P.1.2 i)).1) (hQ : ∀ j, CstAt Φ k (Q.1.2 j).1) :
    latSF hN Φ k (pairFam τ P.1 Q.1)
      = latSF hN Φ k (pairFam τ P.1 (emptyM τ r).1)
        * latSF hN Φ k (pairFam τ (emptyM τ r).1 Q.1) := by
  haveI : IsEmpty (Fin (emptyM (N := N) τ r).1.1) := by
    show IsEmpty (Fin 0)
    infer_instance
  rw [latSF_const hN Φ k (pairFam τ P.1 Q.1) (fun x => by
        cases x with
        | inl i => exact hP i
        | inr j => exact hQ j),
    latSF_const hN Φ k (pairFam τ P.1 (emptyM τ r).1) (fun x => by
        cases x with
        | inl i => exact hP i
        | inr j => exact isEmptyElim j),
    latSF_const hN Φ k (pairFam τ (emptyM τ r).1 Q.1) (fun x => by
        cases x with
        | inl i => exact isEmptyElim i
        | inr j => exact hQ j)]
  rw [Fintype.prod_sum_type, Fintype.prod_sum_type, Fintype.prod_sum_type,
    Fintype.prod_empty (ι := Fin (emptyM (N := N) τ r).1.1),
    Fintype.prod_empty (ι := Fin (emptyM (N := N) τ r).1.1), mul_one, one_mul]
  try rfl

#print axioms latSF_pair_factor

/-- **`S_W(θE ∪ E) = 1`**: the reading of the empty family is the state of `1` at every step.

DERIVED: `0` the excluded colour count; `1` the value. -/
theorem contSF_empty (hN : N ≠ 0) (Φ : Flow N) :
    contSF hN Φ (pairFam τ (emptyM (N := N) τ r).1 (emptyM τ r).1) = 1 := by
  haveI : ((ultra : Ultrafilter ℕ) : Filter ℕ).NeBot := ultra.neBot'
  have e : (fun k => latSF hN Φ k (pairFam τ (emptyM (N := N) τ r).1 (emptyM τ r).1))
      = fun _ => (1 : ℝ) := by
    funext k
    haveI : IsEmpty (Fin (emptyM (N := N) τ r).1.1 ⊕ Fin (emptyM (N := N) τ r).1.1) := by
      show IsEmpty (Fin 0 ⊕ Fin 0)
      infer_instance
    show stateK hN k (∏ i, smear _ _ _) = 1
    rw [Fintype.prod_empty]
    exact MassGap.DLRLimit.State.map_one _
  unfold contSF
  rw [e]
  exact tendsto_const_nhds.limUnder_eq

#print axioms contSF_empty

/-- **The limit factors**: if the fields of `P` and `Q` are eventually constant and the flow is
uniformly bounded, `S_W(θP ∪ Q) = S_W(θP ∪ E) · S_W(θE ∪ Q)`.

DERIVED: `0` the excluded colour count. -/
theorem contSF_pair_factor (hN : N ≠ 0) (Φ : Flow N) (hB : UniformBoundF hN Φ)
    (hC : ∀ O, ∀ᶠ k in atTop, CstAt Φ k O) (P Q : MarginMono N τ r) :
    contSF hN Φ (pairFam τ P.1 Q.1)
      = contSF hN Φ (pairFam τ P.1 (emptyM τ r).1) * contSF hN Φ (pairFam τ (emptyM τ r).1 Q.1) := by
  haveI : ((ultra : Ultrafilter ℕ) : Filter ℕ).NeBot := ultra.neBot'
  have hev : ∀ᶠ k in atTop, latSF hN Φ k (pairFam τ P.1 Q.1)
      = latSF hN Φ k (pairFam τ P.1 (emptyM τ r).1)
        * latSF hN Φ k (pairFam τ (emptyM τ r).1 Q.1) := by
    filter_upwards [Filter.eventually_all.2 (fun i => hC (SField.refl τ (P.1.2 i)).1),
      Filter.eventually_all.2 (fun j => hC (Q.1.2 j).1)] with k hP hQ
    exact latSF_pair_factor hN Φ k P Q hP hQ
  have h2 := (tendsto_contSF hN Φ hB (pairFam τ P.1 (emptyM τ r).1)).mul
    (tendsto_contSF hN Φ hB (pairFam τ (emptyM τ r).1 Q.1))
  exact tendsto_nhds_unique (tendsto_contSF hN Φ hB (pairFam τ P.1 Q.1))
    (h2.congr' (EventuallyEq.symm (hev.filter_mono ultra_le)))

#print axioms contSF_pair_factor

end RankOne

/-! ## 3. A rank-one form spans a line -/

section Line

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- **Vectors with a rank-one Gram matrix and dense span leave no room orthogonal to a non-zero
vector.** If `⟪v P, v Q⟫ = k P Q` with `k P Q = k P E · k E Q` and `k E E = 1`, then
`v P = k E P · v E` (the norm of the difference is `0`), so the closed span is the line of `v E`;
when it is the whole space, a vector orthogonal to a non-zero `x` is `0`.

DERIVED: `0` the vanishing pairing and the zero vector; `1` the norm of `v E`. -/
theorem eq_zero_of_rankOne {M : Type*} (v : M → H) (E : M) (k : M → M → ℝ)
    (hG : ∀ P Q, inner ℂ (v P) (v Q) = (k P Q : ℂ)) (hfac : ∀ P Q, k P Q = k P E * k E Q)
    (hEE : k E E = 1) (hgen : (Submodule.span ℂ (Set.range v)).topologicalClosure = ⊤)
    {x : H} (hx : x ≠ 0) {u : H} (hu : inner ℂ x u = 0) : u = 0 := by
  have hline : ∀ P, v P = ((k E P : ℝ) : ℂ) • v E := by
    intro P
    have h0 : inner ℂ (v P - ((k E P : ℝ) : ℂ) • v E) (v P - ((k E P : ℝ) : ℂ) • v E) = 0 := by
      simp only [inner_sub_left, inner_sub_right, inner_smul_left, inner_smul_right, hG,
        hfac P P, hEE, Complex.conj_ofReal]
      push_cast
      ring
    exact sub_eq_zero.mp (inner_self_eq_zero.mp h0)
  have hspan : Submodule.span ℂ (Set.range v) ≤ ℂ ∙ v E := by
    rw [Submodule.span_le]
    rintro _ ⟨P, rfl⟩
    rw [hline P]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
  have htop : (⊤ : Submodule ℂ H) ≤ ℂ ∙ v E := by
    rw [← hgen]
    refine (Submodule.topologicalClosure_mono hspan).trans_eq ?_
    exact (Submodule.closed_of_finiteDimensional _).submodule_topologicalClosure_eq
  obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp (htop (Submodule.mem_top (x := x)))
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp (htop (Submodule.mem_top (x := u)))
  have hEE' : inner ℂ (v E) (v E) = 1 := by rw [hG, hEE]; simp
  have hb0 : b ≠ 0 := by
    rintro rfl
    exact hx (by rw [← hb, zero_smul])
  rw [← hb, ← ha, inner_smul_left, inner_smul_right, hEE', mul_one] at hu
  have ha0 : a = 0 := by
    rcases mul_eq_zero.mp hu with h | h
    · exact absurd (by simpa using h) hb0
    · exact h
  rw [← ha, ha0, zero_smul]

#print axioms eq_zero_of_rankOne

end Line

/-! ## 4. The flat flow carries no witness -/

section Flat

/-- **No witness at the flat flow.** At `W = flatFlow L` with `L_k → ∞` and any reflection-closed
class `D`, `ClayData` fails at every witness: `ApertureConv` gives `UniformBoundF`, the flowed
fields are eventually constant (`energy0_flat_const`), so the observer's form has rank one
(`contSF_pair_factor`, `contSF_empty`); `ObsGen` makes `X.base.H` the closed span of vectors with
that Gram matrix, a line (`eq_zero_of_rankOne`); `LinkTS` gives `w ∅ = vac` with
`⟪w ∅, w ∅⟫ = S(Θ∅ ∪ ∅) = 1`, so `vac ≠ 0`; and the clause asking a non-zero vector of `HL`
orthogonal to the vacuum cannot hold.

DERIVED: `2` the least colour count; `0` the vanishing pairing and the zero vector; `1` the norm of
the vacuum. -/
theorem not_clayData_flatFlow (hN2 : 2 ≤ N) {L : ℕ → ℕ} (hL : Tendsto L atTop atTop)
    (D : Set (LField (MassGap.SUN.SU N)))
    (hD : ∀ (τ : Fin 4) (O : LField (MassGap.SUN.SU N)), O.refl τ ∈ D ↔ O ∈ D) {τ : Fin 4}
    {r : ℝ} (X : OSDataSLinked N D τ r) (ρ : RenormMix N) (G : ℝ → ℝ) (w : TSep τ → X.base.H)
    (C : Composites N) (wC : TSepG C.Ix τ → X.base.H) :
    ¬ ClayData hN2 (flatFlow (N := N) L) D hD τ r X ρ G w C wC := by
  intro h
  obtain ⟨-, -, -, -, -, -, -, -, -, hLT, -, -, -, hnt, -, -, -, -, -, hAC, -, -, -, -, -, -, -, -,
    -, -, -, hGen⟩ := h
  obtain ⟨v, -, hG, -, hgen⟩ := hGen
  set hN := ne_zero_of_two_le hN2
  set Φ := energy0 (flatFlow (N := N) L) D hD
  have hvac : X.base.vac ≠ 0 := by
    intro h0
    have h1 := (hLT.1 (emptyT τ) (emptyT τ)).2
    rw [hLT.2.2.1, h0, inner_zero_left, kernT_empty] at h1
    norm_num at h1
  obtain ⟨u, -, hu0, hune⟩ := hnt
  exact hune (eq_zero_of_rankOne v (emptyM τ r)
    (fun P Q => contSF hN Φ (pairFam τ P.1 Q.1)) hG
    (fun P Q => contSF_pair_factor hN Φ hAC.1 (energy0_flat_const hL D hD) P Q)
    (contSF_empty hN Φ) hgen hvac hu0)

#print axioms not_clayData_flatFlow

/-- **`ClayStatementAt` fails at the flat flow**, at every reflection-closed class `D`, when
`L_k → ∞`.

DERIVED: `2` the least colour count. -/
theorem not_clayStatementAt_flatFlow (hN2 : 2 ≤ N) {L : ℕ → ℕ} (hL : Tendsto L atTop atTop)
    (D : Set (LField (MassGap.SUN.SU N)))
    (hD : ∀ (τ : Fin 4) (O : LField (MassGap.SUN.SU N)), O.refl τ ∈ D ↔ O ∈ D) :
    ¬ ClayStatementAt hN2 (flatFlow (N := N) L) D hD := by
  rintro ⟨τ, r, X, ρ, G, w, C, wC, h, -⟩
  exact not_clayData_flatFlow hN2 hL D hD X ρ G w C wC h

#print axioms not_clayStatementAt_flatFlow

/-- **At the class of the capstones**: `ClayStatementAt` fails at `flatFlow (flatL N)`, the flow at
which `ExistenceFlow.flat_hU_hphys_hreach` meets `hU`, vanishing reach and `PhysRange`.

DERIVED: `2` the least colour count. -/
theorem not_clayStatementAt_flatFlow_symPlaq (hN2 : 2 ≤ N) :
    ¬ ClayStatementAt hN2 (flatFlow (N := N) (flatL N)) (SymPlaqClass N) (symPlaq_refl N) :=
  not_clayStatementAt_flatFlow hN2 (tendsto_flatL (ne_zero_of_two_le hN2)) _ _

#print axioms not_clayStatementAt_flatFlow_symPlaq

end Flat

/-! ## 5. A time-independent observer carries no witness -/

section TimeIndep

/-- **No witness when the observer's form does not see one time step.** If for one `m` the flowed
Schwinger functions satisfy `S_W(θP ∪ s_m Q) = S_W(θP ∪ Q)` for all margin monomials (`s_m` the shift
by `a_m` in the direction `τ`), then `ClayData` fails at every witness at `τ`, `r`: by `ObsGen`,
`v (s_m Q) − v Q` is orthogonal to every `v P`, hence `0`, so `X.base.time (a_m)` fixes every `v Q`,
hence all of `X.base.H`; the last clause of `HamiltonianGap` puts every vector on the vacuum line,
and no non-zero vector of `HL` is orthogonal to the vacuum.

DERIVED: `2` the least colour count; `0` the vanishing pairing, the zero vector and the sign of
`a_m`. -/
theorem not_clayData_of_timeIndep (hN2 : 2 ≤ N) (W : ConfFlow N)
    (D : Set (LField (MassGap.SUN.SU N)))
    (hD : ∀ (τ : Fin 4) (O : LField (MassGap.SUN.SU N)), O.refl τ ∈ D ↔ O ∈ D) {τ : Fin 4}
    {r : ℝ} (m : ℕ)
    (hti : ∀ P Q : MarginMono N τ r,
      contSF (ne_zero_of_two_le hN2) (energy0 W D hD)
          (pairFam τ P.1 (MarginMono.shift (ne_zero_of_two_le hN2) τ m Q).1)
        = contSF (ne_zero_of_two_le hN2) (energy0 W D hD) (pairFam τ P.1 Q.1))
    (X : OSDataSLinked N D τ r) (ρ : RenormMix N) (G : ℝ → ℝ) (w : TSep τ → X.base.H)
    (C : Composites N) (wC : TSepG C.Ix τ → X.base.H) :
    ¬ ClayData hN2 W D hD τ r X ρ G w C wC := by
  intro h
  obtain ⟨-, hH, -, -, -, -, -, -, -, -, -, -, -, hnt, -, -, -, -, -, -, -, -, -, -, -, -, -, -,
    -, -, -, hGen⟩ := h
  obtain ⟨v, -, hG, hT, hgen'⟩ := hGen
  have hgen : (Submodule.span ℂ (Set.range v)).topologicalClosure = ⊤ := hgen'
  set hN := ne_zero_of_two_le hN2
  -- the shifted vector equals the vector
  have hfix : ∀ Q : MarginMono N τ r, v (MarginMono.shift hN τ m Q) = v Q := by
    intro Q
    set d := v (MarginMono.shift hN τ m Q) - v Q
    have hle : Submodule.span ℂ (Set.range v) ≤ (ℂ ∙ d)ᗮ := by
      rw [Submodule.span_le]
      rintro _ ⟨P, rfl⟩
      rw [SetLike.mem_coe, Submodule.mem_orthogonal_singleton_iff_inner_right,
        inner_eq_zero_symm]
      show inner ℂ (v P) (v (MarginMono.shift hN τ m Q) - v Q) = 0
      rw [inner_sub_right, hG, hG, hti P Q, sub_self]
    have htop : (⊤ : Submodule ℂ X.base.H) ≤ (ℂ ∙ d)ᗮ := by
      have h1 := Submodule.topologicalClosure_mono hle
      rw [(Submodule.isClosed_orthogonal (ℂ ∙ d)).submodule_topologicalClosure_eq, hgen] at h1
      exact h1
    have hd := htop (Submodule.mem_top (x := d))
    rw [Submodule.mem_orthogonal_singleton_iff_inner_right, inner_self_eq_zero] at hd
    exact sub_eq_zero.mp hd
  -- the time step fixes the whole space
  have hker : ∀ x : X.base.H, X.base.time (dySpacing N m) x = x := by
    let T : X.base.H →L[ℂ] X.base.H :=
      X.base.time (dySpacing N m) - ContinuousLinearMap.id ℂ X.base.H
    let K : Submodule ℂ X.base.H := LinearMap.ker (T : X.base.H →ₗ[ℂ] X.base.H)
    have hmem : ∀ x, x ∈ K ↔ X.base.time (dySpacing N m) x = x := by
      intro x
      show T x = 0 ↔ _
      show X.base.time (dySpacing N m) x - x = 0 ↔ _
      exact sub_eq_zero
    have hle : Submodule.span ℂ (Set.range v) ≤ K := by
      rw [Submodule.span_le]
      rintro _ ⟨Q, rfl⟩
      rw [SetLike.mem_coe, hmem, ← hT m Q (MarginMono.shift hN τ m Q) rfl, hfix Q]
    have hcl : IsClosed (K : Set X.base.H) := ContinuousLinearMap.isClosed_ker T
    have h1 := Submodule.topologicalClosure_mono hle
    rw [hcl.submodule_topologicalClosure_eq, hgen] at h1
    intro x
    exact (hmem x).mp (h1 (Submodule.mem_top (x := x)))
  obtain ⟨u, -, hu0, hune⟩ := hnt
  obtain ⟨c, hc⟩ := hH.2.2.2.2 (dySpacing N m) (dySpacing_pos (one_le_of_ne_zero hN) m) u
    (hker u)
  have hvac : X.base.vac ≠ 0 := by
    rintro h0
    exact hune (by rw [hc, h0, smul_zero])
  rw [hc, inner_smul_right] at hu0
  have hvv : inner ℂ X.base.vac X.base.vac ≠ 0 := inner_self_ne_zero.mpr hvac
  have c0 : c = 0 := (mul_eq_zero.mp hu0).resolve_right hvv
  exact hune (by rw [hc, c0, zero_smul])

