import Mathlib
import MassGap.ContinuumFlow
import MassGap.ContinuumClay

/-!
# MassGap.FlowCapstone — the continuum gap on the observer's reconstructed space

`ContinuumFlow` builds the continuum theory of a flow: a configuration map of fixed physical range,
read at every lattice spacing. A flow is an observer at a fixed physical resolution. For a bounded flow
the uniform bound is proved outright (`ContinuumFlow.uniformBoundF_of_bounded`), the Hilbert space
and transfer operator are built (`ContinuumFlow.flowTransfer`), and a non-zero vector orthogonal to the
vacuum follows from one statement about the observer's limit, `ContinuumFlow.FlowConnectedNonzero`
(`ContinuumFlow.exists_orth_ne_zero_flow`). This module adds the gap.

1. **The gap of a kernel transfer from clustering** (`gapAt_gTransfer_of_cluster`): for the transfer data
   `ContinuumFlow.gTransfer` of any positive kernel `K`, a reflected clustering bound
   `(K P (shⁿ Q) − K P e · K e Q)² ≤ (ρⁿ)² · K P P · (K Q Q − (K e Q)²)` gives `GapAt ρ`.
2. **Flowed functions are bare functions of the flowed monomials** (`latSF_eq_bare`): the flowed lattice
   Schwinger function of `θP ∪ Q` is the bare renormalised one of `θ(Φ P) ∪ Φ Q`.
3. **The flowed clustering bound** (`kernF_cluster_of_fixedWindowDecay`): `FixedWindowDecay` gives the
   lattice gap at every large step (`WeakCouplingWindow.gapAt_physical_of_fixedWindowDecay`);
   `ContinuumCluster.lattice_cluster`, at the bare renormalisation and the flowed monomials, gives the
   step's clustering bound, and the limit along `ultra` carries it to `kernF`.
4. **The capstone** (`flow_clay_of_bounded_cluster`, `flow_clay_of_bounded`): at every dyadic step the
   flowed transfer is `ContinuumClay.GappedAt` at physical rate `c/L` and `ContinuumClay.NontrivialVacuum`,
   from the observer's clustering `FlowCluster` (which `FixedWindowDecay` implies) and
   `FlowConnectedNonzero`, with no uniform-bound hypothesis on a bounded flow. The flowed Hilbert space is
   generated by the observer's fields alone, so its gap consumes only the observer's clustering.
-/

namespace MassGap.FlowCapstone

open MassGap MassGap.InfiniteLattice MassGap.ContinuumField MassGap.ContinuumSchwinger
  MassGap.ContinuumCluster MassGap.ContinuumSep MassGap.ContinuumFlow Filter
open scoped Topology

/-! ## 1. The gap of a kernel transfer from clustering -/

section Generic

variable {M : Type}

/-- The form of a combination against an iterate of the shift, as a double sum.

DERIVED: no numeral. -/
theorem gForm_iterate_eq (K : M → M → ℝ) (sh : M → M) (n : ℕ) (x : M →₀ ℝ) :
    gForm K x ((⇑(gT sh))^[n] x)
      = ∑ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * K P (sh^[n] Q) := by
  rw [gT_iterate, gForm_mapDomain_right]
  rfl

#print axioms gForm_iterate_eq

/-- The form of a combination against a single basis vector.

DERIVED: `1` is the coefficient of the basis vector. -/
theorem gForm_single_right (K : M → M → ℝ) (x : M →₀ ℝ) (e : M) :
    gForm K x (Finsupp.single e 1) = ∑ P ∈ x.support, x P * K P e := by
  unfold gForm
  refine Finset.sum_congr rfl (fun P _ => ?_)
  show (Finsupp.single e (1 : ℝ)).sum (fun Q b => x P * b * K P Q) = x P * K P e
  rw [Finsupp.sum_single_index (by simp)]
  ring

#print axioms gForm_single_right

/-- **Per-vector decay from clustering.** For a symmetric kernel, every combination orthogonal to the
basis vector `e` has a constant `C` with `⟨x, shⁿ x⟩ ≤ C ρⁿ`: both vacuum sums vanish, so the form is
the double sum of connected kernels, each at most `ρⁿ` times the square root of its clustering
weight.

DERIVED: `2` is the square; `1` the vacuum coefficient; `0` the vanishing pairing and the sign of
`ρ`. -/
theorem form_iterate_le_of_cluster (K : M → M → ℝ) (hK : ∀ P Q, K P Q = K Q P) (sh : M → M)
    (e : M) {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hcl : ∀ (P Q : M) (n : ℕ),
      (K P (sh^[n] Q) - K P e * K e Q) ^ 2 ≤ (ρ ^ n) ^ 2 * (K P P * (K Q Q - K e Q ^ 2)))
    (x : M →₀ ℝ) (hx : gForm K x (Finsupp.single e 1) = 0) :
    ∃ C : ℝ, ∀ n : ℕ, gForm K x ((⇑(gT sh))^[n] x) ≤ C * ρ ^ n := by
  have hvacR : ∑ P ∈ x.support, x P * K P e = 0 := by
    rw [← gForm_single_right]; exact hx
  have hvacL : ∑ Q ∈ x.support, x Q * K e Q = 0 := by
    rw [← hvacR]; exact Finset.sum_congr rfl (fun Q _ => by rw [hK e Q])
  refine ⟨∑ P ∈ x.support, ∑ Q ∈ x.support, |x P| * |x Q| * Real.sqrt (K P P * (K Q Q - K e Q ^ 2)),
    fun n => ?_⟩
  have hconn : ∀ P Q : M, |K P (sh^[n] Q) - K P e * K e Q|
      ≤ ρ ^ n * Real.sqrt (K P P * (K Q Q - K e Q ^ 2)) :=
    fun P Q => abs_le_mul_sqrt_of_sq_le_sep (pow_nonneg hρ n) (hcl P Q n)
  have hsplit : ∑ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * K P (sh^[n] Q)
      = ∑ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * (K P (sh^[n] Q) - K P e * K e Q)
        + ∑ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * (K P e * K e Q) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun P _ => ?_)
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun Q _ => ?_)
    ring
  have hzero : ∑ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * (K P e * K e Q) = 0 := by
    have h : ∀ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * (K P e * K e Q)
        = x P * K P e * ∑ Q ∈ x.support, x Q * K e Q := by
      intro P _
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun Q _ => by ring)
    rw [Finset.sum_congr rfl h, hvacL]
    simp
  rw [gForm_iterate_eq, hsplit, hzero, add_zero]
  calc ∑ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * (K P (sh^[n] Q) - K P e * K e Q)
      ≤ ∑ P ∈ x.support, ∑ Q ∈ x.support, |x P| * |x Q|
          * (ρ ^ n * Real.sqrt (K P P * (K Q Q - K e Q ^ 2))) := by
        refine Finset.sum_le_sum (fun P _ => Finset.sum_le_sum (fun Q _ => ?_))
        refine le_trans (le_abs_self _) ?_
        rw [abs_mul, abs_mul]
        exact mul_le_mul_of_nonneg_left (hconn P Q) (mul_nonneg (abs_nonneg _) (abs_nonneg _))
    _ = (∑ P ∈ x.support, ∑ Q ∈ x.support, |x P| * |x Q|
          * Real.sqrt (K P P * (K Q Q - K e Q ^ 2))) * ρ ^ n := by
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl (fun P _ => ?_)
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl (fun Q _ => ?_)
        ring

#print axioms form_iterate_le_of_cluster

/-- **The gap of a kernel transfer from clustering**: `GapAt (gTransfer …) ρ` under the reflected
clustering bound at rate `ρ` (`ContinuumSep.gapAt_of_per_vector_form_decay` at even separations).

DERIVED: `2` is the square and the doubled separation; `0` is the sign of `ρ`. -/
theorem gapAt_gTransfer_of_cluster (K : M → M → ℝ) (hK : ∀ P Q, K P Q = K Q P)
    (hG : ∀ (s : Finset M) (c : M → ℝ), 0 ≤ ∑ P ∈ s, ∑ Q ∈ s, c P * c Q * K P Q)
    (sh : M → M) (hsh : ∀ P Q, K (sh P) Q = K P (sh Q))
    (hb : ∀ P Q, ∃ C : ℝ, ∀ n : ℕ, |K (sh^[n] P) (sh^[n] Q)| ≤ C)
    (e : M) (he : sh e = e) (hee : K e e = 1) {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hcl : ∀ (P Q : M) (n : ℕ),
      (K P (sh^[n] Q) - K P e * K e Q) ^ 2 ≤ (ρ ^ n) ^ 2 * (K P P * (K Q Q - K e Q ^ 2))) :
    TransferGap.GapAt (gTransfer K hK hG sh hsh hb e he hee) ρ := by
  refine gapAt_of_per_vector_form_decay _ hρ (fun x hx => ?_)
  obtain ⟨C, hC⟩ := form_iterate_le_of_cluster K hK sh e hρ hcl x hx
  refine ⟨C, fun n => ?_⟩
  rw [Module.End.pow_apply]
  exact hC (2 * n)

#print axioms gapAt_gTransfer_of_cluster

/-- **Per-vector decay from absolute clustering.** If every pair has its own constant `C` with
`|K P (shⁿ Q) − K P e · K e Q| ≤ C ρⁿ`, every combination orthogonal to `e` decays at rate `ρ`: the
vacuum sums vanish and the double sum of connected kernels is bounded term by term. The constants
may depend on the pair; only the rate is common.

DERIVED: `1` is the vacuum coefficient; `0` is the vanishing pairing. -/
theorem form_iterate_le_of_abs_cluster (K : M → M → ℝ) (hK : ∀ P Q, K P Q = K Q P) (sh : M → M)
    (e : M) {ρ : ℝ}
    (hcl : ∀ P Q : M, ∃ C : ℝ, ∀ n : ℕ, |K P (sh^[n] Q) - K P e * K e Q| ≤ C * ρ ^ n)
    (x : M →₀ ℝ) (hx : gForm K x (Finsupp.single e 1) = 0) :
    ∃ C : ℝ, ∀ n : ℕ, gForm K x ((⇑(gT sh))^[n] x) ≤ C * ρ ^ n := by
  classical
  have hvacR : ∑ P ∈ x.support, x P * K P e = 0 := by
    rw [← gForm_single_right]; exact hx
  have hvacL : ∑ Q ∈ x.support, x Q * K e Q = 0 := by
    rw [← hvacR]; exact Finset.sum_congr rfl (fun Q _ => by rw [hK e Q])
  let Cf : M → M → ℝ := fun P Q => Classical.choose (hcl P Q)
  have hCf : ∀ P Q n, |K P (sh^[n] Q) - K P e * K e Q| ≤ Cf P Q * ρ ^ n :=
    fun P Q => Classical.choose_spec (hcl P Q)
  refine ⟨∑ P ∈ x.support, ∑ Q ∈ x.support, |x P| * |x Q| * Cf P Q, fun n => ?_⟩
  have hsplit : ∑ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * K P (sh^[n] Q)
      = ∑ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * (K P (sh^[n] Q) - K P e * K e Q)
        + ∑ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * (K P e * K e Q) := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun P _ => ?_)
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun Q _ => ?_)
    ring
  have hzero : ∑ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * (K P e * K e Q) = 0 := by
    have h : ∀ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * (K P e * K e Q)
        = x P * K P e * ∑ Q ∈ x.support, x Q * K e Q := by
      intro P _
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun Q _ => by ring)
    rw [Finset.sum_congr rfl h, hvacL]
    simp
  rw [gForm_iterate_eq, hsplit, hzero, add_zero]
  calc ∑ P ∈ x.support, ∑ Q ∈ x.support, x P * x Q * (K P (sh^[n] Q) - K P e * K e Q)
      ≤ ∑ P ∈ x.support, ∑ Q ∈ x.support, |x P| * |x Q| * (Cf P Q * ρ ^ n) := by
        refine Finset.sum_le_sum (fun P _ => Finset.sum_le_sum (fun Q _ => ?_))
        refine le_trans (le_abs_self _) ?_
        rw [abs_mul, abs_mul]
        exact mul_le_mul_of_nonneg_left (hCf P Q n) (mul_nonneg (abs_nonneg _) (abs_nonneg _))
    _ = (∑ P ∈ x.support, ∑ Q ∈ x.support, |x P| * |x Q| * Cf P Q) * ρ ^ n := by
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl (fun P _ => ?_)
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl (fun Q _ => ?_)
        ring

#print axioms form_iterate_le_of_abs_cluster

/-- **The gap of a kernel transfer from absolute clustering**: pair-dependent constants and one rate.

DERIVED: `2` is the doubled separation; `0` is the sign of `ρ`. -/
theorem gapAt_gTransfer_of_abs_cluster (K : M → M → ℝ) (hK : ∀ P Q, K P Q = K Q P)
    (hG : ∀ (s : Finset M) (c : M → ℝ), 0 ≤ ∑ P ∈ s, ∑ Q ∈ s, c P * c Q * K P Q)
    (sh : M → M) (hsh : ∀ P Q, K (sh P) Q = K P (sh Q))
    (hb : ∀ P Q, ∃ C : ℝ, ∀ n : ℕ, |K (sh^[n] P) (sh^[n] Q)| ≤ C)
    (e : M) (he : sh e = e) (hee : K e e = 1) {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hcl : ∀ P Q : M, ∃ C : ℝ, ∀ n : ℕ, |K P (sh^[n] Q) - K P e * K e Q| ≤ C * ρ ^ n) :
    TransferGap.GapAt (gTransfer K hK hG sh hsh hb e he hee) ρ := by
  refine gapAt_of_per_vector_form_decay _ hρ (fun x hx => ?_)
  obtain ⟨C, hC⟩ := form_iterate_le_of_abs_cluster K hK sh e hcl x hx
  refine ⟨C, fun n => ?_⟩
  rw [Module.End.pow_apply]
  exact hC (2 * n)

#print axioms gapAt_gTransfer_of_abs_cluster

end Generic

/-! ## 2. Flowed functions are bare functions of the flowed monomials -/

section Bare

variable {N : ℕ}

/-- Subtracting zero leaves a field unchanged.

DERIVED: `0` is the subtraction. -/
theorem sub_zero_field (O : LField (MassGap.SUN.SU N)) : O.sub 0 = O :=
  Subtype.ext (by simp [LField.sub])

#print axioms sub_zero_field

/-- The bare renormalised lattice function is the lattice function.

DERIVED: `0` is the excluded colour count. -/
theorem latSkR_bare (hN : N ≠ 0) (k : ℕ) {ι : Type} [Fintype ι] (F : ι → SField N) :
    latSkR hN (Renorm.bare N) k F = latSk hN k F := by
  have hfield : (fun i => (Renorm.bare N).field k (F i)) = F := by
    funext i
    show ((F i).1.sub 0, (F i).2) = F i
    rw [sub_zero_field]
  have hpref : (Renorm.bare N).pref k F = 1 := by
    simp [Renorm.pref, Renorm.bare]
  unfold latSkR
  rw [hpref, hfield, one_mul]

#print axioms latSkR_bare

/-- **Flowed reflected functions are bare reflected functions of the flowed monomials.**

DERIVED: `0` is the excluded colour count; `4` in `Fin 4` is the spacetime dimension. -/
theorem latSF_eq_bare (hN : N ≠ 0) (Φ : Flow N) (τ : Fin 4) (k : ℕ) (P Q : Mono N) :
    latSF hN Φ k (pairFam τ P Q)
      = latSkR hN (Renorm.bare N) k (pairFam τ (Φ.mono k P) (Φ.mono k Q)) := by
  rw [latSkR_bare, latSF_pairFam]

#print axioms latSF_eq_bare

/-- The flow commutes with translating the test functions.

DERIVED: `4` in `Fin 4` is the spacetime dimension. -/
theorem mono_shift (Φ : Flow N) (k : ℕ) (v : Fin 4 → ℝ) (Q : Mono N) :
    Φ.mono k (Mono.shift v Q) = Mono.shift v (Φ.mono k Q) := rfl

#print axioms mono_shift

/-- The flow of the empty monomial is the empty monomial.

DERIVED: `0` factors. -/
theorem mono_empty (Φ : Flow N) (k : ℕ) : Φ.mono k (emptyMono N) = emptyMono N := by
  unfold Flow.mono emptyMono
  congr
  funext i
  exact i.elim0

#print axioms mono_empty

/-- **A bare monomial lies in the gauge-invariant half-space algebra once its smeared factors do.**
At the bare renormalisation the subtraction is zero, so only the smears of the fields themselves
are needed (`ContinuumCluster.Yv_mem` asks for every subtraction).

DERIVED: `0` is the excluded colour count, the subtraction and the plane; `4` in `Fin 4` is the
spacetime dimension. -/
theorem Yv_bare_mem (hN : N ≠ 0) (τ : Fin 4) (k : ℕ) (P : Mono N)
    (hk : ∀ i : Fin P.1, smear (dySpacing N k) (P.2 i).1.1 (P.2 i).2
      ∈ HalfSpaceAlgebra.halfSpaceAlg (G := MassGap.SUN.SU N) τ 0) :
    Yv (Renorm.bare N) k P ∈ GaugeInvariantAlgebra.gaugeInvHalfSpaceAlg (G := MassGap.SUN.SU N) τ 0 := by
  have h1 : prodSmear (dySpacing N k) ((Renorm.bare N).mono k P)
      ∈ HalfSpaceAlgebra.halfSpaceAlg (G := MassGap.SUN.SU N) τ 0 :=
    HalfSpaceAlgebra.halfSpaceAlg_prod_mem τ 0 Finset.univ _ (fun i _ => by
      show smear (dySpacing N k) ((P.2 i).1.sub 0).1 (P.2 i).2 ∈ _
      rw [sub_zero_field]
      exact hk i)
  have h2 : GaugeInvariantAlgebra.IsIGaugeInvariant
      (prodSmear (dySpacing N k) ((Renorm.bare N).mono k P)) :=
    isIGaugeInvariant_prod Finset.univ _
      (fun i _ => isIGaugeInvariant_smear (dySpacing_pos (one_le_of_ne_zero hN) k) _ _)
  have h3 : prodSmear (dySpacing N k) ((Renorm.bare N).mono k P)
      ∈ GaugeInvariantAlgebra.gaugeInvHalfSpaceAlg (G := MassGap.SUN.SU N) τ 0 :=
    Submodule.mem_inf.mpr ⟨h1, h2⟩
  exact Submodule.smul_mem _ _ h3

#print axioms Yv_bare_mem

end Bare

/-! ## 3. The flowed clustering bound -/

section Cluster

variable {N : ℕ}

/-- **The flowed limit clusters at a physical rate under `FixedWindowDecay`.** For a flow with the
uniform bound that keeps the positive half-space beyond the margin `r`, there is `c > 0` such that
every pair of margin monomials obeys the reflected clustering bound at rate `c/L` in physical
separation, at every dyadic step `m`.

DERIVED: `2` is the least rank with a non-zero Haar variance (`gapAt_physical_of_fixedWindowDecay`'s)
and the square; `0` is the excluded colour count and the plane; `4` in `Fin 4` is the spacetime
dimension. -/
theorem kernF_cluster_of_fixedWindowDecay (hN2 : 2 ≤ N) (hN : N ≠ 0) (Φ : Flow N)
    (hB : UniformBoundF hN Φ) (τ : Fin 4) {r : ℝ} (hpos : Φ.PosPreserving τ r) {L : ℝ}
    (hL : 0 < L) (hW : WeakCouplingWindow.FixedWindowDecay τ 0 hN L) :
    ∃ c : ℝ, 0 < c ∧ ∀ (P Q : MarginMono N τ r) (m n : ℕ),
      (kernF hN Φ τ P.1 (Mono.shift (timeVec N m τ n) Q.1)
          - kernF hN Φ τ P.1 (emptyMono N) * kernF hN Φ τ (emptyMono N) Q.1) ^ 2
        ≤ Real.exp (-(2 * (c / L)) * (dySpacing N m * n))
          * (kernF hN Φ τ P.1 P.1
            * (kernF hN Φ τ Q.1 Q.1 - kernF hN Φ τ (emptyMono N) Q.1 ^ 2)) := by
  haveI : ((ultra : Ultrafilter ℕ) : Filter ℕ).NeBot := ultra.neBot'
  have hN1 := one_le_of_ne_zero hN
  obtain ⟨c, hc, hev⟩ := WeakCouplingWindow.gapAt_physical_of_fixedWindowDecay τ 0 hN2 hN hL hW
  have hevk : ∀ᶠ k in atTop, ∃ r : ℝ, TransferGap.GapAt (Dk hN τ k) r
      ∧ PeriodicContent.PeriodicClayGapAt τ 0 hN (dyBeta hN1 k) r
      ∧ c / L ≤ -Real.log r / AsymptoticScaling.aRun N (dyBeta hN1 k) :=
    (tendsto_dyBeta hN1).eventually hev
  refine ⟨c, hc, fun P Q m n => ?_⟩
  have hmem : ∀ X : MarginMono N τ r, ∀ᶠ k in atTop, ∀ i : Fin X.1.1,
      smear (dySpacing N k) (Φ.map k (X.1.2 i).1).1 (X.1.2 i).2
        ∈ HalfSpaceAlgebra.halfSpaceAlg (G := MassGap.SUN.SU N) τ 0 := by
    intro X
    obtain ⟨d, hd, hrd, hX⟩ := X.2
    exact Filter.eventually_all.mpr
      (fun i => hpos (X.1.2 i).1 (X.1.2 i).2 d hd hrd (fun y hy => hX i y hy))
  have tl : ∀ X Y : Mono N, Tendsto (fun k => latSF hN Φ k (pairFam τ X Y)) (ultra : Filter ℕ)
      (𝓝 (kernF hN Φ τ X Y)) := fun X Y => tendsto_contSF hN Φ hB (pairFam τ X Y)
  have hf := ((tl P.1 (Mono.shift (timeVec N m τ n) Q.1)).sub
    ((tl P.1 (emptyMono N)).mul (tl (emptyMono N) Q.1))).pow 2
  have hg := ((tl P.1 P.1).mul ((tl Q.1 Q.1).sub ((tl (emptyMono N) Q.1).pow 2))).const_mul
    (Real.exp (-(2 * (c / L)) * (dySpacing N m * n)))
  refine le_of_tendsto_of_tendsto hf hg ?_
  have hevLE : ∀ᶠ k in atTop,
      (latSF hN Φ k (pairFam τ P.1 (Mono.shift (timeVec N m τ n) Q.1))
        - latSF hN Φ k (pairFam τ P.1 (emptyMono N)) * latSF hN Φ k (pairFam τ (emptyMono N) Q.1))
          ^ 2
      ≤ Real.exp (-(2 * (c / L)) * (dySpacing N m * n))
        * (latSF hN Φ k (pairFam τ P.1 P.1)
          * (latSF hN Φ k (pairFam τ Q.1 Q.1) - latSF hN Φ k (pairFam τ (emptyMono N) Q.1) ^ 2)) := by
    filter_upwards [Filter.eventually_ge_atTop m, hevk, hmem P, hmem Q] with k hk hkr hkP hkQ
    obtain ⟨r', hg', hclay, hrate⟩ := hkr
    have ha := dySpacing_pos hN1 k
    have hr0 : 0 < r' := hclay.1
    have hvec : site (dySpacing N k) (axisVec τ ((2 ^ (k - m) * n : ℕ) : ℤ))
        = timeVec N m τ n := by
      unfold timeVec
      rw [site_dySpacing N hk, scaleSite_axisVec]
      congr 2
    obtain ⟨hcl, hY⟩ := lattice_cluster hN (Renorm.bare N) τ (Renorm.bare_reflCompat τ) k hr0.le hg'
      (Φ.mono k P.1) (Φ.mono k Q.1) (Yv_bare_mem hN τ k _ hkP) (Yv_bare_mem hN τ k _ hkQ)
      (2 ^ (k - m) * n)
    rw [hvec] at hcl
    have e1 : latSF hN Φ k (pairFam τ P.1 (Mono.shift (timeVec N m τ n) Q.1))
        = latSkR hN (Renorm.bare N) k
          (pairFam τ (Φ.mono k P.1) (Mono.shift (timeVec N m τ n) (Φ.mono k Q.1))) := by
      rw [latSF_eq_bare, mono_shift]
    have e2 : latSF hN Φ k (pairFam τ P.1 (emptyMono N))
        = latSkR hN (Renorm.bare N) k (pairFam τ (Φ.mono k P.1) (emptyMono N)) := by
      rw [latSF_eq_bare, mono_empty]
    have e3 : latSF hN Φ k (pairFam τ (emptyMono N) Q.1)
        = latSkR hN (Renorm.bare N) k (pairFam τ (emptyMono N) (Φ.mono k Q.1)) := by
      rw [latSF_eq_bare, mono_empty]
    have e4 : latSF hN Φ k (pairFam τ P.1 P.1)
        = latSkR hN (Renorm.bare N) k (pairFam τ (Φ.mono k P.1) (Φ.mono k P.1)) :=
      latSF_eq_bare hN Φ τ k P.1 P.1
    have e5 : latSF hN Φ k (pairFam τ Q.1 Q.1)
        = latSkR hN (Renorm.bare N) k (pairFam τ (Φ.mono k Q.1) (Φ.mono k Q.1)) :=
      latSF_eq_bare hN Φ τ k Q.1 Q.1
    rw [e1, e2, e3, e4, e5]
    have hlog : Real.log r' ≤ -(c / L) * dySpacing N k := by
      have h1 := hrate
      rw [aRun_dyBeta, le_div_iff₀ ha] at h1
      linarith
    have hr_le : r' ≤ Real.exp (-(c / L) * dySpacing N k) := by
      rw [← Real.exp_log hr0]
      exact Real.exp_le_exp.mpr hlog
    have hpow : r' ^ (2 * (2 ^ (k - m) * n)) ≤ Real.exp (-(2 * (c / L)) * (dySpacing N m * n)) := by
      calc r' ^ (2 * (2 ^ (k - m) * n))
          ≤ Real.exp (-(c / L) * dySpacing N k) ^ (2 * (2 ^ (k - m) * n)) :=
            pow_le_pow_left₀ hr0.le hr_le _
        _ = Real.exp (((2 * (2 ^ (k - m) * n) : ℕ) : ℝ) * (-(c / L) * dySpacing N k)) :=
            (Real.exp_nat_mul _ _).symm
        _ = Real.exp (-(2 * (c / L)) * (dySpacing N m * n)) := by
            rw [← dySpacing_mul_pow N hk]
            push_cast
            congr 1
            ring
    exact hcl.trans (mul_le_mul_of_nonneg_right hpow hY)
  exact hevLE.filter_mono ultra_le

#print axioms kernF_cluster_of_fixedWindowDecay

end Cluster

/-! ## 4. The capstone -/

section Capstone

variable {N : ℕ}

/-- **The observer's clustering.** The flowed limit obeys the reflected clustering bound at a
physical rate `c/L` for every pair of margin monomials at every dyadic step. It is a statement about
the observer's view alone: only flowed fields enter `kernF`. `FixedWindowDecay`, a decay statement
about every gauge-invariant half-space observable of the lattice, implies it
(`flowCluster_of_fixedWindowDecay`); the flowed transfer's gap consumes nothing more.

DERIVED: `2` is the square; `0` the lower end of `c`; `4` in `Fin 4` is the spacetime dimension. -/
def FlowCluster (hN : N ≠ 0) (Φ : Flow N) (τ : Fin 4) (r L : ℝ) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∀ (P Q : MarginMono N τ r) (m n : ℕ),
    (kernF hN Φ τ P.1 (Mono.shift (timeVec N m τ n) Q.1)
        - kernF hN Φ τ P.1 (emptyMono N) * kernF hN Φ τ (emptyMono N) Q.1) ^ 2
      ≤ Real.exp (-(2 * (c / L)) * (dySpacing N m * n))
        * (kernF hN Φ τ P.1 P.1
          * (kernF hN Φ τ Q.1 Q.1 - kernF hN Φ τ (emptyMono N) Q.1 ^ 2))

/-- `FixedWindowDecay` gives the observer's clustering (`kernF_cluster_of_fixedWindowDecay`).

DERIVED: `2` is the least rank with a non-zero Haar variance; `0` is the excluded colour count and the
plane; `4` in `Fin 4` is the spacetime dimension. -/
theorem flowCluster_of_fixedWindowDecay (hN2 : 2 ≤ N) (hN : N ≠ 0) (Φ : Flow N)
    (hB : UniformBoundF hN Φ) (τ : Fin 4) {r : ℝ} (hpos : Φ.PosPreserving τ r) {L : ℝ}
    (hL : 0 < L) (hW : WeakCouplingWindow.FixedWindowDecay τ 0 hN L) : FlowCluster hN Φ τ r L :=
  kernF_cluster_of_fixedWindowDecay hN2 hN Φ hB τ hpos hL hW

#print axioms flowCluster_of_fixedWindowDecay

/-- **The gap of the flowed transfer from the observer's clustering**, at every dyadic step.

DERIVED: `2` is the square; `0` is the sign of the rate; `4` in `Fin 4` is the spacetime dimension. -/
theorem flow_gap_of_cluster (hN : N ≠ 0) (Φ : Flow N) (hB : UniformBoundF hN Φ) (τ : Fin 4)
    {r : ℝ} (hpos : Φ.PosPreserving τ r) {L : ℝ} (hcl : FlowCluster hN Φ τ r L) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ,
      TransferGap.GapAt (flowTransfer hN Φ hB τ hpos m) (Real.exp (-(c / L) * dySpacing N m)) := by
  obtain ⟨c, hc, hcl⟩ := hcl
  refine ⟨c, hc, fun m => ?_⟩
  unfold flowTransfer
  refine gapAt_gTransfer_of_cluster _ _ _ _ _ _ _ _ _ (Real.exp_pos _).le (fun P Q n => ?_)
  rw [MarginMono.shift_iterate]
  have hexp : (Real.exp (-(c / L) * dySpacing N m) ^ n) ^ 2
      = Real.exp (-(2 * (c / L)) * (dySpacing N m * n)) := by
    rw [← pow_mul, ← Real.exp_nat_mul]
    congr 1
    push_cast
    ring
  rw [hexp]
  exact hcl P Q m n

#print axioms flow_gap_of_cluster

/-- **The observer's continuum statement from its own clustering.** A flow with the uniform bound
that keeps the positive half-space beyond the margin `r`, `FlowCluster` at a window `L > 0` and
`FlowConnectedNonzero`: some `c > 0` has, at every dyadic step, the flowed transfer gapped at rate
`e^{−(c/L) · aₘ}` (`ContinuumClay.GappedAt`) on a space with a non-zero vector orthogonal to the
vacuum (`ContinuumClay.NontrivialVacuum`). Both inputs are statements about the observer's view.

DERIVED: `0` is the excluded colour count, the lower end of `L` and `c`, and the spectral interval;
`1` is the vacuum eigenvalue; `4` in `Fin 4` is the spacetime dimension. -/
theorem flow_clay_of_cluster (hN : N ≠ 0) (Φ : Flow N) (hB : UniformBoundF hN Φ) (τ : Fin 4)
    {r : ℝ} (hpos : Φ.PosPreserving τ r) {L : ℝ} (hL : 0 < L) (hcl : FlowCluster hN Φ τ r L)
    (hNT : FlowConnectedNonzero hN Φ τ r) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ,
      ContinuumClay.GappedAt (flowTransfer hN Φ hB τ hpos m) (Real.exp (-(c / L) * dySpacing N m))
        ∧ ContinuumClay.NontrivialVacuum (flowTransfer hN Φ hB τ hpos m) := by
  obtain ⟨c, hc, hg⟩ := flow_gap_of_cluster hN Φ hB τ hpos hcl
  refine ⟨c, hc, fun m => ⟨?_, exists_orth_ne_zero_flow hN Φ hB τ hpos m hNT⟩⟩
  have hr0 : 0 < Real.exp (-(c / L) * dySpacing N m) := Real.exp_pos _
  have hr1 : Real.exp (-(c / L) * dySpacing N m) < 1 := by
    rw [Real.exp_lt_one_iff, neg_mul]
    exact neg_lt_zero.mpr (mul_pos (div_pos hc hL) (dySpacing_pos (one_le_of_ne_zero hN) m))
  refine ⟨hr0, hr1, hg m, fun u hu => GapToOperator.norm_opT_le_of_orth _ hr0.le (hg m) u hu, ?_,
    GNSHilbert.isGreatest_one_spectrum_opT _⟩
  intro x hx
  rcases GapToOperator.spectrum_opT_subset _ hr0.le (hg m) hx with h | h
  · exact Or.inl h
  · exact Or.inr ⟨Set.mem_Ici.mp
      (GNSHilbert.spectrum_opT_nonneg _ (flowTransfer_positive hN Φ hB τ hpos m) hx), h.2⟩

#print axioms flow_clay_of_cluster

/-- **The observer's continuum statement for a bounded flow, from its own clustering**:
`flow_clay_of_cluster` with the uniform bound discharged (`ContinuumFlow.uniformBoundF_of_bounded`).
Its inputs are `FlowCluster` and `FlowConnectedNonzero`, both about the observer's view.

DERIVED: as `flow_clay_of_cluster`. -/
theorem flow_clay_of_bounded_cluster (hN : N ≠ 0) (Φ : Flow N) (hΦ : Φ.Bounded) (τ : Fin 4)
    {r : ℝ} (hpos : Φ.PosPreserving τ r) {L : ℝ} (hL : 0 < L)
    (hcl : FlowCluster hN Φ τ r L) (hNT : FlowConnectedNonzero hN Φ τ r) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ,
      ContinuumClay.GappedAt (flowTransfer hN Φ (uniformBoundF_of_bounded hN Φ hΦ) τ hpos m)
          (Real.exp (-(c / L) * dySpacing N m))
        ∧ ContinuumClay.NontrivialVacuum
            (flowTransfer hN Φ (uniformBoundF_of_bounded hN Φ hΦ) τ hpos m) :=
  flow_clay_of_cluster hN Φ (uniformBoundF_of_bounded hN Φ hΦ) τ hpos hL hcl hNT

#print axioms flow_clay_of_bounded_cluster

/-- **The observer's clustering, absolute form.** At every dyadic step every pair of margin monomials
has its own constant `C` with the connected flowed kernel at time shift `n` at most
`C · e^{−(c/L) · aₘ n}`: one physical rate `c/L`, constants free. This is the form exponential
clustering of the observer's view delivers (bounds in the observables' norms); it is weaker than
`FlowCluster` (`flowClusterAbs_of_flowCluster`), and the gap consumes nothing more
(`flow_gap_of_abs_cluster`).

DERIVED: `0` the lower end of `c`; `4` in `Fin 4` is the spacetime dimension. -/
def FlowClusterAbs (hN : N ≠ 0) (Φ : Flow N) (τ : Fin 4) (r L : ℝ) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∀ (m : ℕ) (P Q : MarginMono N τ r), ∃ C : ℝ, ∀ n : ℕ,
    |kernF hN Φ τ P.1 (Mono.shift (timeVec N m τ n) Q.1)
        - kernF hN Φ τ P.1 (emptyMono N) * kernF hN Φ τ (emptyMono N) Q.1|
      ≤ C * Real.exp (-(c / L) * (dySpacing N m * n))

/-- The relative clustering bound gives the absolute one, with `C = √(K P P (K Q Q − (K e Q)²))`.

DERIVED: `2` is the square; `0` is the sign of the exponential. -/
theorem flowClusterAbs_of_flowCluster (hN : N ≠ 0) (Φ : Flow N) (τ : Fin 4) {r L : ℝ}
    (h : FlowCluster hN Φ τ r L) : FlowClusterAbs hN Φ τ r L := by
  obtain ⟨c, hc, hcl⟩ := h
  refine ⟨c, hc, fun m P Q => ⟨Real.sqrt (kernF hN Φ τ P.1 P.1
    * (kernF hN Φ τ Q.1 Q.1 - kernF hN Φ τ (emptyMono N) Q.1 ^ 2)), fun n => ?_⟩⟩
  have hE : (0 : ℝ) ≤ Real.exp (-(c / L) * (dySpacing N m * n)) := (Real.exp_pos _).le
  have hsq : Real.exp (-(c / L) * (dySpacing N m * n)) ^ 2
      = Real.exp (-(2 * (c / L)) * (dySpacing N m * n)) := by
    rw [← Real.exp_nat_mul]
    congr 1
    push_cast
    ring
  have h1 := hcl P Q m n
  rw [← hsq] at h1
  have h2 := abs_le_mul_sqrt_of_sq_le_sep hE h1
  linarith [h2, mul_comm (Real.exp (-(c / L) * (dySpacing N m * n)))
    (Real.sqrt (kernF hN Φ τ P.1 P.1 * (kernF hN Φ τ Q.1 Q.1 - kernF hN Φ τ (emptyMono N) Q.1 ^ 2)))]

#print axioms flowClusterAbs_of_flowCluster

/-- **The gap of the flowed transfer from the observer's absolute clustering**, at every dyadic step.

DERIVED: `0` is the sign of the rate; `4` in `Fin 4` is the spacetime dimension. -/
theorem flow_gap_of_abs_cluster (hN : N ≠ 0) (Φ : Flow N) (hB : UniformBoundF hN Φ) (τ : Fin 4)
    {r : ℝ} (hpos : Φ.PosPreserving τ r) {L : ℝ} (hcl : FlowClusterAbs hN Φ τ r L) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ,
      TransferGap.GapAt (flowTransfer hN Φ hB τ hpos m) (Real.exp (-(c / L) * dySpacing N m)) := by
  obtain ⟨c, hc, hcl⟩ := hcl
  refine ⟨c, hc, fun m => ?_⟩
  unfold flowTransfer
  refine gapAt_gTransfer_of_abs_cluster _ _ _ _ _ _ _ _ _ (Real.exp_pos _).le (fun P Q => ?_)
  obtain ⟨C, hC⟩ := hcl m P Q
  refine ⟨C, fun n => ?_⟩
  rw [MarginMono.shift_iterate]
  have hexp : Real.exp (-(c / L) * dySpacing N m) ^ n
      = Real.exp (-(c / L) * (dySpacing N m * n)) := by
    rw [← Real.exp_nat_mul]
    congr 1
    ring
  rw [hexp]
  exact hC n

#print axioms flow_gap_of_abs_cluster

/-- **The observer's continuum statement from its absolute clustering.** As `flow_clay_of_cluster`, with
M as `FlowClusterAbs`: one physical rate, pair-dependent constants.

DERIVED: `0` is the excluded colour count, the lower end of `L` and `c`, and the spectral interval;
`1` is the vacuum eigenvalue; `4` in `Fin 4` is the spacetime dimension. -/
theorem flow_clay_of_abs_cluster (hN : N ≠ 0) (Φ : Flow N) (hB : UniformBoundF hN Φ) (τ : Fin 4)
    {r : ℝ} (hpos : Φ.PosPreserving τ r) {L : ℝ} (hL : 0 < L) (hcl : FlowClusterAbs hN Φ τ r L)
    (hNT : FlowConnectedNonzero hN Φ τ r) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ,
      ContinuumClay.GappedAt (flowTransfer hN Φ hB τ hpos m) (Real.exp (-(c / L) * dySpacing N m))
        ∧ ContinuumClay.NontrivialVacuum (flowTransfer hN Φ hB τ hpos m) := by
  obtain ⟨c, hc, hg⟩ := flow_gap_of_abs_cluster hN Φ hB τ hpos hcl
  refine ⟨c, hc, fun m => ⟨?_, exists_orth_ne_zero_flow hN Φ hB τ hpos m hNT⟩⟩
  have hr0 : 0 < Real.exp (-(c / L) * dySpacing N m) := Real.exp_pos _
  have hr1 : Real.exp (-(c / L) * dySpacing N m) < 1 := by
    rw [Real.exp_lt_one_iff, neg_mul]
    exact neg_lt_zero.mpr (mul_pos (div_pos hc hL) (dySpacing_pos (one_le_of_ne_zero hN) m))
  refine ⟨hr0, hr1, hg m, fun u hu => GapToOperator.norm_opT_le_of_orth _ hr0.le (hg m) u hu, ?_,
    GNSHilbert.isGreatest_one_spectrum_opT _⟩
  intro x hx
  rcases GapToOperator.spectrum_opT_subset _ hr0.le (hg m) hx with h | h
  · exact Or.inl h
  · exact Or.inr ⟨Set.mem_Ici.mp
      (GNSHilbert.spectrum_opT_nonneg _ (flowTransfer_positive hN Φ hB τ hpos m) hx), h.2⟩

#print axioms flow_clay_of_abs_cluster

/-- **The observer's continuum statement for a bounded flow, from its absolute clustering.** Inputs:
`FlowClusterAbs` and `FlowConnectedNonzero`, both about the observer's view.

DERIVED: as `flow_clay_of_abs_cluster`. -/
theorem flow_clay_of_bounded_abs_cluster (hN : N ≠ 0) (Φ : Flow N) (hΦ : Φ.Bounded) (τ : Fin 4)
    {r : ℝ} (hpos : Φ.PosPreserving τ r) {L : ℝ} (hL : 0 < L)
    (hcl : FlowClusterAbs hN Φ τ r L) (hNT : FlowConnectedNonzero hN Φ τ r) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ,
      ContinuumClay.GappedAt (flowTransfer hN Φ (uniformBoundF_of_bounded hN Φ hΦ) τ hpos m)
          (Real.exp (-(c / L) * dySpacing N m))
        ∧ ContinuumClay.NontrivialVacuum
            (flowTransfer hN Φ (uniformBoundF_of_bounded hN Φ hΦ) τ hpos m) :=
  flow_clay_of_abs_cluster hN Φ (uniformBoundF_of_bounded hN Φ hΦ) τ hpos hL hcl hNT

#print axioms flow_clay_of_bounded_abs_cluster

/-- **The gap of the flowed transfer at every dyadic step** under `FixedWindowDecay`.

DERIVED: `2` is the least rank with a non-zero Haar variance and the square; `0` is the excluded
colour count and the plane; `4` in `Fin 4` is the spacetime dimension. -/
theorem flow_continuum_gap (hN2 : 2 ≤ N) (hN : N ≠ 0) (Φ : Flow N) (hB : UniformBoundF hN Φ)
    (τ : Fin 4) {r : ℝ} (hpos : Φ.PosPreserving τ r) {L : ℝ} (hL : 0 < L)
    (hW : WeakCouplingWindow.FixedWindowDecay τ 0 hN L) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ,
      TransferGap.GapAt (flowTransfer hN Φ hB τ hpos m) (Real.exp (-(c / L) * dySpacing N m)) := by
  obtain ⟨c, hc, hcl⟩ := kernF_cluster_of_fixedWindowDecay hN2 hN Φ hB τ hpos hL hW
  refine ⟨c, hc, fun m => ?_⟩
  unfold flowTransfer
  refine gapAt_gTransfer_of_cluster _ _ _ _ _ _ _ _ _ (Real.exp_pos _).le (fun P Q n => ?_)
  rw [MarginMono.shift_iterate]
  have hexp : (Real.exp (-(c / L) * dySpacing N m) ^ n) ^ 2
      = Real.exp (-(2 * (c / L)) * (dySpacing N m * n)) := by
    rw [← pow_mul, ← Real.exp_nat_mul]
    congr 1
    push_cast
    ring
  rw [hexp]
  exact hcl P Q m n

#print axioms flow_continuum_gap

/-- **The observer's continuum statement.** At `2 ≤ N`, a flow with the uniform bound that keeps
the positive half-space beyond the margin `r`, `FixedWindowDecay` at a window `L > 0` and
`FlowConnectedNonzero`: some `c > 0` has, at every dyadic step, the flowed transfer gapped at rate
`e^{−(c/L) · aₘ}` (`ContinuumClay.GappedAt`) on a space with a non-zero vector orthogonal to the
vacuum (`ContinuumClay.NontrivialVacuum`).

DERIVED: `2` is the least rank with a non-zero Haar variance; `0` is the excluded colour count, the
lower end of `L` and `c`, and the spectral interval; `1` is the vacuum eigenvalue; `4` in `Fin 4` is
the spacetime dimension. -/
theorem flow_clay (hN2 : 2 ≤ N) (hN : N ≠ 0) (Φ : Flow N) (hB : UniformBoundF hN Φ) (τ : Fin 4)
    {r : ℝ} (hpos : Φ.PosPreserving τ r) {L : ℝ} (hL : 0 < L)
    (hW : WeakCouplingWindow.FixedWindowDecay τ 0 hN L) (hNT : FlowConnectedNonzero hN Φ τ r) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ,
      ContinuumClay.GappedAt (flowTransfer hN Φ hB τ hpos m) (Real.exp (-(c / L) * dySpacing N m))
        ∧ ContinuumClay.NontrivialVacuum (flowTransfer hN Φ hB τ hpos m) := by
  obtain ⟨c, hc, hg⟩ := flow_continuum_gap hN2 hN Φ hB τ hpos hL hW
  refine ⟨c, hc, fun m => ⟨?_, exists_orth_ne_zero_flow hN Φ hB τ hpos m hNT⟩⟩
  have hr0 : 0 < Real.exp (-(c / L) * dySpacing N m) := Real.exp_pos _
  have hr1 : Real.exp (-(c / L) * dySpacing N m) < 1 := by
    rw [Real.exp_lt_one_iff, neg_mul]
    exact neg_lt_zero.mpr (mul_pos (div_pos hc hL) (dySpacing_pos (one_le_of_ne_zero hN) m))
  refine ⟨hr0, hr1, hg m, fun u hu => GapToOperator.norm_opT_le_of_orth _ hr0.le (hg m) u hu, ?_,
    GNSHilbert.isGreatest_one_spectrum_opT _⟩
  intro x hx
  rcases GapToOperator.spectrum_opT_subset _ hr0.le (hg m) hx with h | h
  · exact Or.inl h
  · exact Or.inr ⟨Set.mem_Ici.mp
      (GNSHilbert.spectrum_opT_nonneg _ (flowTransfer_positive hN Φ hB τ hpos m) hx), h.2⟩

#print axioms flow_clay

/-- **The observer's continuum statement for a bounded flow**: `flow_clay` with the uniform bound
discharged (`ContinuumFlow.uniformBoundF_of_bounded`). Its inputs are `FixedWindowDecay` and
`FlowConnectedNonzero`.

DERIVED: as `flow_clay`. -/
theorem flow_clay_of_bounded (hN2 : 2 ≤ N) (hN : N ≠ 0) (Φ : Flow N) (hΦ : Φ.Bounded) (τ : Fin 4)
    {r : ℝ} (hpos : Φ.PosPreserving τ r) {L : ℝ} (hL : 0 < L)
    (hW : WeakCouplingWindow.FixedWindowDecay τ 0 hN L)
    (hNT : FlowConnectedNonzero hN Φ τ r) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ,
      ContinuumClay.GappedAt (flowTransfer hN Φ (uniformBoundF_of_bounded hN Φ hΦ) τ hpos m)
          (Real.exp (-(c / L) * dySpacing N m))
        ∧ ContinuumClay.NontrivialVacuum (flowTransfer hN Φ (uniformBoundF_of_bounded hN Φ hΦ) τ hpos m) :=
  flow_clay hN2 hN Φ (uniformBoundF_of_bounded hN Φ hΦ) τ hpos hL hW hNT

#print axioms flow_clay_of_bounded

end Capstone

