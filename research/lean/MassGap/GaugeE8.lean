/-- All triples of `e8Blocks` in one list. DERIVED: no numeral. -/
def e8Triples : List ℕ := e8Blocks.flatten

/-- The first index of a code. DERIVED: `5` the sign digits, `248² = 61504`. -/
def tI (t : ℕ) : ℕ := t / 5 / 61504
/-- The second index of a code. DERIVED: `5` the sign digits, `248` the dimension. -/
def tJ (t : ℕ) : ℕ := t / 5 / 248 % 248
/-- The third index of a code. DERIVED: `5` the sign digits, `248` the dimension. -/
def tK (t : ℕ) : ℕ := t / 5 % 248
/-- The structure constant of a code, `t % 5 − 2`. DERIVED: the offset `2` of the encoding. -/
def tF (t : ℕ) : ℤ := ((t % 5 : ℕ) : ℤ) - 2

/-! ## The 3-form and the bracket -/

section Form

variable {R : Type} [CommRing R]

/-- Coordinate `n` of a vector, `0` off `Fin 248`. DERIVED: `248` the dimension. -/
def getN (x : Fin 248 → R) (n : ℕ) : R := if h : n < 248 then x ⟨n, h⟩ else 0

/-- The elementary 3-form `eᵃᵇᶜ(x, y, z)`, the determinant of the coordinates `a, b, c` of
`x, y, z`. DERIVED: `248` the dimension. -/
def e3N (a b c : ℕ) (x y z : Fin 248 → R) : R :=
  getN x a * (getN y b * getN z c - getN y c * getN z b)
    - getN x b * (getN y a * getN z c - getN y c * getN z a)
    + getN x c * (getN y a * getN z b - getN y b * getN z a)

/-- The 3-form `Σ_{t ∈ L} f_t e^{t}` of a list of codes. DERIVED: `248` the dimension. -/
def phiL (L : List ℕ) (x y z : Fin 248 → R) : R :=
  (L.map fun t => (tF t : R) * e3N (tI t) (tJ t) (tK t) x y z).sum

/-- The 3-form of compact `e₈`, `⟨[x, y], z⟩`. DERIVED: `248` the dimension. -/
def phiE8 (x y z : Fin 248 → R) : R := phiL e8Triples x y z

/-- **The bracket of compact `e₈`**: `[x, y]ₘ = phiE8 x y eₘ`. DERIVED: `1` the unit vector; `248` the dimension. -/
def br (x y : Fin 248 → R) : Fin 248 → R := fun m => phiE8 x y (Pi.single m 1)

theorem phiL_nil (x y z : Fin 248 → R) : phiL [] x y z = 0 := by simp [phiL]

theorem phiL_cons (t : ℕ) (L : List ℕ) (x y z : Fin 248 → R) :
    phiL (t :: L) x y z = (tF t : R) * e3N (tI t) (tJ t) (tK t) x y z + phiL L x y z := by
  simp [phiL]

/-- `getN` is linear: `x_n = Σₖ xₖ (eₖ)_n`. DERIVED: `1` the unit vector; `248` the dimension. -/
theorem getN_sum (z : Fin 248 → R) (n : ℕ) :
    getN z n = ∑ k, z k * getN (Pi.single k 1) n := by
  unfold getN
  split
  · rename_i h
    simp [Pi.single_apply]
  · simp

/-- `e3N` is linear in its third vector. DERIVED: `1` the unit vector; `248` the dimension. -/
theorem e3N_lin (a b c : ℕ) (x y z : Fin 248 → R) :
    e3N a b c x y z = ∑ k, z k * e3N a b c x y (Pi.single k 1) := by
  have h : ∀ w : Fin 248 → R, e3N a b c x y w
      = (getN x b * getN y c - getN x c * getN y b) * getN w a
        + (getN x c * getN y a - getN x a * getN y c) * getN w b
        + (getN x a * getN y b - getN x b * getN y a) * getN w c := fun w => by
    unfold e3N; ring
  rw [h z, getN_sum z a, getN_sum z b, getN_sum z c, Finset.mul_sum, Finset.mul_sum,
    Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [h]
  ring

/-- `phiL` is linear in its third vector. DERIVED: `1` the unit vector; `248` the dimension. -/
theorem phiL_lin (L : List ℕ) (x y z : Fin 248 → R) :
    phiL L x y z = ∑ k, z k * phiL L x y (Pi.single k 1) := by
  induction L with
  | nil => simp [phiL_nil]
  | cons t L ih =>
    rw [phiL_cons, ih, e3N_lin _ _ _ x y z, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [phiL_cons]
    ring

end Form

/-! ## Continuity -/

section Cont

variable {X : Type} [TopologicalSpace X]

theorem continuous_getN {f : X → Fin 248 → ℝ} (hf : Continuous f) (n : ℕ) :
    Continuous fun t => getN (f t) n := by
  unfold getN
  split
  · exact (continuous_apply _).comp hf
  · exact continuous_const

theorem continuous_e3N {f g h : X → Fin 248 → ℝ} (hf : Continuous f) (hg : Continuous g)
    (hh : Continuous h) (a b c : ℕ) :
    Continuous fun t => e3N a b c (f t) (g t) (h t) := by
  have xa := continuous_getN hf a
  have xb := continuous_getN hf b
  have xc := continuous_getN hf c
  have ya := continuous_getN hg a
  have yb := continuous_getN hg b
  have yc := continuous_getN hg c
  have za := continuous_getN hh a
  have zb := continuous_getN hh b
  have zc := continuous_getN hh c
  unfold e3N
  exact ((xa.mul ((yb.mul zc).sub (yc.mul zb))).sub (xb.mul ((ya.mul zc).sub (yc.mul za)))).add
    (xc.mul ((ya.mul zb).sub (yb.mul za)))

/-- The 3-form of any list of codes is jointly continuous. DERIVED: `248` the dimension. -/
theorem continuous_phiL {f g h : X → Fin 248 → ℝ} (hf : Continuous f) (hg : Continuous g)
    (hh : Continuous h) (L : List ℕ) :
    Continuous fun t => phiL L (f t) (g t) (h t) := by
  induction L with
  | nil => simp only [phiL_nil]; exact continuous_const
  | cons t L ih =>
    simp only [phiL_cons]
    exact (continuous_const.mul (continuous_e3N hf hg hh _ _ _)).add ih

/-- The bracket is jointly continuous. DERIVED: `248` the dimension. -/
theorem continuous_br {f g : X → Fin 248 → ℝ} (hf : Continuous f) (hg : Continuous g) :
    Continuous fun t => br (f t) (g t) :=
  continuous_pi fun _ => continuous_phiL hf hg continuous_const _

end Cont

/-! ## `E₈ ⊆ SO(248)` -/

/-- **Compact `E₈`**: the elements of `SO(248)` preserving the bracket, `g [x, y] = [g x, g y]`
for all real `x, y`. Closure under inverse: `g⁻¹ = gᵀ = star g`, and
`g⁻¹ [x, y] = g⁻¹ [g g⁻¹ x, g g⁻¹ y] = g⁻¹ g [g⁻¹ x, g⁻¹ y]`.

DERIVED: `248` the dimension of the adjoint. -/
def E8Sub : Subgroup (SO 248) where
  carrier := {g | ∀ x y : Fin 248 → ℝ,
    (g : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ br x y
      = br ((g : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ x) ((g : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ y)}
  mul_mem' := by
    intro a b ha hb x y
    show ((a : Matrix (Fin 248) (Fin 248) ℝ) * (b : Matrix (Fin 248) (Fin 248) ℝ)) *ᵥ br x y
      = br (((a : Matrix (Fin 248) (Fin 248) ℝ) * (b : Matrix (Fin 248) (Fin 248) ℝ)) *ᵥ x)
        (((a : Matrix (Fin 248) (Fin 248) ℝ) * (b : Matrix (Fin 248) (Fin 248) ℝ)) *ᵥ y)
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hb, ha]
  one_mem' := by
    intro x y
    show (1 : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ br x y
      = br ((1 : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ x) ((1 : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ y)
    rw [Matrix.one_mulVec, Matrix.one_mulVec, Matrix.one_mulVec]
  inv_mem' := by
    intro a ha x y
    have hu : (a : Matrix (Fin 248) (Fin 248) ℝ) * star (a : Matrix (Fin 248) (Fin 248) ℝ) = 1 :=
      Matrix.mem_unitaryGroup_iff.mp (Matrix.mem_specialUnitaryGroup_iff.mp a.2).1
    have hu' : star (a : Matrix (Fin 248) (Fin 248) ℝ) * (a : Matrix (Fin 248) (Fin 248) ℝ) = 1 :=
      Matrix.mem_unitaryGroup_iff'.mp (Matrix.mem_specialUnitaryGroup_iff.mp a.2).1
    show star (a : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ br x y
      = br (star (a : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ x)
        (star (a : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ y)
    have h := ha (star (a : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ x)
      (star (a : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ y)
    rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, hu, Matrix.one_mulVec,
      Matrix.one_mulVec] at h
    rw [← h, Matrix.mulVec_mulVec, hu', Matrix.one_mulVec]

/-- Compact `E₈` as a type. -/
abbrev E8 : Type := ↥E8Sub

/-- Membership in `E8Sub` is preservation of the bracket. DERIVED: `248` the dimension. -/
theorem mem_E8Sub_iff (g : SO 248) :
    g ∈ E8Sub ↔ ∀ x y : Fin 248 → ℝ,
      (g : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ br x y
        = br ((g : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ x)
          ((g : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ y) :=
  Iff.rfl

/-- **`E8Sub` is closed in `SO(248)`**: the intersection over `x, y` of the equalisers of the
continuous maps `g ↦ g [x, y]` and `g ↦ [g x, g y]`.

DERIVED: `248` the dimension. -/
theorem isClosed_E8Sub : IsClosed (E8Sub : Set (SO 248)) := by
  have hset : (E8Sub : Set (SO 248)) = ⋂ x : Fin 248 → ℝ, ⋂ y : Fin 248 → ℝ,
      {g : SO 248 | (g : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ br x y
        = br ((g : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ x)
          ((g : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ y)} := by
    ext g
    simp only [Set.mem_iInter, Set.mem_setOf_eq]
    exact mem_E8Sub_iff g
  rw [hset]
  have hv : ∀ v : Fin 248 → ℝ,
      Continuous fun g : SO 248 => (g : Matrix (Fin 248) (Fin 248) ℝ) *ᵥ v :=
    fun v => continuous_subtype_val.matrix_mulVec continuous_const
  exact isClosed_iInter fun x => isClosed_iInter fun y =>
    isClosed_eq (hv _) (continuous_br (hv x) (hv y))

instance : CompactSpace E8 := isCompact_iff_compactSpace.mp isClosed_E8Sub.isCompact

noncomputable instance : MeasurableSpace E8 := borel _
instance : BorelSpace E8 := ⟨rfl⟩

instance : SecondCountableTopology E8 :=
  Topology.IsInducing.subtypeVal.secondCountableTopology

/-! ## The representation and the instances -/

/-- The adjoint representation `E₈ → U(248)`: `soRep 248` restricted to `E8Sub`,
`g ↦ g.map ofReal`.

DERIVED: `248` the dimension. -/
noncomputable def e8Rep : E8 →* Matrix.unitaryGroup (Fin 248) ℂ :=
  (soRep 248).comp E8Sub.subtype

/-- `E₈` as a gauge group in its adjoint representation `e8Rep`. DERIVED: `248 = 8 + 240` the dimension
of `e₈`, the Cartan plus one vector per root. -/
noncomputable instance instGaugeGroupE8 : GaugeGroup E8 where
  isTopologicalGroup := inferInstance
  compactSpace := inferInstance
  borelSpace := inferInstance
  secondCountable := inferInstance
  nonempty := inferInstance
  repDim := 248
  repDim_pos := by norm_num
  rep := e8Rep
  continuous_rep := by
    have h : Continuous fun g : SO 248 =>
        ((soRep 248 g : Matrix.unitaryGroup (Fin 248) ℂ) : Matrix (Fin 248) (Fin 248) ℂ) :=
      continuous_subtype_val.matrix_map Complex.continuous_ofReal
    exact h.comp continuous_subtype_val
  rep_injective := by
    intro g h hgh
    apply Subtype.ext
    apply Subtype.ext
    ext i j
    have := congrArg
      (fun U : Matrix.unitaryGroup (Fin 248) ℂ => (U : Matrix (Fin 248) (Fin 248) ℂ) i j) hgh
    exact Complex.ofReal_injective this

theorem dim_E8 : GaugeGroup.dim E8 = 248 := rfl

/-- The Wilson density of `E₈` is that of `SO(248)` at the same matrix: `1 − tr g / 248`.

DERIVED: no numeral beyond the density's own `1` and `248` the dimension. -/
theorem wilsonDensityG_E8 (g : E8) :
    wilsonDensityG E8 g = wilsonDensityG (SO 248) (g : SO 248) := rfl

/-- **`E₈`**: `dim 𝔤 = 248`, `h^∨ = 30`, `T(248) = 30`. Classification values in the
normalisation of `GaugeSimple`, where the adjoint has `T = h^∨` (module docstring). Nothing here
derives them from `E8Sub`.

DERIVED: `248`, `30`, `30` are the classification values. -/
noncomputable instance instGaugeSimpleE8 : GaugeSimple E8 where
  lieDim := 248
  dualCoxeter := 30
  dynkinIndex := 30
  dualCoxeter_pos := by norm_num
  dynkinIndex_pos := by norm_num

/-- **The Hermitian generators of `ρ(𝔢₈)`**: `X` Hermitian, `Xᵀ = −X`, and `X` a derivation of
the bracket over `ℂ`. `248 > 0`.

DERIVED: the derivation condition has no numeral; `248` the dimension. -/
instance instGaugeLieE8 : MassGap.ClayTreeG.GaugeLie E8 where
  lieGen M := M.IsHermitian ∧ M.transpose = -M ∧
    ∀ x y : Fin 248 → ℂ, M *ᵥ br x y = br (M *ᵥ x) y + br x (M *ᵥ y)
  lieDim_pos := by
    show 0 < 248
    norm_num

/-! ## One generator -/

/-- The partner of a basis index: `8 + 2r ↔ 9 + 2r`, the Cartan indices fixed.
DERIVED: `8` Cartan directions, `2` the pair. -/
def pN (n : ℕ) : ℕ := if n < 8 then n else if n % 2 = 0 then n + 1 else n - 1

/-- The angle `λ_r = α₁ + α₂` of pair `r` in the generator's order: `2` for `r = 0`, `1` for
`r = 1, …, 56`, `0` after. DERIVED: the counts `1`, `56` of the pairs with `λ = 2`, `λ = 1`. -/
def lamN (r : ℕ) : ℤ := if r < 1 then 2 else if r < 57 then 1 else 0

/-- The rotation entry of `ad(x₀)` in row `n`: `−λ_r` at `8 + 2r`, `λ_r` at `9 + 2r`, `0` on the
Cartan and off `Fin 248`. DERIVED: `8`, `2`, `248` as in `pN`. -/
def dN (n : ℕ) : ℤ :=
  if n < 8 then 0 else if n < 248 then
    (if n % 2 = 0 then -lamN ((n - 8) / 2) else lamN ((n - 8) / 2)) else 0

/-- **The generator** `i · ad(x₀)`: entry `(n, pN n)` is `i dN n`, all others `0`.
DERIVED: `248` the dimension. -/
noncomputable def cartanM : Matrix (Fin 248) (Fin 248) ℂ :=
  Matrix.of fun i j => if (j : ℕ) = pN i then Complex.I * (dN i : ℂ) else 0

theorem pN_lt : ∀ n, n < 248 → pN n < 248 := by
  intro n hn; unfold pN; split_ifs <;> omega

theorem pN_pN : ∀ n, n < 248 → pN (pN n) = n := by
  intro n hn; unfold pN; split_ifs <;> omega

theorem dN_pN : ∀ n, n < 248 → dN (pN n) = -dN n := by decide +kernel

theorem dN_ge (n : ℕ) (h : ¬ n < 248) : dN n = 0 := by
  unfold dN; split_ifs <;> rfl

theorem cartanM_mulVec (v : Fin 248 → ℂ) (i : Fin 248) :
    (cartanM *ᵥ v) i = Complex.I * (dN i : ℂ) * getN v (pN i) := by
  have hp : pN i < 248 := pN_lt i i.2
  have hiff : ∀ j : Fin 248, ((j : ℕ) = pN i) ↔ j = ⟨pN i, hp⟩ := fun j => by
    rw [Fin.ext_iff]
  simp only [Matrix.mulVec, dotProduct, cartanM, Matrix.of_apply, hiff, ite_mul, zero_mul,
    Finset.sum_ite_eq', Finset.mem_univ, if_true, getN, hp, dif_pos]

theorem getN_cartanM (v : Fin 248 → ℂ) (n : ℕ) :
    getN (cartanM *ᵥ v) n = Complex.I * (dN n : ℂ) * getN v (pN n) := by
  by_cases h : n < 248
  · have := cartanM_mulVec v ⟨n, h⟩
    simp only [getN, h, dif_pos] at this ⊢
    exact this
  · simp [getN, h, dN_ge n h]

/-- `cartanM` acting on one elementary 3-form. DERIVED: `248` the dimension. -/
theorem e3N_deriv (a b c : ℕ) (x y z : Fin 248 → ℂ) :
    e3N a b c (cartanM *ᵥ x) y z + e3N a b c x (cartanM *ᵥ y) z + e3N a b c x y (cartanM *ᵥ z)
      = Complex.I * ((dN a : ℂ) * e3N (pN a) b c x y z + (dN b : ℂ) * e3N a (pN b) c x y z
        + (dN c : ℂ) * e3N a b (pN c) x y z) := by
  unfold e3N
  simp only [getN_cartanM]
  ring

/-! ## The kernel check -/

/-- The three terms of `cartanM` acting on the elementary 3-form of a code: index triple and
integer coefficient. DERIVED: no numeral. -/
def terms3 (t : ℕ) : List ((ℕ × ℕ × ℕ) × ℤ) :=
  [((pN (tI t), tJ t, tK t), tF t * dN (tI t)),
   ((tI t, pN (tJ t), tK t), tF t * dN (tJ t)),
   ((tI t, tJ t, pN (tK t)), tF t * dN (tK t))]

/-- A term with three distinct indices and a nonzero coefficient. DERIVED: `0`. -/
def nondeg (s : (ℕ × ℕ × ℕ) × ℤ) : Bool :=
  decide (s.1.1 ≠ s.1.2.1) && decide (s.1.2.1 ≠ s.1.2.2) && decide (s.1.1 ≠ s.1.2.2)
    && decide (s.2 ≠ 0)

/-- Every key's coefficients sum to zero. DERIVED: `0`. -/
def cancels {K : Type} [DecidableEq K] (T : List (K × ℤ)) : Bool :=
  T.all fun s => decide (((T.filter fun u => decide (u.1 = s.1)).map Prod.snd).sum = 0)

/-- The block check: the non-degenerate terms of `cartanM` acting on the block cancel.
DERIVED: no numeral. -/
def blockOK (B : List ℕ) : Bool := cancels ((B.flatMap terms3).filter nondeg)

/-- **The kernel check** on the data: every block of `e8Blocks` passes `blockOK`.
DERIVED: no numeral. -/
theorem e8Blocks_ok : e8Blocks.all blockOK = true := by decide +kernel

section Sound

variable {R : Type} [CommRing R]

theorem sum_filter_split {K : Type} [DecidableEq K] (f : K × ℤ → R) (T : List (K × ℤ)) (k : K) :
    (T.map f).sum = ((T.filter fun u => decide (u.1 = k)).map f).sum
      + ((T.filter fun u => !decide (u.1 = k)).map f).sum := by
  induction T with
  | nil => simp
  | cons s T ih =>
    by_cases h : s.1 = k
    · simp [h, ih, add_assoc]
    · simp [h, ih]
      ring

theorem sum_filter_key {K : Type} [DecidableEq K] (g : K → R) (T : List (K × ℤ)) (k : K) :
    ((T.filter fun u => decide (u.1 = k)).map fun s => (s.2 : R) * g s.1).sum
      = ((((T.filter fun u => decide (u.1 = k)).map Prod.snd).sum : ℤ) : R) * g k := by
  induction T with
  | nil => simp
  | cons s T ih =>
    by_cases h : s.1 = k
    · simp [h, ih, add_mul]
    · simp [h, ih]

/-- **Cancellation is sound**: if every key's coefficients sum to zero, so does
`Σ_s c_s g(k_s)`, for any `g`. DERIVED: no numeral. -/
theorem sum_zero_of_cancels {K : Type} [DecidableEq K] (g : K → R) :
    ∀ (n : ℕ) (T : List (K × ℤ)), T.length ≤ n → cancels T = true →
      (T.map fun s => (s.2 : R) * g s.1).sum = 0 := by
  intro n
  induction n with
  | zero =>
    intro T hT _
    rw [List.length_eq_zero_iff.mp (Nat.le_zero.mp hT)]
    simp
  | succ n ih =>
    intro T hT hc
    cases T with
    | nil => simp
    | cons s rest =>
      have hall := List.all_eq_true.mp hc
      rw [sum_filter_split _ _ s.1, sum_filter_key,
        of_decide_eq_true (hall s List.mem_cons_self), Int.cast_zero, zero_mul, zero_add]
      apply ih
      · have : ((s :: rest).filter fun u => !decide (u.1 = s.1))
            = rest.filter fun u => !decide (u.1 = s.1) := by
          simp
        rw [this]
        have := List.length_filter_le (fun u => !decide (u.1 = s.1)) rest
        simp only [List.length_cons] at hT
        omega
      · apply List.all_eq_true.mpr
        intro u hu
        have hus : u.1 ≠ s.1 := by
          have := (List.mem_filter.mp hu).2
          simpa using this
        have hcong : ((s :: rest).filter fun u => !decide (u.1 = s.1)).filter
              (fun w => decide (w.1 = u.1))
            = (s :: rest).filter fun w => decide (w.1 = u.1) := by
          rw [List.filter_filter]
          apply List.filter_congr
          intro w _
          by_cases hw : w.1 = u.1
          · simp [hw, hus]
          · simp [hw]
        rw [hcong]
        exact hall u (List.mem_of_mem_filter hu)

theorem sum_filter_of_zero {α : Type} (f : α → R) (p : α → Bool) (T : List α)
    (h : ∀ a ∈ T, p a = false → f a = 0) : (T.map f).sum = ((T.filter p).map f).sum := by
  induction T with
  | nil => simp
  | cons s T ih =>
    have ih' := ih fun a ha => h a (List.mem_cons_of_mem _ ha)
    by_cases hp : p s = true
    · simp [hp, ih']
    · have h0 := h s List.mem_cons_self (by simpa using hp)
      simp [hp, ih', h0]

/-- One term of `cartanM` acting on `phiE8`, evaluated. DERIVED: `248` the dimension. -/
def evalT (x y z : Fin 248 → R) (s : (ℕ × ℕ × ℕ) × ℤ) : R :=
  (s.2 : R) * e3N s.1.1 s.1.2.1 s.1.2.2 x y z

theorem e3N_degenerate (a b c : ℕ) (x y z : Fin 248 → R)
    (h : a = b ∨ b = c ∨ a = c) : e3N a b c x y z = 0 := by
  rcases h with h | h | h <;> subst h <;> unfold e3N <;> ring

theorem evalT_of_nondeg_false (x y z : Fin 248 → R) (s : (ℕ × ℕ × ℕ) × ℤ)
    (hs : nondeg s = false) : evalT x y z s = 0 := by
  obtain ⟨⟨a, b, c⟩, f⟩ := s
  simp only [nondeg, Bool.and_eq_false_iff, decide_eq_false_iff_not, not_not] at hs
  unfold evalT
  rcases hs with ((h | h) | h) | h
  · rw [e3N_degenerate a b c x y z (Or.inl h), mul_zero]
  · rw [e3N_degenerate a b c x y z (Or.inr (Or.inl h)), mul_zero]
  · rw [e3N_degenerate a b c x y z (Or.inr (Or.inr h)), mul_zero]
  · simp [h]

theorem block_sound (B : List ℕ) (hB : blockOK B = true) (x y z : Fin 248 → R) :
    ((B.flatMap terms3).map (evalT x y z)).sum = 0 := by
  have h1 : ((B.flatMap terms3).map (evalT x y z)).sum
      = (((B.flatMap terms3).filter nondeg).map (evalT x y z)).sum :=
    sum_filter_of_zero _ _ _ fun s _ hs => evalT_of_nondeg_false x y z s hs
  have h2 := sum_zero_of_cancels (R := R) (fun k : ℕ × ℕ × ℕ => e3N k.1 k.2.1 k.2.2 x y z) _
    ((B.flatMap terms3).filter nondeg) le_rfl hB
  rw [h1]
  exact h2

theorem blocks_sound (Bs : List (List ℕ)) (hBs : Bs.all blockOK = true) (x y z : Fin 248 → R) :
    ((Bs.flatten.flatMap terms3).map (evalT x y z)).sum = 0 := by
  induction Bs with
  | nil => simp
  | cons B Bs ih =>
    have h := List.all_eq_true.mp hBs
    rw [List.flatten_cons, List.flatMap_append, List.map_append, List.sum_append,
      block_sound B (h B List.mem_cons_self),
      ih (List.all_eq_true.mpr fun b hb => h b (List.mem_cons_of_mem _ hb)), add_zero]

end Sound

/-- `cartanM` acting on the 3-form of a list of codes is `i` times the sum of its terms.
DERIVED: `248` the dimension. -/
theorem deriv_phiL (L : List ℕ) (x y z : Fin 248 → ℂ) :
    phiL L (cartanM *ᵥ x) y z + phiL L x (cartanM *ᵥ y) z + phiL L x y (cartanM *ᵥ z)
      = Complex.I * ((L.flatMap terms3).map (evalT x y z)).sum := by
  induction L with
  | nil => simp [phiL_nil]
  | cons t L ih =>
    simp only [phiL_cons, List.flatMap_cons, List.map_append, List.sum_append, terms3,
      List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, evalT]
    push_cast
    linear_combination (tF t : ℂ) * e3N_deriv (tI t) (tJ t) (tK t) x y z + ih

/-- **`phiE8` is invariant under `cartanM`.** DERIVED: `248` the dimension. -/
theorem phiE8_cartanM (x y z : Fin 248 → ℂ) :
    phiE8 (cartanM *ᵥ x) y z + phiE8 x (cartanM *ᵥ y) z + phiE8 x y (cartanM *ᵥ z) = 0 := by
  unfold phiE8
  rw [deriv_phiL, e8Triples, blocks_sound e8Blocks e8Blocks_ok, mul_zero]

theorem cartanM_transpose : cartanM.transpose = -cartanM := by
  ext i j
  simp only [Matrix.transpose_apply, Matrix.neg_apply, cartanM, Matrix.of_apply]
  by_cases h : (j : ℕ) = pN i
  · have h' : (i : ℕ) = pN j := by rw [h, pN_pN i i.2]
    have hd : dN j = -dN i := by rw [h]; exact dN_pN i i.2
    rw [if_pos h', if_pos h, hd]
    push_cast
    ring
  · have h' : ¬ (i : ℕ) = pN j := by
      intro h'
      apply h
      rw [h', pN_pN j j.2]
    rw [if_neg h', if_neg h, neg_zero]

theorem cartanM_isHermitian : cartanM.IsHermitian := by
  show cartanM.conjTranspose = cartanM
  ext i j
  simp only [Matrix.conjTranspose_apply, cartanM, Matrix.of_apply]
  by_cases h : (j : ℕ) = pN i
  · have h' : (i : ℕ) = pN j := by rw [h, pN_pN i i.2]
    have hd : dN j = -dN i := by rw [h]; exact dN_pN i i.2
    rw [if_pos h', if_pos h, hd]
    simp
  · have h' : ¬ (i : ℕ) = pN j := by
      intro h'
      apply h
      rw [h', pN_pN j j.2]
    rw [if_neg h', if_neg h, star_zero]

/-- A matrix that is antisymmetric and leaves `phiE8` invariant is a derivation of `br`:
`(X [x, y])ₘ = Σₖ Xₘₖ φ(x, y, eₖ) = −φ(x, y, X eₘ) = φ(X x, y, eₘ) + φ(x, X y, eₘ)`.

DERIVED: `248` the dimension. -/
theorem br_deriv_of_inv (X : Matrix (Fin 248) (Fin 248) ℂ) (hT : X.transpose = -X)
    (hinv : ∀ x y z : Fin 248 → ℂ, phiE8 (X *ᵥ x) y z + phiE8 x (X *ᵥ y) z + phiE8 x y (X *ᵥ z) = 0)
    (x y : Fin 248 → ℂ) : X *ᵥ br x y = br (X *ᵥ x) y + br x (X *ᵥ y) := by
  funext m
  have h := hinv x y (Pi.single m 1)
  have hlin := phiL_lin e8Triples x y (X *ᵥ Pi.single m 1)
  rw [Matrix.mulVec_single_one] at hlin
  have hcol : ∀ k, X.col m k = -X m k := fun k => by
    have := congrFun (congrFun hT m) k
    simpa [Matrix.transpose_apply] using this
  simp only [hcol] at hlin
  simp only [Matrix.mulVec, dotProduct, br, Pi.add_apply]
  unfold phiE8 at h
  rw [Matrix.mulVec_single_one, hlin] at h
  simp only [neg_mul, Finset.sum_neg_distrib] at h
  unfold phiE8
  linear_combination -h

/-- **`cartanM` is a generator of `ρ(𝔢₈)`** in the sense of `instGaugeLieE8`, and it is nonzero:
`lieGen` is not the zero predicate.

DERIVED: the index `(9, 8)` is the entry `2 i`. -/
theorem lieGen_cartanM :
    MassGap.ClayTreeG.GaugeLie.lieGen (G := E8) cartanM ∧ cartanM ≠ 0 := by
  refine ⟨⟨cartanM_isHermitian, cartanM_transpose,
    br_deriv_of_inv cartanM cartanM_transpose phiE8_cartanM⟩, ?_⟩
  intro h
  have h98 := congrFun (congrFun h 9) 8
  simp [cartanM, pN, dN, lamN] at h98

/-! ## The Clay statement at `E₈` -/

open MassGap.ClayTreeG MassGap.ClayStatementG MassGap.SymPlaqG

/-- **The Clay Yang–Mills statement for `E₈`**: `ClayStatementOf` at `E8`.

DERIVED: no numeral. -/
def ClayStatementE8 : Prop := ClayStatementOf E8

/-- **`ClayStatementOfDy E8`, the statement at the frozen tower, from
`ClayStatementAtG` on the symmetrised plaquette class**, which is
reflection closed (`symPlaqG_refl`). `ObserverLinkedG.clayStatementAtG_of_observer (G := E8)`
concludes the hypothesis from its inputs.

DERIVED: no numeral. -/
theorem clayStatementE8_of_atG (W : ConfFlowG E8)
    (h : ClayStatementAtG E8 W (SymPlaqClassG E8)) : ClayStatementOfDy E8 :=
  ⟨W, SymPlaqClassG E8, symPlaqG_refl E8, h⟩

-- The observer capstone elaborates at `E₈`: the six instance arguments resolve, and its conclusion
-- is `ClayStatementAtG E8 W (SymPlaqClassG E8)`, the hypothesis of `clayStatementE8_of_atG`.
example : True := by
  have _h := @MassGap.ObserverLinkedG.clayStatementAtG_of_observer E8 _ _ _ _ _ _
  trivial

