import Mathlib
import MassGap.CouplingGen

/-!
# MassGap.FlowAlong — the root at `SU(N)` from the flow-side bundle along the coupling towers

`TowerOpen.clayStatementOf_of_reduced` derives `ClayStatementOf (SU N)` from `StrongEnd N`, (UV) along
the coupling towers near `0⁺`, and `OpenAlongR N βs` along those towers. This module derives
`OpenAlongR N βs` from the flow-side bundle of `SUNFromScale.FlowInputsN` restated along `βs`, without
its gap field `RunSeed` (the tower route proves the gap).

## The bundle along `βs`

`cpl βs` is the coupling family that is `βs` at every colour count. The copies of `MassGap.CouplingGen`
at `B = cpl βs` are the flow-side declarations with the state of step `k` the periodic state at the
coupling `βs k` (`stateK_along`: the copy of `stateK` is `ContinuumSchwinger.stateAlong`), at the same
spacing `dySpacing N k`. `FlowInputsAlong N βs` is `FlowInputsN` with the four flow-side clauses so
copied and `RunSeed` dropped: some block-step observer `sunFam hN2 c hc0 hc s₀`, margin `r > s₀ ≥ 0`,
channel factors `zri`, `zwe` nowhere zero, an off-tensor mixing `μ`, a scale `b`, a flow family `Wf`
and proxy coefficients `cf`, with

* `SubstrateCoreAt` along `βs`: `b > 0`, `Wf b = W`, `ScaleControlAll b Wf` along `βs`, and a
  two-point kernel of the trace at `zFix N zri zwe` with the asymptotic-freedom coefficient along `βs`;
* `GradientFlowPropsN` along `βs`: `ExpandStrong`, `CoefBound`, `FlowCov`, `FlowWard` and
  `ProxyNondeg` of the flowed proxies;
* `ProxyGenLim` along `βs`: the proxies are generated by the observer's margin monomials in the limit
  form;
* `ThreePointAtScale` along `βs` at some scale `ℓ > 0`.

## What is proved

* `schedAlongG_eq`: the schedule along `βs` is the copy of `ClayTreeG.schedSU` at `cpl βs`;
  `energy0G_along`: on it, the observer's energy density is `CompositeLink.Φ0` of `sunFam`.
* `flowAlong_dyBeta`: at the two-loop tower `βs = dyBeta`, `SUNFromScale.FlowInputsN` gives
  `FlowInputsAlong`; the bundle along `βs` is the same statement at another coupling sequence.
* `openAlongR_of_flowAlong`: `FlowInputsAlong N βs ⇒ OpenAlongR N βs`. The one-site moment `SiteExpG`,
  the two-point kernel and its coefficient, `NonGaussianTG`, `WardTG`, `CompOSG` and `ApproxAlong` are
  the copy of `CouplingGen.flowClausesK` at `cpl βs`, read in the schedule form along `βs`. The
  two-point kernel with its coefficient is the field `af` of `SubstrateCoreAt` along `βs`.
* `clayStatementOf_of_flowAlong`: `StrongEnd N`, (UV) and `FlowInputsAlong` along the towers near
  `0⁺` give `ClayStatementOf (SU N)`.

Declarations are in the namespace `MassGap.FlowAlong`. Foundational footprint only (`#print axioms`
at the end).

DERIVED (module-wide): `0` the signs, the lower end of the observer's scale and the limit `0⁺`; `1` the
least colour count of a coupling family; `2` the least rank; `2`, `1`, `3`, `4` in `(2 · 1 + 3)⁴` the
unit cube's site count; `π` in `π/N` the angle of the centre of `SU(N)`; `12` a sufficient bound on `c`.
-/

set_option autoImplicit false

noncomputable section

namespace MassGap.FlowAlong

open MassGap MassGap.InfiniteLattice MassGap.ContinuumField MassGap.ContinuumSchwinger
  MassGap.ContinuumFlow MassGap.ClayTreeG MassGap.ClayStatementG MassGap.FlowG Filter
open scoped Topology
open MassGap.MeasuredTower (schedAlongG)
open MassGap.CouplingTower (StrongEnd CouplingTower UVConverges)
open MassGap.TowerOpen (OpenAlongR)
open MassGap.LinkAlongG (ApproxAlong)
open MassGap.ObserverFlowSUN (sunFam)
open MassGap.CompositesRen (OffMix)

/-- **The coupling family that is `βs` at every colour count.** DERIVED: `1` the least colour count
of the family's type. -/
abbrev cpl (βs : ℕ → ℝ) : {M : ℕ} → 1 ≤ M → ℕ → ℝ := fun _ k => βs k

/-- **The copy of `stateK` at `cpl βs` is the state along `βs`**: the periodic state at the coupling
`βs k`. DERIVED: `0` the excluded colour count. -/
theorem stateK_along {N : ℕ} (hN : N ≠ 0) (βs : ℕ → ℝ) (k : ℕ) :
    CouplingGen.Along.ContinuumSchwinger.stateK (cpl βs) hN k = stateAlong hN βs k :=
  rfl

variable {N : ℕ} [NeZero N] [Fact (2 ≤ N)]

/-- **The schedule along `βs` is the copy of `schedSU` at `cpl βs`**: the same spacing
(`ClayTreeG.dySpacingG_SU`) and the same states. DERIVED: no numeral. -/
theorem schedAlongG_eq (βs : ℕ → ℝ) :
    schedAlongG (MassGap.SUN.SU N) βs = CouplingGen.Along.ClayTreeG.schedSU (cpl βs) N :=
  Sched.ext' (dySpacingG_SU N) rfl

variable (N) in
/-- **The flow-side bundle along `βs`**: module docstring. DERIVED: `0` the signs and the lower end of
the observer's scale; `2` the least rank; `π` in `π/N` the angle of the centre of `SU(N)`; `12` a
sufficient bound on `c`. -/
def FlowInputsAlong (βs : ℕ → ℝ) : Prop :=
  ∃ (c : ℝ) (hc0 : 0 ≤ c) (hc : 12 * c < Real.sin (Real.pi / N)) (s₀ r : ℝ) (_ : 0 ≤ s₀) (_ : s₀ < r)
    (zri zwe : ℕ → ℝ) (_ : ∀ k, zri k ≠ 0) (_ : ∀ k, zwe k ≠ 0) (μ : OffMix) (b : ℝ)
    (Wf : ℝ → ConfFlow N) (cf : CompositesBuild.Ix0 → ℝ → (MultiScaleAll.MIx →₀ ℝ)),
    CouplingGen.Along.SU2Best.SubstrateCoreAt (cpl βs) (sunFam (Fact.out : 2 ≤ N) c hc0 hc s₀)
        (ZCanon.zFix N zri zwe) b Wf
      ∧ CouplingGen.Along.NondegFromProxy.GradientFlowPropsN (cpl βs) Wf cf (ZCanon.zFix N zri zwe)
          μ
      ∧ CouplingGen.Along.ProxyGenObserver.ProxyGenLim (cpl βs) (sunFam (Fact.out : 2 ≤ N) c hc0 hc s₀)
          b Wf cf r
      ∧ ∃ ℓ : ℝ, 0 < ℓ
          ∧ CouplingGen.Along.NonGaussFromScale.ThreePointAtScale (cpl βs) (NeZero.ne N) ℓ

set_option maxRecDepth 100000 in
/-- **The observer's energy density along `βs` is the flow `Φ0` of the block-step observer**: at the
copy of `schedSU`, `energy0G` of `obsW` on the symmetric plaquette class is `CompositeLink.Φ0` of
`sunFam`, field by field and by definition. DERIVED: `0` the sign of `c`; `2` the least rank; `π` in
`π/N` the angle of the centre of `SU(N)`; `12` a sufficient bound on `c`. -/
theorem energy0G_along (βs : ℕ → ℝ) {c : ℝ} (hc0 : 0 ≤ c) (hc : 12 * c < Real.sin (Real.pi / N))
    (s₀ : ℝ) :
    energy0G (CouplingGen.Along.ClayTreeG.schedSU (cpl βs) N) (ConsolidatedRoot.obsW N hc0 hc s₀)
        (SymPlaqG.SymPlaqClassG (MassGap.SUN.SU N)) (SymPlaqG.symPlaqG_refl (MassGap.SUN.SU N))
      = (CompositeLink.Φ0 (sunFam (Fact.out : 2 ≤ N) c hc0 hc s₀)).toGFlow :=
  rfl

set_option maxHeartbeats 1000000 in
/-- **At the two-loop tower the bundle along `βs` is the flow-side bundle without the gap**:
`SUNFromScale.FlowInputsN` gives `FlowInputsAlong` at `βs = dyBeta`, field by field (each copied clause
at `cpl dyBeta` is the clause, by definition). DERIVED: `1` the least colour count of `dyBeta`; `2` the
least rank. -/
theorem flowAlong_dyBeta (h : SUNFromScale.FlowInputsN N (Fact.out : 2 ≤ N)) :
    FlowInputsAlong N (dyBeta (one_le_of_ne_zero (NeZero.ne N))) := by
  obtain ⟨c, hc0, hc, s₀, r, hs0, hr, zri, zwe, hri, hwe, μ, b, Wf, cf, S, F, hL, h3, -⟩ := h
  exact ⟨c, hc0, hc, s₀, r, hs0, hr, zri, zwe, hri, hwe, μ, b, Wf, cf,
    CouplingGen.Along.SU2Best.SubstrateCoreAt.mk (cpl _) S.b_pos S.top S.scale S.af,
    CouplingGen.Along.NondegFromProxy.GradientFlowPropsN.mk (cpl _)
      (CouplingGen.Along.SU2Best.GradientFlowProps.mk (cpl _) F.props.expand F.props.coef F.props.cov
        F.props.ward) F.nondeg, hL, h3⟩

set_option maxRecDepth 100000 in
/-- **`FlowInputsAlong ⇒ OpenAlongR`**: the clauses of `OpenAlongR` from the copy of
`CouplingGen.flowClausesK` at `cpl βs`, in the schedule form along `βs` (`schedAlongG_eq`,
`ClayStatementG.constsG_SU`); the one-site moment at `s = t (2 · 1 + 3)⁴`. DERIVED: `0` the signs; `2`,
`1`, `3`, `4` in `(2 · 1 + 3)⁴` the unit cube's site count; `2` the least rank. -/
theorem openAlongR_of_flowAlong {βs : ℕ → ℝ} (h : FlowInputsAlong N βs) : OpenAlongR N βs := by
  obtain ⟨c, hc0, hc, s₀, r, hs0, hr, zri, zwe, hri, hwe, μ, b, Wf, cf, S, F, hL, h3⟩ := h
  obtain ⟨⟨t, C, ht, hSE⟩, ⟨Gk, hK, hAF⟩, hNG, hW, hCO, hA⟩ :=
    CouplingGen.Along.CouplingGen.flowClausesK (cpl βs) (Fact.out : 2 ≤ N) hc0 hc hs0 hr S F hL h3
  have hsched := schedAlongG_eq (N := N) βs
  refine ⟨c, hc0, hc, s₀, r, hs0, hr, t * (2 * 1 + 3) ^ 4, C, by positivity, ?_, zri, zwe, hri, hwe, μ,
    ⟨Gk, ?_, ?_⟩, ?_, ?_, ?_, ?_⟩
  · rw [hsched]
    exact hSE
  · rw [hsched]
    exact hK
  · rw [constsG_SU N]
    exact hAF
  · rw [hsched]
    exact hNG
  · rw [hsched]
    exact hW
  · rw [hsched]
    exact hCO
  · unfold ApproxAlong
    rw [hsched, energy0G_along βs hc0 hc s₀]
    exact hA

/-- **The root at `SU(N)` from the strong end, (UV) and the flow-side bundle along the towers near
`0⁺`** (`TowerOpen.clayStatementOf_of_reduced`, `openAlongR_of_flowAlong`). DERIVED: `0` the limit
`0⁺`; `2` the least rank. -/
theorem clayStatementOf_of_flowAlong (hS : StrongEnd N)
    (hUV : ∀ᶠ u₀ in 𝓝[>] (0 : ℝ), ∀ βs : ℕ → ℝ, CouplingTower N u₀ βs id →
      ∃ μ : ℝ, UVConverges N βs id μ)
    (hF : ∀ᶠ u₀ in 𝓝[>] (0 : ℝ), ∀ βs : ℕ → ℝ, CouplingTower N u₀ βs id →
      FlowInputsAlong N βs) :
    ClayStatementOf (MassGap.SUN.SU N) :=
  TowerOpen.clayStatementOf_of_reduced hS hUV
    (hF.mono fun _ h βs hT => openAlongR_of_flowAlong (h βs hT))

end MassGap.FlowAlong

end

#print axioms MassGap.FlowAlong.stateK_along
#print axioms MassGap.FlowAlong.schedAlongG_eq
#print axioms MassGap.FlowAlong.energy0G_along
#print axioms MassGap.FlowAlong.flowAlong_dyBeta
#print axioms MassGap.FlowAlong.openAlongR_of_flowAlong
#print axioms MassGap.FlowAlong.clayStatementOf_of_flowAlong
