local notation "h2N" => (ne_zero_of_two_le (le_refl 2) : (2 : ℕ) ≠ 0)

variable {N : ℕ}

/-! ## 1. What `expand` gives -/

/-- **The reflection sign has modulus one.** DERIVED: `1` the modulus. -/
theorem abs_sgnC {N : ℕ} (C : Composites N) (τ : Fin 4) (P : TMonoG C.Ix) : |sgnC C τ P| = 1 := by
  unfold sgnC
  rw [Finset.abs_prod]
  simp

/-- **The diagonal of `ApproxK` is the small-scale limit of the flowed proxies' readings**: for a
separated positive-time composite monomial `P` and `η > 0`, for all small `s > 0`, eventually along
`ultra`, `|sgn(P) · msLat(s)(ΘP ∪ P) − kernC(P, P)| ≤ η`. Module docstring, §1.
DERIVED: `2` the halving of `η`; `0` the limit of the scale. -/
theorem kernC_diag_flowed {W : ConfFlow 2} {z : Chan → ℕ → ℝ} {μ : OffMix} {b : ℝ}
    {Wf : ℝ → ConfFlow 2} {cf : Ix0 → ℝ → (MIx →₀ ℝ)} (H : MultiScaleAllRenAt W z μ b Wf cf)
    (P : TSepG (CRen 2 z μ).Ix 0) {η : ℝ} (hη : 0 < η) :
    ∀ᶠ s in 𝓝[>] (0 : ℝ), ∀ᶠ k in (ultra : Filter ℕ),
      |sgnC (CRen 2 z μ) 0 P.1 * msLat Wf cf k s (pairC (CRen 2 z μ) 0 P.1 P.1)
        - kernC h2N (CRen 2 z μ) 0 P P| ≤ η := by
  have hconv := convC_ren_of_all ⟨b, Wf, cf, H⟩
  obtain ⟨θ, ε, Kr, κr, hθ, hε, hE⟩ := H.expand
  obtain ⟨hcont, d, hd, hsep⟩ := adm_pairC (CRen 2 z μ) P P
  set F := pairC (CRen 2 z μ) 0 P.1 P.1 with hF
  have hL := hconv _ F ⟨hcont, d, hd, hsep⟩
  set Mc : ℝ := |Kr ^ Fintype.card (Fin P.1.1 ⊕ Fin P.1.1)
    * ∏ i, ((d ^ κr (F i).1)⁻¹ * l1 (F i).2)| with hMc
  have hrp : Tendsto (fun s : ℝ => Mc * (s / d) ^ ε) (𝓝 0) (𝓝 0) := by
    have hc : ContinuousAt (fun s : ℝ => Mc * (s / d) ^ ε) 0 :=
      continuousAt_const.mul ((continuousAt_id.div_const d).rpow_const (Or.inr hε.le))
    have h0 := hc.tendsto
    simp only [zero_div, Real.zero_rpow hε.ne', mul_zero] at h0
    exact h0
  have h1 : ∀ᶠ s in 𝓝[>] (0 : ℝ), Mc * (s / d) ^ ε < η / 2 :=
    (hrp.eventually (gt_mem_nhds (half_pos hη))).filter_mono nhdsWithin_le_nhds
  have h2 : ∀ᶠ s in 𝓝[>] (0 : ℝ), s < θ * d :=
    (gt_mem_nhds (mul_pos hθ hd)).filter_mono nhdsWithin_le_nhds
  have h3 : ∀ᶠ s in 𝓝[>] (0 : ℝ), 0 < s := eventually_mem_nhdsWithin.mono fun s hs => hs
  filter_upwards [h1, h2, h3] with s hs1 hs2 hs3
  have hk := hE _ F d hd hcont hsep s hs3 hs2.le
  filter_upwards [hk.filter_mono ultra_le, hL.eventually (Metric.ball_mem_nhds _ (half_pos hη))]
    with k hk1 hk2
  have hx : 0 ≤ (s / d) ^ ε := Real.rpow_nonneg (div_nonneg hs3.le hd.le) _
  have hb : Kr ^ Fintype.card (Fin P.1.1 ⊕ Fin P.1.1) * (s / d) ^ ε
      * ∏ i, ((d ^ κr (F i).1)⁻¹ * l1 (F i).2) ≤ Mc * (s / d) ^ ε := by
    rw [hMc, mul_right_comm]
    exact mul_le_mul_of_nonneg_right (le_abs_self _) hx
  show |sgnC (CRen 2 z μ) 0 P.1 * msLat Wf cf k s F
    - sgnC (CRen 2 z μ) 0 P.1 * contC h2N (CRen 2 z μ) F| ≤ η
  rw [← mul_sub, abs_mul, abs_sgnC, one_mul]
  rw [Real.dist_eq] at hk2
  have htri := abs_sub_le (msLat Wf cf k s F) (latC h2N (CRen 2 z μ) k F) (contC h2N (CRen 2 z μ) F)
  rw [abs_sub_comm] at hk1
  linarith

/-! ## 2. What `expand` does not give -/

/-- **A diagonal match does not give `ApproxK`**: one composite with `Kc = 1`, one observer monomial
whose Gram reading equals the diagonal (`gForm G (single 1) (single 1) = 1`), cross kernel `X = 0`.
`JointRPK` holds and `ApproxK` fails. Module docstring, §2.
DERIVED: `1` the unit kernel and the unit coefficient; `0` the vanishing cross kernel; `1/2` the
tolerance; `2` the cross-term factor and the square. -/
theorem diag_match_not_approxK :
    gForm (fun _ _ : Unit => (1 : ℝ)) (Finsupp.single () 1) (Finsupp.single () 1) = 1
      ∧ JointRPK (fun _ _ : Unit => (1 : ℝ)) (fun _ _ : Unit => (0 : ℝ)) (fun _ _ : Unit => (1 : ℝ))
      ∧ ¬ ApproxK (fun _ _ : Unit => (1 : ℝ)) (fun _ _ : Unit => (0 : ℝ))
          (fun _ _ : Unit => (1 : ℝ)) := by
  have hx : ∀ c : Unit →₀ ℝ, xL (fun _ : Unit => (0 : ℝ)) c = 0 := fun c => by
    unfold xL
    simp
  have hg : ∀ c : Unit →₀ ℝ, 0 ≤ gForm (fun _ _ : Unit => (1 : ℝ)) c c := fun c => by
    obtain ⟨x, rfl⟩ : ∃ x : ℝ, c = Finsupp.single () x := ⟨c (), Finsupp.unique_single c⟩
    rw [gForm_single]
    nlinarith [sq_nonneg x]
  refine ⟨by rw [gForm_single]; norm_num, fun P P' t c => ?_, fun hA => ?_⟩
  · show 0 ≤ 1 + 2 * t * 1 + t ^ 2 * 1 - 2 * xL (fun _ : Unit => (0 : ℝ)) c
      - 2 * t * xL (fun _ : Unit => (0 : ℝ)) c + gForm (fun _ _ : Unit => (1 : ℝ)) c c
    rw [hx]
    nlinarith [hg c, sq_nonneg (1 + t)]
  · obtain ⟨c, hc⟩ := hA () (1 / 2) (by norm_num)
    have hc' : 1 - 2 * xL (fun _ : Unit => (0 : ℝ)) c + gForm (fun _ _ : Unit => (1 : ℝ)) c c
        ≤ 1 / 2 := hc
    rw [hx] at hc'
    linarith [hg c]

/-! ## 3. The replacement -/

/-- **The flowed proxy product** `B_k^s(P) = ∏ᵢ smear a_k (msProx(s, Pᵢ)) fᵢ`, the observable that
`msLat` reads. DERIVED: no numeral. -/
def proxB [NeZero N] (Wf : ℝ → ConfFlow N) (cf : Ix0 → ℝ → (MIx →₀ ℝ)) (k : ℕ) (s : ℝ) (P : TMonoG Ix0) :
    C(Cfg N, ℝ) :=
  ∏ i, smear (dySpacing N k) (msProx Wf cf k s (P.2 i).1) (P.2 i).2

/-- **A real combination of the observer's margin monomials** at step `k`. DERIVED: `0` the plane. -/
def yW [NeZero N] (W : ConfFlow N) {r : ℝ} (k : ℕ) (a : MarginMono N 0 r →₀ ℝ) : C(Cfg N, ℝ) :=
  a.sum fun Q x => x • prodSmear (dySpacing N k) ((Φ0 W).mono k Q.1)

/-- **The expansion in the reflection norm**: for every separated positive-time composite monomial
`P` and `η > 0`, a scale `0 < s ≤ b` with, eventually along `ultra`, the proxy product in the
half-space algebra and `ν_k(θ(A_k − B_k^s)(A_k − B_k^s)) ≤ η`. DERIVED: `0` the plane and the signs. -/
def ExpandRP [NeZero N] (b : ℝ) (Wf : ℝ → ConfFlow N) (cf : Ix0 → ℝ → (MIx →₀ ℝ)) (z : Chan → ℕ → ℝ)
    (μ : OffMix) : Prop :=
  ∀ (P : TSepG (CRen N z μ).Ix 0) (η : ℝ), 0 < η → ∃ s : ℝ, 0 < s ∧ s ≤ b ∧
    ∀ᶠ k in (ultra : Filter ℕ),
      proxB Wf cf k s P.1 ∈ HalfSpaceAlgebra.halfSpaceAlg (G := MassGap.SUN.SU N) 0 0
      ∧ rform (stateK (NeZero.ne N) k) (LatticeReflection.ireflObs 0 0)
          (prodSmear (dySpacing N k) (cMono (NeZero.ne N) (CRen N z μ) k P.1) - proxB Wf cf k s P.1)
          (prodSmear (dySpacing N k) (cMono (NeZero.ne N) (CRen N z μ) k P.1) - proxB Wf cf k s P.1) ≤ η

/-- **The flowed proxies are generated by the observer**: for every separated positive-time monomial
`P` of indices, every `0 < s ≤ b` and `η > 0`, real coefficients on the margin monomials of `W` with,
eventually along `ultra`, `ν_k(θ(B_k^s − Y_k)(B_k^s − Y_k)) ≤ η`. No composite field is read.
DERIVED: `0` the plane and the signs. -/
def ProxyGen [NeZero N] (W : ConfFlow N) (b : ℝ) (Wf : ℝ → ConfFlow N) (cf : Ix0 → ℝ → (MIx →₀ ℝ)) (r : ℝ) :
    Prop :=
  ∀ (P : TSepG Ix0 0) (s : ℝ), 0 < s → s ≤ b → ∀ η : ℝ, 0 < η →
    ∃ a : MarginMono N 0 r →₀ ℝ, ∀ᶠ k in (ultra : Filter ℕ),
      rform (stateK (NeZero.ne N) k) (LatticeReflection.ireflObs 0 0)
        (proxB Wf cf k s P.1 - yW W k a) (proxB Wf cf k s P.1 - yW W k a) ≤ η

/-- **The parallelogram bound**: for a symmetric bilinear form,
`F(A − Y, A − Y) ≤ 2 F(A − B, A − B) + 2 F(B − Y, B − Y)` when `F(x, x) ≥ 0` at
`x = (A − B) − (B − Y)`. DERIVED: `2` the parallelogram factor. -/
theorem rform_para_le {X : Type*} [AddCommGroup X] [Module ℝ X] (F : X →ₗ[ℝ] X →ₗ[ℝ] ℝ)
    (hs : ∀ x y, F x y = F y x) (A B Y : X)
    (hpos : 0 ≤ F ((A - B) - (B - Y)) ((A - B) - (B - Y))) :
    F (A - Y) (A - Y) ≤ 2 * F (A - B) (A - B) + 2 * F (B - Y) (B - Y) := by
  have e : A - Y = (A - B) + (B - Y) := by abel
  have h1 : F ((A - B) + (B - Y)) ((A - B) + (B - Y))
      = F (A - B) (A - B) + 2 * F (A - B) (B - Y) + F (B - Y) (B - Y) := by
    simp only [map_add, map_sub, LinearMap.add_apply, LinearMap.sub_apply]
    rw [hs B A, hs Y A, hs Y B]
    ring
  have h2 : F ((A - B) - (B - Y)) ((A - B) - (B - Y))
      = F (A - B) (A - B) - 2 * F (A - B) (B - Y) + F (B - Y) (B - Y) := by
    simp only [map_sub, LinearMap.sub_apply]
    rw [hs B A, hs Y A, hs Y B]
    ring
  rw [e, h1]
  linarith

/-- **The lattice reflection form is symmetric** at every step. DERIVED: `0` the plane and the
reflection constant. -/
theorem rform_symm_k [NeZero N] (k : ℕ) (x y : C(Cfg N, ℝ)) :
    rform (stateK (NeZero.ne N) k) (LatticeReflection.ireflObs 0 0) x y
      = rform (stateK (NeZero.ne N) k) (LatticeReflection.ireflObs 0 0) y x :=
  refl_pair_symm (stateK (NeZero.ne N) k) 0
    (PeriodicState.periodicState_reflInvariant (NeZero.ne N) (dyBeta (one_le_of_ne_zero (NeZero.ne N)) k) 0 0) x y

/-- **The lattice joint form at one composite**: `⟪A_k − Y_k(c), A_k − Y_k(c)⟫_k =
rReadC − 2 xL(rMixC) c + gForm(latSF) c c`. DERIVED: `2` the cross-term factor; `0` the plane. -/
theorem rform_sub_yW [NeZero N] (W : ConfFlow N) {r : ℝ} (z : Chan → ℕ → ℝ) (μ : OffMix) (k : ℕ)
    (P : TMonoG (CRen N z μ).Ix) (a : MarginMono N 0 r →₀ ℝ) :
    rform (stateK (NeZero.ne N) k) (LatticeReflection.ireflObs 0 0)
        (prodSmear (dySpacing N k) (cMono (NeZero.ne N) (CRen N z μ) k P) - yW W k a)
        (prodSmear (dySpacing N k) (cMono (NeZero.ne N) (CRen N z μ) k P) - yW W k a)
      = rReadC (NeZero.ne N) (CRen N z μ) 0 k P P
        - 2 * xL (fun Q : MarginMono N 0 r => rMixC (NeZero.ne N) (CRen N z μ) (Φ0 W) 0 k P Q.1) a
        + gForm (fun Q Q' : MarginMono N 0 r => latSF (NeZero.ne N) (Φ0 W) k (pairFam 0 Q.1 Q'.1)) a a := by
  have h := rform_expand (rform (stateK (NeZero.ne N) k) (LatticeReflection.ireflObs 0 0)) (rform_symm_k k)
    (prodSmear (dySpacing N k) (cMono (NeZero.ne N) (CRen N z μ) k P))
    (prodSmear (dySpacing N k) (cMono (NeZero.ne N) (CRen N z μ) k P))
    (fun Q : MarginMono N 0 r => prodSmear (dySpacing N k) ((Φ0 W).mono k Q.1)) 0 a
  rw [zero_smul, add_zero] at h
  rw [show yW W k a = a.sum (fun Q x => x • prodSmear (dySpacing N k) ((Φ0 W).mono k Q.1)) from rfl, h]
  simp only [rReadC_eq, rMixC_eq, latSF_pair_eq]
  ring

/-- **`ApproxK` from `ExpandRP` and `ProxyGen`**, at every `SU(N)`. Module docstring, §3. DERIVED: `4`
and `2` the split `ε = 2 (ε/4) + 2 (ε/4)`; `2` the least colour count; `0` the plane. -/
theorem approxK_of_expandRP_SU (hN2 : 2 ≤ N) [NeZero N] {W : ConfFlow N} {t C : ℝ}
    (hU : ClassMoments (NeZero.ne N) W (SymPlaqClass N) t C) {r : ℝ} (hphys : (Φ0 W).PhysRange r)
    {z : Chan → ℕ → ℝ} {μ : OffMix} (hCO : CompOS (NeZero.ne N) (CRen N z μ)) {b : ℝ} {Wf : ℝ → ConfFlow N}
    {cf : Ix0 → ℝ → (MIx →₀ ℝ)} (hE : ExpandRP b Wf cf z μ) (hG : ProxyGen W b Wf cf r) :
    ApproxK (kernC (NeZero.ne N) (CRen N z μ) 0) (mixKG hN2 W (CRen N z μ) r)
      (gramF hN2 W r) := by
  haveI : ((ultra : Ultrafilter ℕ) : Filter ℕ).NeBot := ultra.neBot'
  have hUL : UnifLocal (CRen N z μ) := unifLocal_buildRen (rhoD (fR N) z) (bareD (fR N) (bR N)) μ
  have hcov : ReflCovLat (CRen N z μ) 0 := reflCovLat_CRen z μ
  have hMC := mixConvG_of_cov hN2 W hU hphys (CRen N z μ) hUL hcov hCO
  have hRL := reflLimG_of_cov hN2 W (CRen N z μ) r hcov hCO hMC
  have hpos := Flow.posPreserving_of_physRange (NeZero.ne N) (Φ0 W) hphys 0
  intro P ε hε
  obtain ⟨s, hs, hsb, hEs⟩ := hE P (ε / 4) (by positivity)
  obtain ⟨a, ha⟩ := hG P s hs hsb (ε / 4) (by positivity)
  refine ⟨a, ?_⟩
  have hX : Tendsto (fun k => xL (fun Q : MarginMono N 0 r =>
      rMixC (NeZero.ne N) (CRen N z μ) (Φ0 W) 0 k P.1 Q.1) a) (ultra : Filter ℕ)
      (𝓝 (xL (mixKG hN2 W (CRen N z μ) r P) a)) :=
    tendsto_xL (g := fun k (Q : MarginMono N 0 r) => rMixC (NeZero.ne N) (CRen N z μ) (Φ0 W) 0 k P.1 Q.1)
      (fun Q => hRL.2 P Q) a
  have hGr : Tendsto (fun k => gForm (fun Q Q' : MarginMono N 0 r =>
      latSF (NeZero.ne N) (Φ0 W) k (pairFam 0 Q.1 Q'.1)) a a) (ultra : Filter ℕ)
      (𝓝 (gForm (gramF hN2 W r) a a)) :=
    tendsto_gForm (G := fun k (Q Q' : MarginMono N 0 r) => latSF (NeZero.ne N) (Φ0 W) k (pairFam 0 Q.1 Q'.1))
      (fun Q Q' => tendsto_contSF (NeZero.ne N) (Φ0 W) (ClaySUGap.uB (NeZero.ne N) W hU) (pairFam 0 Q.1 Q'.1)) a
  have hT := (((hRL.1 P P).sub (hX.const_mul 2)).add hGr).congr fun k =>
    (rform_sub_yW W z μ k P.1 a).symm
  have hQ : ∀ᶠ k in atTop, ∀ Q ∈ a.support, prodSmear (dySpacing N k) ((Φ0 W).mono k Q.1)
      ∈ HalfSpaceAlgebra.halfSpaceAlg (G := MassGap.SUN.SU N) 0 0 :=
    (Filter.eventually_all_finset a.support).mpr fun Q _ => eventually_flow_mem (Φ0 W) hpos Q
  have hev : ∀ᶠ k in (ultra : Filter ℕ),
      rform (stateK (NeZero.ne N) k) (LatticeReflection.ireflObs 0 0)
        (prodSmear (dySpacing N k) (cMono (NeZero.ne N) (CRen N z μ) k P.1) - yW W k a)
        (prodSmear (dySpacing N k) (cMono (NeZero.ne N) (CRen N z μ) k P.1) - yW W k a) ≤ ε := by
    filter_upwards [hEs, ha, (eventually_cMono_mem (NeZero.ne N) (CRen N z μ) hUL P).filter_mono ultra_le,
      hQ.filter_mono ultra_le] with k hk1 hk2 hA hY
    have hYm : yW W k a ∈ HalfSpaceAlgebra.halfSpaceAlg (G := MassGap.SUN.SU N) 0 0 :=
      Submodule.sum_mem _ fun Q hQ => Submodule.smul_mem _ _ (hY Q hQ)
    have hp := rform_para_le (rform (stateK (NeZero.ne N) k) (LatticeReflection.ireflObs 0 0)) (rform_symm_k k)
      (prodSmear (dySpacing N k) (cMono (NeZero.ne N) (CRen N z μ) k P.1)) (proxB Wf cf k s P.1) (yW W k a)
      (by
        rw [rform_apply]
        exact stateK_rp (NeZero.ne N) k 0 _ (sub_mem (sub_mem hA hk1.1) (sub_mem hk1.1 hYm)))
    linarith [hk1.2]
  exact le_of_tendsto hT hev

/-- **`ApproxK` from `ExpandRP` and `ProxyGen`** at `SU(2)` (`approxK_of_expandRP_SU`). -/
theorem approxK_of_expandRP {W : ConfFlow 2} {t C : ℝ}
    (hU : ClassMoments h2N W (SymPlaqClass 2) t C) {r : ℝ} (hphys : (Φ0 W).PhysRange r)
    {z : Chan → ℕ → ℝ} {μ : OffMix} (hCO : CompOS h2N (CRen 2 z μ)) {b : ℝ} {Wf : ℝ → ConfFlow 2}
    {cf : Ix0 → ℝ → (MIx →₀ ℝ)} (hE : ExpandRP b Wf cf z μ) (hG : ProxyGen W b Wf cf r) :
    ApproxK (kernC h2N (CRen 2 z μ) 0) (mixKG (le_refl 2) W (CRen 2 z μ) r)
      (gramF (le_refl 2) W r) :=
  approxK_of_expandRP_SU (le_refl 2) hU hphys hCO hE hG

end MassGap.ApproxFromExpand

