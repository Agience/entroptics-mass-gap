import Mathlib
import MassGap.CompositesBuild
import MassGap.ObserverAxioms
import MassGap.ClassicalLimit

/-!
# MassGap.ClayData — the SU capstone at a channel-diagonal mixing

`CompositesBuild.clayStatementAt_SU_build` takes a mixing `ρ`, its Riemann symmetries `hRie`, the
scalar tie `hTie`, the channel tie `hCT`, the physical range `hphys` and, for the composites built
from bare fields, `RenTensor ρ bare`. This module fixes `ρ` and `bare` from data and proves those
five inputs.

## The channels

On rank-four coefficient tensors `V4 = Idx4 → ℝ`:

* `Rl`, the Riemann symmetriser: the signed average over the eight index maps generated by `swap01`,
  `swap23`, `pairEx`. It is idempotent (`Rl_idem`), self-adjoint (`dot_Rl`) and commutes with the
  tensor action `Tl A` of every `A` (`Rl_Tl`).
* `t = 2 Rl(kt δ)`, `t_α = δ_{α₀α₂}δ_{α₁α₃} − δ_{α₀α₃}δ_{α₁α₂}` (`tv_eq`); `ε = epsC`.
* the four channel projectors `P c` (`Chan`): `sc` the scalar `⟨t, ·⟩ t/⟨t, t⟩`, `ps` the
  pseudoscalar `⟨ε, ·⟩ ε/⟨ε, ε⟩`, `ri` the traceless Ricci part `2 Rl ∘ kt ∘ π ∘ ric ∘ Rl`
  (`π` the traceless symmetric projector on two-index tensors), `we` the rest `Rl − P sc − P ps − P ri`.

Proved: `P c ∘ P d = [c = d] P c` (`P_mul`), `Rl ∘ P c = P c` (`Rl_P`), `P c` commutes with `Tl A`
for orthogonal `A` (`P_Tl`; the Levi-Civita contraction is the determinant, `epsDet`),
`P c t = [c = sc] t` (`P_tv`), `⟨ε, P c x⟩ = [c = ps] ⟨ε, x⟩` (`eps_dot_P`), and
`⟨trC, P c x⟩ = 0` off the scalar channel (`trC_dot_P`). `Pm c` is the matrix of `P c`.

## The data

Inputs: tensor fields `f : Idx4 → LField`, bare fields `bareO` on the monomials other than the
tensor ones, and channel factors `z : Chan → ℕ → ℝ`.

* Basis `BD = Option (Chan × Idx4)`: `none ↦ obs = sym (plaqField q0)`; `some (c, γ) ↦ opT f c γ`,
  the channel component `∑_δ (Pm c)_{γδ} f_δ` shifted by a constant so that its value at the unit
  configuration is `vtag N c = obs(1) + 1 + cidx c`. The shift separates the channels as fields
  (`opT_ne`, `vtag_inj`), so the per-field factor `ZD z` reads the channel: `ZD z k obs = z_sc k`,
  `ZD z k (opT f c γ) = z_c k` (`ZD_obs`, `ZD_opT`). The shift drops out of every connected
  reading: the basis field `locField` hands to `latT` and `mixLatT` at `opT f c γ` is
  `Fv f c γ` minus its expectation (`locField_opT`).
* Coefficients `mD N`: `w t_α` on `obs` with `w = N/(8⟨t, t⟩)`; `(Pm c)_{αγ}` on `opT f c γ` for
  `c ≠ sc`; `0` on the scalar channel fields.
* `rhoD f z = mixOfZ BD (opD f) (mD N) (ZD z)`; `bareD f bareO` is `bareT f α = w t_α obs +
  ∑_{c ≠ sc} Fv f c α` at `eI α` and `bareO` elsewhere.

## What is proved at the data

* `hRie`: `coefRiemann_mD` and `ClayWiring.riemann_mixOfZ`.
* `hTie`: the trace coefficient is `N/16` on `obs` and `0` elsewhere (`coefC_mD`), so
  `ClayWiring.scalarTie_mixOfZ` gives it from `z_sc k · a_k⁴ → 2` (`scalarTie_D`).
* `hCT` with `Mb = mD N`, `Zc k = ∑_c z_c k Pm c`: the factorisation `M = Zc · Mb` (`M_rhoD`), the
  hypercubic commutation (`Zc_Tm`), the classical lead of `∑_b Mb_{βb} op b` from `TiedB` (it is
  `bareT f β` plus a constant, `channelLead_of_tied`), and `(zAct (Zc k) ε) id = z_ps k`
  (`zAct_eps`) with `z_ps k · a_k⁴ → 2` (`channelTie_D`).
* `TiedB` at the tensor fields `f δ = bareF (emono δ)` and `bareO = bareF`, from the classical lead
  `(16/N) g² ⟨trC, ffT g A⟩` of `obs` (`tiedB_bareD_of_obs'`): `ffT g A` has the Riemann symmetries
  (`ffT_riemann`), and on such tensors the lead of `bareT f β` is `g² ffT g A β` (`lead_alg`).
* `RenTensor`: from `z_c k ≠ 0` (`renTensor_D`): projecting the mixing components on each channel
  recovers `obs` and every `Fv f c γ`, `c ≠ sc`, and these span the bare tensor fields and back.
* `hphys` at any `r > 0` from `aₖ · range k → 0` (`physD`), a sufficient condition the capstone
  does not need.

`clayStatementAt_SU_data` is the capstone: its inputs are `hU`, `hphys : PhysRange r` at one `r`,
`hfar`, `f`, `bareO`, `z`
with `hz`, `hzS`, `hzP`, `G`, `hK`, `hAF`, `hNG`, `hWard`, `hT : TiedB (bareD f bareO)`, `hCO`,
`wC`, `hLC`, `hX`.

Foundational footprint only (`#print axioms` at the end).

DERIVED (module-wide): `0`–`3` the tensor slots; `4` the dimension; `1`, `0` the unit and zero
coefficients and the Kronecker values; `2`, `8`, `16` as in `ScalarTie` and `TopNorm`; `1/8` the
order of the symmetriser group; `1/4`, `1/2` the trace normalisations of two-index tensors in
dimension `4`.
-/

noncomputable section

namespace MassGap.ClayData

open MassGap MassGap.ClayStatement MassGap.ObserverNontrivial Matrix

/-! ## Rank-four coefficient tensors -/

/-- Rank-four coefficient tensors. DERIVED: no numeral. -/
abbrev V4 : Type := Idx4 → ℝ

/-- Two-index tensors. DERIVED: `4` the dimension. -/
abbrev S2 : Type := Fin 4 → Fin 4 → ℝ

/-- The Kronecker delta, written symmetrically in its arguments.

DERIVED: `4` the dimension; `1`, `0` its values; `2` the two symmetric halves. -/
def dl (a b : Fin 4) : ℝ := ((if a = b then 1 else 0) + (if b = a then 1 else 0)) / 2

theorem dl_self (a : Fin 4) : dl a a = 1 := by simp [dl]

theorem dl_ne {a b : Fin 4} (h : a ≠ b) : dl a b = 0 := by
  simp [dl, h, Ne.symm h]

theorem ite_eq_dl (a b : Fin 4) : (if a = b then (1 : ℝ) else 0) = dl a b := by
  by_cases h : a = b
  · subst h; simp [dl]
  · simp [dl, h, Ne.symm h]

theorem sum_dl_mul (a : Fin 4) (f : Fin 4 → ℝ) : ∑ l, dl a l * f l = f a := by
  simp only [← ite_eq_dl, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]

theorem sum_mul_dl (a : Fin 4) (f : Fin 4 → ℝ) : ∑ l, f l * dl l a = f a := by
  simp only [← ite_eq_dl, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]

theorem sum_dl_mul' (a : Fin 4) (f : Fin 4 → ℝ) : ∑ l, dl l a * f l = f a := by
  simp only [← ite_eq_dl, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]

theorem vec_eta (α : Idx4) : ![α 0, α 1, α 2, α 3] = α := by
  funext i; fin_cases i <;> rfl

/-! ## The Riemann symmetriser -/

/-- **The Riemann symmetriser**: the signed average of `x` over the eight index maps generated by
`swap01`, `swap23`, `pairEx`.

DERIVED: `0`–`3` the slots; `1/8` the order of the group. -/
def rsym (x : V4) : V4 := fun α => (1 / 8 : ℝ) * (x ![α 0, α 1, α 2, α 3] - x ![α 1, α 0, α 2, α 3]
  - x ![α 0, α 1, α 3, α 2] + x ![α 1, α 0, α 3, α 2] + x ![α 2, α 3, α 0, α 1]
  - x ![α 2, α 3, α 1, α 0] - x ![α 3, α 2, α 0, α 1] + x ![α 3, α 2, α 1, α 0])

/-- `rsym` as a linear map. DERIVED: no numeral. -/
def Rl : Module.End ℝ V4 where
  toFun := rsym
  map_add' x y := by funext α; simp only [rsym, Pi.add_apply]; ring
  map_smul' c x := by funext α; simp only [rsym, Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; ring

theorem Rl_apply (x : V4) (α : Idx4) : Rl x α = rsym x α := rfl

theorem Rl_idem : Rl * Rl = Rl := by
  refine LinearMap.ext fun x => funext fun α => ?_
  show rsym (rsym x) α = rsym x α
  simp [rsym]
  ring

theorem rsym_swap01 (y : V4) (α : Idx4) : rsym y (swap01 α) = -rsym y α := by
  simp only [rsym, swap01, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
  ring

theorem rsym_swap23 (y : V4) (α : Idx4) : rsym y (swap23 α) = -rsym y α := by
  simp only [rsym, swap23, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
  ring

theorem rsym_pairEx (y : V4) (α : Idx4) : rsym y (pairEx α) = rsym y α := by
  simp only [rsym, pairEx, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
  ring

/-- Reindexing a sum by an involution-pair. -/
theorem sum_reidx (f g : Idx4 → Idx4) (hfg : ∀ α, f (g α) = α) (hgf : ∀ α, g (f α) = α)
    (F : Idx4 → ℝ) : ∑ α, F (f α) = ∑ α, F α :=
  Equiv.sum_comp ⟨f, g, hgf, hfg⟩ F

theorem dot_reidx (f g : Idx4 → Idx4) (hfg : ∀ α, f (g α) = α) (hgf : ∀ α, g (f α) = α)
    (x y : V4) : ∑ α, y α * x (f α) = ∑ α, x α * y (g α) := by
  rw [← sum_reidx f g hfg hgf (fun β => x β * y (g β))]
  exact Finset.sum_congr rfl fun α _ => by rw [hgf]; ring

/-- The index map `(1023)`. DERIVED: `0`–`3` the slots. -/
def p1 (α : Idx4) : Idx4 := ![α 1, α 0, α 2, α 3]
/-- The index map `(0132)`. DERIVED: `0`–`3` the slots. -/
def p2 (α : Idx4) : Idx4 := ![α 0, α 1, α 3, α 2]
/-- The index map `(1032)`. DERIVED: `0`–`3` the slots. -/
def p3 (α : Idx4) : Idx4 := ![α 1, α 0, α 3, α 2]
/-- The index map `(2301)`. DERIVED: `0`–`3` the slots. -/
def p4 (α : Idx4) : Idx4 := ![α 2, α 3, α 0, α 1]
/-- The index map `(2310)`. DERIVED: `0`–`3` the slots. -/
def p5 (α : Idx4) : Idx4 := ![α 2, α 3, α 1, α 0]
/-- The index map `(3201)`. DERIVED: `0`–`3` the slots. -/
def p6 (α : Idx4) : Idx4 := ![α 3, α 2, α 0, α 1]
/-- The index map `(3210)`. DERIVED: `0`–`3` the slots. -/
def p7 (α : Idx4) : Idx4 := ![α 3, α 2, α 1, α 0]

theorem p1p1 (α : Idx4) : p1 (p1 α) = α := by funext i; fin_cases i <;> rfl
theorem p2p2 (α : Idx4) : p2 (p2 α) = α := by funext i; fin_cases i <;> rfl
theorem p3p3 (α : Idx4) : p3 (p3 α) = α := by funext i; fin_cases i <;> rfl
theorem p4p4 (α : Idx4) : p4 (p4 α) = α := by funext i; fin_cases i <;> rfl
theorem p5p6 (α : Idx4) : p5 (p6 α) = α := by funext i; fin_cases i <;> rfl
theorem p6p5 (α : Idx4) : p6 (p5 α) = α := by funext i; fin_cases i <;> rfl
theorem p7p7 (α : Idx4) : p7 (p7 α) = α := by funext i; fin_cases i <;> rfl

theorem rsym_eq (x : V4) (α : Idx4) : rsym x α = (1 / 8 : ℝ) * (x α - x (p1 α) - x (p2 α)
    + x (p3 α) + x (p4 α) - x (p5 α) - x (p6 α) + x (p7 α)) := by
  rw [rsym, vec_eta]; rfl

theorem dot_rsym (x y : V4) : ∑ α, y α * rsym x α = (1 / 8 : ℝ) * (∑ α, y α * x α
    - ∑ α, y α * x (p1 α) - ∑ α, y α * x (p2 α) + ∑ α, y α * x (p3 α) + ∑ α, y α * x (p4 α)
    - ∑ α, y α * x (p5 α) - ∑ α, y α * x (p6 α) + ∑ α, y α * x (p7 α)) := by
  simp only [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib, Finset.mul_sum]
  exact Finset.sum_congr rfl fun α _ => by rw [rsym_eq]; ring

/-- **The symmetriser is self-adjoint.** -/
theorem dot_Rl (x y : V4) : y ⬝ᵥ Rl x = Rl y ⬝ᵥ x := by
  have e : Rl y ⬝ᵥ x = x ⬝ᵥ Rl y := dotProduct_comm _ _
  rw [e]
  simp only [dotProduct, Rl_apply, dot_rsym]
  rw [dot_reidx p1 p1 p1p1 p1p1 x y, dot_reidx p2 p2 p2p2 p2p2 x y, dot_reidx p3 p3 p3p3 p3p3 x y,
    dot_reidx p4 p4 p4p4 p4p4 x y, dot_reidx p5 p6 p5p6 p6p5 x y, dot_reidx p6 p5 p6p5 p5p6 x y,
    dot_reidx p7 p7 p7p7 p7p7 x y]
  simp only [mul_comm (y _) (x _)]
  ring

/-! ## The tensor action -/

/-- The tensor action of `A` as a matrix on `Idx4`. DERIVED: `4` the dimension. -/
def Tm (A : Matrix (Fin 4) (Fin 4) ℝ) : Matrix Idx4 Idx4 ℝ := Matrix.of fun α β => tcoef A α β

/-- The tensor action of `A` as a linear map. DERIVED: `4` the dimension. -/
def Tl (A : Matrix (Fin 4) (Fin 4) ℝ) : Module.End ℝ V4 := Matrix.toLin' (Tm A)

theorem Tl_apply (A : Matrix (Fin 4) (Fin 4) ℝ) (x : V4) (α : Idx4) :
    Tl A x α = ∑ β, tcoef A α β * x β := by
  simp [Tl, Matrix.toLin'_apply, Matrix.mulVec, dotProduct, Tm]

theorem tc4 (A : Matrix (Fin 4) (Fin 4) ℝ) (α β : Idx4) :
    tcoef A α β = A (β 0) (α 0) * A (β 1) (α 1) * A (β 2) (α 2) * A (β 3) (α 3) := by
  simp only [tcoef, Fin.prod_univ_four]

theorem tsum_reidx (A : Matrix (Fin 4) (Fin 4) ℝ) (x : V4) (α : Idx4) (f g : Idx4 → Idx4)
    (hfg : ∀ α, f (g α) = α) (hgf : ∀ α, g (f α) = α)
    (hT : ∀ β, tcoef A α (g β) = tcoef A (f α) β) :
    ∑ β, tcoef A α β * x (f β) = ∑ β, tcoef A (f α) β * x β := by
  rw [dot_reidx f g hfg hgf x (fun β => tcoef A α β)]
  exact Finset.sum_congr rfl fun β _ => by rw [hT]; ring

/-- **The symmetriser commutes with the tensor action.** -/
theorem Rl_Tl (A : Matrix (Fin 4) (Fin 4) ℝ) : Rl * Tl A = Tl A * Rl := by
  refine LinearMap.ext fun x => funext fun α => ?_
  show rsym (Tl A x) α = Tl A (Rl x) α
  rw [Tl_apply]
  simp only [Rl_apply]
  rw [dot_rsym x (fun β => tcoef A α β)]
  rw [tsum_reidx A x α p1 p1 p1p1 p1p1 (fun β => by rw [tc4, tc4]; simp only [p1, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]; ring),
    tsum_reidx A x α p2 p2 p2p2 p2p2 (fun β => by rw [tc4, tc4]; simp only [p2, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]; ring),
    tsum_reidx A x α p3 p3 p3p3 p3p3 (fun β => by rw [tc4, tc4]; simp only [p3, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]; ring),
    tsum_reidx A x α p4 p4 p4p4 p4p4 (fun β => by rw [tc4, tc4]; simp only [p4, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]; ring),
    tsum_reidx A x α p5 p6 p5p6 p6p5 (fun β => by rw [tc4, tc4]; simp only [p5, p6, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]; ring),
    tsum_reidx A x α p6 p5 p6p5 p5p6 (fun β => by rw [tc4, tc4]; simp only [p5, p6, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]; ring),
    tsum_reidx A x α p7 p7 p7p7 p7p7 (fun β => by rw [tc4, tc4]; simp only [p7, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]; ring)]
  rw [rsym_eq]
  simp only [Tl_apply]

/-! ## The Levi-Civita tensor -/

theorem eps_perm (σ : Equiv.Perm (Fin 4)) :
    epsC ⇑σ = (((Equiv.Perm.sign σ : ℤˣ) : ℤ) : ℝ) := by
  have h : Equiv.ofBijective (⇑σ) σ.bijective = σ := Equiv.ext fun _ => rfl
  rw [epsC, dif_pos σ.bijective, h]

theorem eps_zero (α : Idx4) (h : ¬ Function.Bijective α) : epsC α = 0 := by
  rw [epsC, dif_neg h]

theorem eps_zero_of {α : Idx4} (i j : Fin 4) (hij : i ≠ j) (h : α i = α j) : epsC α = 0 :=
  eps_zero α fun hb => hij (hb.1 h)

theorem eps_id : epsC id = 1 := by
  have := eps_perm 1
  simpa using this

theorem eps_sum (f : Idx4 → ℝ) :
    ∑ β, epsC β * f β = ∑ σ : Equiv.Perm (Fin 4), (((Equiv.Perm.sign σ : ℤˣ) : ℤ) : ℝ) * f ⇑σ := by
  have e : ∑ σ : Equiv.Perm (Fin 4), (((Equiv.Perm.sign σ : ℤˣ) : ℤ) : ℝ) * f ⇑σ
      = ∑ σ : Equiv.Perm (Fin 4), epsC ⇑σ * f ⇑σ := by simp [eps_perm]
  rw [e]
  symm
  let emb : Equiv.Perm (Fin 4) ↪ Idx4 := ⟨fun σ => (⇑σ : Idx4), DFunLike.coe_injective⟩
  refine (Finset.sum_map Finset.univ emb (fun β => epsC β * f β)).symm.trans ?_
  refine Finset.sum_subset (Finset.subset_univ _) fun β _ hβ => ?_
  have : ¬ Function.Bijective β := fun hb =>
    hβ (Finset.mem_map.2 ⟨Equiv.ofBijective β hb, Finset.mem_univ _, rfl⟩)
  rw [eps_zero β this, zero_mul]

/-- **The Levi-Civita contraction is the determinant.** -/
theorem epsDet (B : Matrix (Fin 4) (Fin 4) ℝ) (α : Idx4) :
    ∑ β, epsC β * ∏ j, B (β j) (α j) = B.det * epsC α := by
  rw [eps_sum]
  have hd : (Matrix.of fun i j => B i (α j)).det
      = ∑ σ : Equiv.Perm (Fin 4), (((Equiv.Perm.sign σ : ℤˣ) : ℤ) : ℝ) * ∏ j, B (σ j) (α j) := by
    rw [Matrix.det_apply]
    simp [Units.smul_def, zsmul_eq_mul]
  rw [← hd]
  by_cases hb : Function.Bijective α
  · have e : (Matrix.of fun i j => B i (α j)) = B.submatrix id (Equiv.ofBijective α hb) := rfl
    rw [e, Matrix.det_permute']
    have : epsC α = epsC ⇑(Equiv.ofBijective α hb) := rfl
    rw [this, eps_perm]
    ring
  · have hi : ¬ Function.Injective α := fun h => hb (Finite.injective_iff_bijective.1 h)
    obtain ⟨i, j, hij, hne⟩ := Function.not_injective_iff.1 hi
    rw [Matrix.det_zero_of_column_eq hne (fun k => by simp [hij]), eps_zero α hb, mul_zero]

theorem eps_comp (α : Idx4) (σ : Equiv.Perm (Fin 4)) :
    epsC (α ∘ ⇑σ) = (((Equiv.Perm.sign σ : ℤˣ) : ℤ) : ℝ) * epsC α := by
  by_cases hb : Function.Bijective α
  · have e1 : (α ∘ ⇑σ) = ⇑(σ.trans (Equiv.ofBijective α hb)) := rfl
    have e2 : epsC α = epsC ⇑(Equiv.ofBijective α hb) := rfl
    rw [e1, e2, eps_perm, eps_perm, Equiv.Perm.sign_trans]
    push_cast
    ring
  · have hb' : ¬ Function.Bijective (α ∘ ⇑σ) := fun h => hb (by
      have : α = (α ∘ ⇑σ) ∘ ⇑σ.symm := by funext i; simp
      rw [this]; exact h.comp σ.symm.bijective)
    rw [eps_zero α hb, eps_zero _ hb', mul_zero]

/-- The transposition of slots `0`, `1`. DERIVED: `4` the dimension; `0`, `1` the slots. -/
def s01 : Equiv.Perm (Fin 4) := Equiv.swap 0 1
/-- The transposition of slots `2`, `3`. DERIVED: `4` the dimension; `2`, `3` the slots. -/
def s23 : Equiv.Perm (Fin 4) := Equiv.swap 2 3
/-- The pair exchange `(02)(13)`. DERIVED: `4` the dimension; `0`–`3` the slots. -/
def s0213 : Equiv.Perm (Fin 4) := Equiv.swap 0 2 * Equiv.swap 1 3

theorem p1_eq (α : Idx4) : p1 α = α ∘ ⇑s01 := by funext i; fin_cases i <;> rfl
theorem p2_eq (α : Idx4) : p2 α = α ∘ ⇑s23 := by funext i; fin_cases i <;> rfl
theorem p3_eq (α : Idx4) : p3 α = α ∘ ⇑(s01 * s23) := by funext i; fin_cases i <;> rfl
theorem p4_eq (α : Idx4) : p4 α = α ∘ ⇑s0213 := by funext i; fin_cases i <;> rfl
theorem p5_eq (α : Idx4) : p5 α = α ∘ ⇑(s01 * s0213) := by funext i; fin_cases i <;> rfl
theorem p6_eq (α : Idx4) : p6 α = α ∘ ⇑(s23 * s0213) := by funext i; fin_cases i <;> rfl
theorem p7_eq (α : Idx4) : p7 α = α ∘ ⇑(s01 * s23 * s0213) := by funext i; fin_cases i <;> rfl

theorem sign_s01 : (((Equiv.Perm.sign s01 : ℤˣ) : ℤ) : ℝ) = -1 := by
  simp [s01]
theorem sign_s23 : (((Equiv.Perm.sign s23 : ℤˣ) : ℤ) : ℝ) = -1 := by
  simp [s23]
theorem sign_s0213 : (((Equiv.Perm.sign s0213 : ℤˣ) : ℤ) : ℝ) = 1 := by
  simp [s0213, Equiv.Perm.sign_mul]

theorem rsym_eps : rsym epsC = epsC := by
  funext α
  rw [rsym_eq, p1_eq, p2_eq, p3_eq, p4_eq, p5_eq, p6_eq, p7_eq]
  simp only [eps_comp, Equiv.Perm.sign_mul, Units.val_mul, Int.cast_mul, sign_s01, sign_s23,
    sign_s0213]
  ring

/-! ## Contractions -/

/-- The Kronecker delta as a two-index tensor. DERIVED: no numeral. -/
def dS : S2 := fun a b => dl a b

/-- `h_{α₀α₂} δ_{α₁α₃}`, the transpose of the Ricci contraction (`dot_kt`).

DERIVED: `0`–`3` the slots. -/
def kt (h : S2) : V4 := fun α => h (α 0) (α 2) * dl (α 1) (α 3)

/-- The Kulkarni–Nomizu product of `δ` and `h`. DERIVED: `0`–`3` the slots. -/
def kk (h : S2) : V4 := fun α => dl (α 0) (α 2) * h (α 1) (α 3) - dl (α 0) (α 3) * h (α 1) (α 2)
  - dl (α 1) (α 2) * h (α 0) (α 3) + dl (α 1) (α 3) * h (α 0) (α 2)

/-- The Ricci contraction `∑_λ x_{aλbλ}`. DERIVED: no numeral. -/
def ric (x : V4) : S2 := fun a b => ∑ l, x ![a, l, b, l]

/-- The trace. DERIVED: no numeral. -/
def trS (h : S2) : ℝ := ∑ a, h a a

/-- The traceless symmetric part. DERIVED: `2` the symmetrisation; `4` the dimension. -/
def piS (h : S2) : S2 := fun a b => (h a b + h b a) / 2 - trS h / 4 * dl a b

/-- The inner product of two-index tensors. DERIVED: no numeral. -/
def dotS (g h : S2) : ℝ := ∑ a, ∑ b, g a b * h a b

/-- `kt` as a linear map. DERIVED: no numeral. -/
def ktL : S2 →ₗ[ℝ] V4 where
  toFun := kt
  map_add' g h := by funext α; simp only [kt, Pi.add_apply]; ring
  map_smul' c h := by funext α; simp only [kt, Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; ring

/-- `ric` as a linear map. DERIVED: no numeral. -/
def ricL : V4 →ₗ[ℝ] S2 where
  toFun := ric
  map_add' x y := by funext a b; simp only [ric, Pi.add_apply, Finset.sum_add_distrib]
  map_smul' c x := by
    funext a b; simp only [ric, Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]

theorem trS_add (g h : S2) : trS (g + h) = trS g + trS h := by
  simp [trS, Finset.sum_add_distrib]

theorem trS_smul (c : ℝ) (h : S2) : trS (c • h) = c * trS h := by
  simp [trS, Finset.mul_sum]

/-- `piS` as a linear map. DERIVED: no numeral. -/
def piL : S2 →ₗ[ℝ] S2 where
  toFun := piS
  map_add' g h := by funext a b; simp only [piS, Pi.add_apply, trS_add]; ring
  map_smul' c h := by
    funext a b; simp only [piS, Pi.smul_apply, smul_eq_mul, RingHom.id_apply, trS_smul]; ring

theorem rsym_kt (g : S2) (hg : ∀ a b, g a b = g b a) (α : Idx4) :
    rsym (kt g) α = (1 / 4 : ℝ) * kk g α := by
  simp only [rsym, kt, kk, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
  simp only [hg (α 2) (α 0), hg (α 2) (α 1), hg (α 3) (α 0), hg (α 3) (α 1)]
  simp only [dl]
  ring

theorem ric_kk (g : S2) (a b : Fin 4) : ric (kk g) a b = 2 * g a b + trS g * dl a b := by
  simp only [ric, kk, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
  rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
    sum_dl_mul a (fun l => g l b), sum_dl_mul' b (fun l => g a l)]
  simp only [dl_self, one_mul, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
    trS]
  push_cast
  ring

theorem piS_symm (h : S2) (a b : Fin 4) : piS h a b = piS h b a := by
  simp only [piS, dl]; ring

theorem trS_piS (h : S2) : trS (piS h) = 0 := by
  have e : ∀ a, piS h a a = h a a - trS h / 4 := fun a => by simp only [piS, dl_self]; ring
  show ∑ a, piS h a a = 0
  simp only [e, Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    nsmul_eq_mul]
  unfold trS
  push_cast
  ring

theorem piS_piS (h : S2) : piS (piS h) = piS h := by
  funext a b
  rw [piS, trS_piS, piS_symm h b a]
  ring

theorem ric_rsym_kt_piS (h : S2) : ric (rsym (kt (piS h))) = (1 / 2 : ℝ) • piS h := by
  funext a b
  have e : ric (rsym (kt (piS h))) a b = (1 / 4 : ℝ) * ric (kk (piS h)) a b := by
    simp only [ric, Finset.mul_sum]
    exact Finset.sum_congr rfl fun l _ => rsym_kt _ (piS_symm h) _
  rw [e, ric_kk, trS_piS]
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

theorem dS_symm (a b : Fin 4) : dS a b = dS b a := by simp only [dS, dl]; ring

theorem trS_dS : trS dS = 4 := by
  simp [trS, dS, dl_self]

theorem piS_smul_dS (c : ℝ) : piS (c • dS) = 0 := by
  funext a b
  simp only [piS, trS_smul, trS_dS, Pi.smul_apply, smul_eq_mul, dS, Pi.zero_apply, dl]
  ring

/-- `⟨y, kt g⟩ = ⟨ric y, g⟩`. -/
theorem dot_kt (y : V4) (g : S2) : ∑ α, y α * kt g α = dotS (ric y) g := by
  rw [CompositesBuild.sum_idx4]
  have e : ∀ a b c, ∑ d, y ![a, b, c, d] * kt g ![a, b, c, d] = y ![a, b, c, b] * g a c := by
    intro a b c
    have := sum_dl_mul b (fun d => y ![a, b, c, d] * g a c)
    rw [← this]
    refine Finset.sum_congr rfl fun d _ => ?_
    simp only [kt, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
    ring
  simp only [e, dotS, ric, Finset.sum_mul]
  exact Finset.sum_congr rfl fun a _ => Finset.sum_comm

/-! ## The tensor `t` -/

/-- **The scalar tensor** `t = 2 Rl(kt δ)`, `t_α = δ_{α₀α₂}δ_{α₁α₃} − δ_{α₀α₃}δ_{α₁α₂}` (`tv_eq`).

DERIVED: `2` the factor that makes `t` the antisymmetrised `δ ⊗ δ`. -/
def tv : V4 := fun α => 2 * rsym (kt dS) α

theorem tv_eq (α : Idx4) : tv α = dl (α 0) (α 2) * dl (α 1) (α 3) - dl (α 0) (α 3) * dl (α 1) (α 2) := by
  rw [tv, rsym_kt dS dS_symm]
  simp only [kk, dS, dl]
  ring

theorem rsym_tv : rsym tv = tv := by
  funext α
  have h : rsym (rsym (kt dS)) α = rsym (kt dS) α :=
    congrArg (fun F : Module.End ℝ V4 => F (kt dS) α) Rl_idem
  show rsym (fun β => 2 * rsym (kt dS) β) α = 2 * rsym (kt dS) α
  rw [← h]
  simp only [rsym]
  ring

theorem ric_tv : ric tv = (3 : ℝ) • dS := by
  funext a b
  have e : ric tv a b = (1 / 2 : ℝ) * ric (kk dS) a b := by
    simp only [ric, tv, Finset.mul_sum]
    exact Finset.sum_congr rfl fun l _ => by rw [rsym_kt dS dS_symm]; ring
  rw [e, ric_kk, trS_dS]
  simp only [Pi.smul_apply, smul_eq_mul, dS]
  ring

theorem ric_eps : ric epsC = 0 := by
  funext a b
  show ∑ l, epsC ![a, l, b, l] = 0
  exact Finset.sum_eq_zero fun l _ => eps_zero_of 1 3 (by decide) rfl

theorem tv_dot_eps : tv ⬝ᵥ epsC = 0 := by
  rw [dotProduct_comm]
  simp only [dotProduct]
  rw [eps_sum]
  refine Finset.sum_eq_zero fun σ _ => ?_
  rw [tv_eq]
  rw [dl_ne (σ.injective.ne (by decide : (0 : Fin 4) ≠ 2)),
    dl_ne (σ.injective.ne (by decide : (0 : Fin 4) ≠ 3))]
  ring

theorem tv_0101 : tv ![0, 1, 0, 1] = 1 := by
  rw [tv_eq]; simp [dl]

theorem nt_pos : 0 < tv ⬝ᵥ tv := by
  have h := Finset.single_le_sum (f := fun α => tv α * tv α) (fun α _ => mul_self_nonneg (tv α))
    (Finset.mem_univ ![0, 1, 0, 1])
  simp only [tv_0101, mul_one] at h
  simp only [dotProduct]
  linarith

theorem ne_pos : 0 < epsC ⬝ᵥ epsC := by
  have h := Finset.single_le_sum (f := fun α => epsC α * epsC α)
    (fun α _ => mul_self_nonneg (epsC α)) (Finset.mem_univ id)
  simp only [eps_id, mul_one] at h
  simp only [dotProduct]
  linarith

theorem trC_eq : trC = kt dS := by
  funext α
  by_cases h1 : α 2 = α 0 <;> by_cases h2 : α 3 = α 1
  · simp [trC, kt, dS, h1, h2, dl_self]
  · have h2' : ¬ α 1 = α 3 := fun h => h2 h.symm
    simp [trC, kt, dS, h1, h2, dl_ne h2']
  · have h1' : ¬ α 0 = α 2 := fun h => h1 h.symm
    simp [trC, kt, dS, h1, h2, dl_ne h1']
  · have h1' : ¬ α 0 = α 2 := fun h => h1 h.symm
    simp [trC, kt, dS, h1, h2, dl_ne h1']

theorem rsym_trC : rsym trC = (1 / 2 : ℝ) • tv := by
  funext α
  rw [trC_eq]
  simp only [Pi.smul_apply, smul_eq_mul, tv]
  ring

/-! ## Orthogonal matrices -/

section Orth

variable (A : Matrix (Fin 4) (Fin 4) ℝ)

theorem colO (hA1 : Aᵀ * A = 1) (i j : Fin 4) : ∑ k, A k i * A k j = dl i j := by
  have h := congrFun (congrFun hA1 i) j
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply] at h
  rw [h, ite_eq_dl]

theorem rowO (hA2 : A * Aᵀ = 1) (i j : Fin 4) : ∑ k, A i k * A j k = dl i j := by
  have h := congrFun (congrFun hA2 i) j
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply] at h
  rw [h, ite_eq_dl]

/-- The action of `A` on two-index tensors. DERIVED: no numeral. -/
def sA (h : S2) : S2 := fun μ ν => ∑ ρ, ∑ σ, A ρ μ * A σ ν * h ρ σ

/-- `sA A` as a linear map. DERIVED: no numeral. -/

def sAL : S2 →ₗ[ℝ] S2 where
  toFun := sA A
  map_add' g h := by
    funext μ ν; simp only [sA, Pi.add_apply, mul_add, Finset.sum_add_distrib]
  map_smul' c h := by
    funext μ ν
    simp only [sA, Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
    exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring

theorem ric_Tl (hA2 : A * Aᵀ = 1) (x : V4) : ric (Tl A x) = sA A (ric x) := by
  funext μ ν
  have step1 : ric (Tl A x) μ ν = ∑ β, A (β 0) μ * A (β 2) ν * x β * dl (β 1) (β 3) := by
    show ∑ l, Tl A x ![μ, l, ν, l] = _
    simp only [Tl_apply, tc4]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun β _ => ?_
    rw [← rowO A hA2 (β 1) (β 3), Finset.mul_sum]
    refine Finset.sum_congr rfl fun l _ => ?_
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
    ring
  rw [step1, CompositesBuild.sum_idx4]
  simp only [sA, ric, Finset.mul_sum, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun b _ => ?_
  have := sum_dl_mul b (fun d => A a μ * A c ν * x ![a, b, c, d])
  rw [← this]
  exact Finset.sum_congr rfl fun d _ => by ring

theorem kt_sA (hA1 : Aᵀ * A = 1) (h : S2) : kt (sA A h) = Tl A (kt h) := by
  funext α
  have L : kt (sA A h) α
      = ∑ a, ∑ b, ∑ c, A a (α 0) * A b (α 1) * A c (α 2) * A b (α 3) * h a c := by
    show (∑ ρ, ∑ σ, A ρ (α 0) * A σ (α 2) * h ρ σ) * dl (α 1) (α 3) = _
    rw [← colO A hA1 (α 1) (α 3), Finset.sum_mul]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.sum_mul]
    simp only [Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun c _ => by ring
  have R : Tl A (kt h) α
      = ∑ a, ∑ b, ∑ c, A a (α 0) * A b (α 1) * A c (α 2) * A b (α 3) * h a c := by
    rw [Tl_apply, CompositesBuild.sum_idx4]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ =>
      Finset.sum_congr rfl fun c _ => ?_
    rw [← sum_dl_mul b (fun d => A a (α 0) * A b (α 1) * A c (α 2) * A d (α 3) * h a c)]
    refine Finset.sum_congr rfl fun d _ => ?_
    simp only [tc4, kt, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
          Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
    ring
  rw [L, R]

theorem trS_sA (hA2 : A * Aᵀ = 1) (h : S2) : trS (sA A h) = trS h := by
  show ∑ μ, ∑ ρ, ∑ σ, A ρ μ * A σ μ * h ρ σ = ∑ ρ, h ρ ρ
  calc ∑ μ, ∑ ρ, ∑ σ, A ρ μ * A σ μ * h ρ σ = ∑ ρ, ∑ σ, (∑ μ, A ρ μ * A σ μ) * h ρ σ := by
        simp only [Finset.sum_mul]
        exact Finset.sum_comm.trans (Finset.sum_congr rfl fun ρ _ => Finset.sum_comm)
    _ = ∑ ρ, ∑ σ, dl ρ σ * h ρ σ := by simp only [rowO A hA2]
    _ = ∑ ρ, h ρ ρ := Finset.sum_congr rfl fun ρ _ => sum_dl_mul ρ (fun σ => h ρ σ)

theorem sA_dS (hA1 : Aᵀ * A = 1) : sA A dS = dS := by
  funext μ ν
  show ∑ ρ, ∑ σ, A ρ μ * A σ ν * dl ρ σ = dl μ ν
  rw [← colO A hA1 μ ν]
  refine Finset.sum_congr rfl fun ρ _ => ?_
  have := sum_dl_mul ρ (fun σ => A ρ μ * A σ ν)
  rw [← this]
  exact Finset.sum_congr rfl fun σ _ => by ring

theorem piS_eq (h : S2) : piS h = (1 / 2 : ℝ) • h + (1 / 2 : ℝ) • (fun a b => h b a) - (trS h / 4) • dS := by
  funext a b
  simp only [piS, Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, dS]
  ring

theorem sA_swap (h : S2) : sA A (fun a b => h b a) = fun a b => sA A h b a := by
  funext μ ν
  show ∑ ρ, ∑ σ, A ρ μ * A σ ν * h σ ρ = ∑ ρ, ∑ σ, A ρ ν * A σ μ * h ρ σ
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring

theorem sA_add (g h : S2) : sA A (g + h) = sA A g + sA A h := (sAL A).map_add g h
theorem sA_sub (g h : S2) : sA A (g - h) = sA A g - sA A h := (sAL A).map_sub g h
theorem sA_smul (c : ℝ) (h : S2) : sA A (c • h) = c • sA A h := (sAL A).map_smul c h

theorem piS_sA (hA1 : Aᵀ * A = 1) (hA2 : A * Aᵀ = 1) (h : S2) : piS (sA A h) = sA A (piS h) := by
  rw [piS_eq h, sA_sub, sA_add, sA_smul, sA_smul, sA_smul, sA_swap A h, sA_dS A hA1, piS_eq (sA A h),
    trS_sA A hA2]

end Orth

/-! ## The projectors -/

/-- **The traceless Ricci projector** `2 Rl ∘ kt ∘ piS ∘ ric ∘ Rl`.

DERIVED: `2` the inverse of `ric ∘ Rl ∘ kt = 1/2` on traceless symmetric tensors
(`ric_rsym_kt_piS`). -/
def Ql : Module.End ℝ V4 := (2 : ℝ) • (Rl ∘ₗ ktL ∘ₗ piL ∘ₗ ricL ∘ₗ Rl)

theorem Ql_apply (x : V4) : Ql x = (2 : ℝ) • Rl (kt (piS (ric (Rl x)))) := rfl

theorem Rl_Rl (x : V4) : Rl (Rl x) = Rl x := congrArg (fun F : Module.End ℝ V4 => F x) Rl_idem

theorem Rl_eps : Rl epsC = epsC := rsym_eps
theorem Rl_tv : Rl tv = tv := rsym_tv

theorem dot_Rl' (x y : V4) : Rl y ⬝ᵥ x = y ⬝ᵥ Rl x := (dot_Rl x y).symm

theorem kt_dot (g : S2) (z : V4) : kt g ⬝ᵥ z = dotS (ric z) g := by
  rw [dotProduct_comm]; exact dot_kt z g

theorem sum_mul_dl2 (a : Fin 4) (f : Fin 4 → ℝ) : ∑ l, f l * dl a l = f a := by
  simp only [← ite_eq_dl, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]

theorem dotS_dS (g : S2) : dotS g dS = trS g := by
  simp only [dotS, dS, trS]
  exact Finset.sum_congr rfl fun a _ => sum_mul_dl2 a (fun b => g a b)

theorem tv_smul : tv = (2 : ℝ) • Rl (kt dS) := by funext α; rfl

theorem tv_dot (y : V4) : tv ⬝ᵥ y = 2 * trS (ric (Rl y)) := by
  rw [tv_smul, smul_dotProduct, dot_Rl', kt_dot, dotS_dS, smul_eq_mul]

theorem ric_Rl_kt_piS (g : S2) : ric (Rl (kt (piS g))) = (1 / 2 : ℝ) • piS g :=
  ric_rsym_kt_piS g

theorem Ql_Ql : Ql * Ql = Ql := by
  refine LinearMap.ext fun x => ?_
  show Ql (Ql x) = Ql x
  have h1 : ric ((2 : ℝ) • Rl (kt (piS (ric (Rl x))))) = (2 : ℝ) • ric (Rl (kt (piS (ric (Rl x))))) :=
    ricL.map_smul _ _
  rw [Ql_apply, Ql_apply, map_smul, Rl_Rl, h1, ric_Rl_kt_piS, smul_smul,
    show (2 : ℝ) * (1 / 2) = 1 by norm_num, one_smul, piS_piS]

theorem Rl_Ql : Rl * Ql = Ql := by
  refine LinearMap.ext fun x => ?_
  show Rl (Ql x) = Ql x
  rw [Ql_apply, map_smul, Rl_Rl]

theorem Ql_Rl : Ql * Rl = Ql := by
  refine LinearMap.ext fun x => ?_
  show Ql (Rl x) = Ql x
  rw [Ql_apply, Ql_apply, Rl_Rl]

theorem Ql_tv : Ql tv = 0 := by
  rw [Ql_apply, Rl_tv, ric_tv, piS_smul_dS]
  have : kt 0 = 0 := ktL.map_zero
  rw [this, map_zero, smul_zero]

theorem Ql_eps : Ql epsC = 0 := by
  rw [Ql_apply, Rl_eps, ric_eps]
  have h1 : piS 0 = 0 := piL.map_zero
  have h2 : kt 0 = 0 := ktL.map_zero
  rw [h1, h2, map_zero, smul_zero]

theorem tv_dot_Ql (x : V4) : tv ⬝ᵥ Ql x = 0 := by
  rw [tv_dot, Ql_apply, map_smul, Rl_Rl]
  change 2 * trS (ricL ((2 : ℝ) • Rl (kt (piS (ric (Rl x)))))) = 0
  rw [map_smul]
  change 2 * trS ((2 : ℝ) • ric (Rl (kt (piS (ric (Rl x)))))) = 0
  rw [ric_Rl_kt_piS, smul_smul, trS_smul, trS_piS, mul_zero, mul_zero]

theorem eps_dot_Ql (x : V4) : epsC ⬝ᵥ Ql x = 0 := by
  rw [Ql_apply, dotProduct_smul, ← dot_Rl', Rl_eps, dotProduct_comm, kt_dot, ric_eps]
  simp [dotS]

/-- **The scalar projector** `⟨t, x⟩ t/⟨t, t⟩`. DERIVED: no numeral. -/
def PSl : Module.End ℝ V4 where
  toFun x := ((tv ⬝ᵥ x) / (tv ⬝ᵥ tv)) • tv
  map_add' x y := by simp only [dotProduct_add, add_div, add_smul]
  map_smul' c x := by
    simp only [dotProduct_smul, smul_eq_mul, RingHom.id_apply, smul_smul, mul_div_assoc]

/-- **The pseudoscalar projector** `⟨ε, x⟩ ε/⟨ε, ε⟩`. DERIVED: no numeral. -/
def PEl : Module.End ℝ V4 where
  toFun x := ((epsC ⬝ᵥ x) / (epsC ⬝ᵥ epsC)) • epsC
  map_add' x y := by simp only [dotProduct_add, add_div, add_smul]
  map_smul' c x := by
    simp only [dotProduct_smul, smul_eq_mul, RingHom.id_apply, smul_smul, mul_div_assoc]

theorem PSl_apply (x : V4) : PSl x = ((tv ⬝ᵥ x) / (tv ⬝ᵥ tv)) • tv := rfl
theorem PEl_apply (x : V4) : PEl x = ((epsC ⬝ᵥ x) / (epsC ⬝ᵥ epsC)) • epsC := rfl

theorem eps_dot_tv : epsC ⬝ᵥ tv = 0 := by rw [dotProduct_comm]; exact tv_dot_eps

theorem PS_PS : PSl * PSl = PSl := by
  refine LinearMap.ext fun x => ?_
  show PSl (PSl x) = PSl x
  rw [PSl_apply, PSl_apply, dotProduct_smul, smul_eq_mul, mul_div_assoc,
    div_self nt_pos.ne', mul_one]

theorem PE_PE : PEl * PEl = PEl := by
  refine LinearMap.ext fun x => ?_
  show PEl (PEl x) = PEl x
  rw [PEl_apply, PEl_apply, dotProduct_smul, smul_eq_mul, mul_div_assoc,
    div_self ne_pos.ne', mul_one]

theorem PS_PE : PSl * PEl = 0 := by
  refine LinearMap.ext fun x => ?_
  show PSl (PEl x) = 0
  rw [PSl_apply, PEl_apply, dotProduct_smul, tv_dot_eps]; simp

theorem PE_PS : PEl * PSl = 0 := by
  refine LinearMap.ext fun x => ?_
  show PEl (PSl x) = 0
  rw [PEl_apply, PSl_apply, dotProduct_smul, eps_dot_tv]; simp

theorem Rl_PS : Rl * PSl = PSl := by
  refine LinearMap.ext fun x => ?_
  show Rl (PSl x) = PSl x
  rw [PSl_apply, map_smul, Rl_tv]

theorem PS_Rl : PSl * Rl = PSl := by
  refine LinearMap.ext fun x => ?_
  show PSl (Rl x) = PSl x
  rw [PSl_apply, PSl_apply, ← dot_Rl', Rl_tv]

theorem Rl_PE : Rl * PEl = PEl := by
  refine LinearMap.ext fun x => ?_
  show Rl (PEl x) = PEl x
  rw [PEl_apply, map_smul, Rl_eps]

theorem PE_Rl : PEl * Rl = PEl := by
  refine LinearMap.ext fun x => ?_
  show PEl (Rl x) = PEl x
  rw [PEl_apply, PEl_apply, ← dot_Rl', Rl_eps]

theorem PS_Q : PSl * Ql = 0 := by
  refine LinearMap.ext fun x => ?_
  show PSl (Ql x) = 0
  rw [PSl_apply, tv_dot_Ql]; simp

theorem Q_PS : Ql * PSl = 0 := by
  refine LinearMap.ext fun x => ?_
  show Ql (PSl x) = 0
  rw [PSl_apply, map_smul, Ql_tv, smul_zero]

theorem PE_Q : PEl * Ql = 0 := by
  refine LinearMap.ext fun x => ?_
  show PEl (Ql x) = 0
  rw [PEl_apply, eps_dot_Ql]; simp

theorem Q_PE : Ql * PEl = 0 := by
  refine LinearMap.ext fun x => ?_
  show Ql (PEl x) = 0
  rw [PEl_apply, map_smul, Ql_eps, smul_zero]

/-! ## Equivariance -/

section Equiv

variable (A : Matrix (Fin 4) (Fin 4) ℝ) (hA1 : Aᵀ * A = 1) (hA2 : A * Aᵀ = 1)
include hA1 hA2

omit hA1 hA2 in
theorem Rl_Tl_apply (x : V4) : Rl (Tl A x) = Tl A (Rl x) :=
  congrArg (fun F : Module.End ℝ V4 => F x) (Rl_Tl A)

omit hA2 in
theorem Tl_tv : Tl A tv = tv := by
  rw [tv_smul, map_smul, ← Rl_Tl_apply A, ← kt_sA A hA1, sA_dS A hA1]

omit hA1 in
theorem tv_dot_Tl (x : V4) : tv ⬝ᵥ Tl A x = tv ⬝ᵥ x := by
  rw [tv_dot, tv_dot, Rl_Tl_apply A, ric_Tl A hA2, trS_sA A hA2]

omit hA1 hA2 in
theorem Tl_eps : Tl A epsC = A.det • epsC := by
  funext α
  rw [Tl_apply, Pi.smul_apply, smul_eq_mul, ← epsDet A α]
  exact Finset.sum_congr rfl fun β _ => by rw [tcoef]; ring

omit hA1 hA2 in
theorem eps_dot_Tl (x : V4) : epsC ⬝ᵥ Tl A x = A.det * (epsC ⬝ᵥ x) := by
  simp only [dotProduct, Tl_apply, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun β _ => ?_
  have h := epsDet Aᵀ β
  rw [Matrix.det_transpose] at h
  calc ∑ α, epsC α * (tcoef A α β * x β) = (∑ α, epsC α * ∏ j, Aᵀ (α j) (β j)) * x β := by
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl fun α _ => by simp only [tcoef, Matrix.transpose_apply]; ring
    _ = A.det * (epsC β * x β) := by rw [h]; ring

theorem PS_Tl : PSl * Tl A = Tl A * PSl := by
  refine LinearMap.ext fun x => ?_
  show PSl (Tl A x) = Tl A (PSl x)
  rw [PSl_apply, PSl_apply, map_smul, Tl_tv A hA1, tv_dot_Tl A hA2]

omit hA1 hA2 in
theorem PE_Tl : PEl * Tl A = Tl A * PEl := by
  refine LinearMap.ext fun x => ?_
  show PEl (Tl A x) = Tl A (PEl x)
  rw [PEl_apply, PEl_apply, map_smul, Tl_eps A, eps_dot_Tl A, smul_smul]
  congr 1
  ring

theorem Q_Tl : Ql * Tl A = Tl A * Ql := by
  refine LinearMap.ext fun x => ?_
  show Ql (Tl A x) = Tl A (Ql x)
  rw [Ql_apply, Ql_apply, map_smul, Rl_Tl_apply A, ric_Tl A hA2, piS_sA A hA1 hA2,
    kt_sA A hA1, Rl_Tl_apply A]

end Equiv

/-! ## The four channels -/

/-- The channels: scalar, pseudoscalar, traceless Ricci, Weyl. -/
inductive Chan
  | sc
  | ps
  | ri
  | we
  deriving DecidableEq, Fintype

/-- **The Weyl projector** `Rl − P_sc − P_ps − P_ri`. DERIVED: no numeral. -/
def Pw : Module.End ℝ V4 := Rl - PSl - PEl - Ql

/-- The channel projectors. DERIVED: no numeral. -/
def P : Chan → Module.End ℝ V4
  | .sc => PSl
  | .ps => PEl
  | .ri => Ql
  | .we => Pw

theorem P_mul (c d : Chan) : P c * P d = if c = d then P c else 0 := by
  cases c <;> cases d <;>
    simp [P, Pw, mul_sub, sub_mul, Rl_idem, PS_PS, PE_PE, PS_PE, PE_PS, Rl_PS, PS_Rl, Rl_PE,
      PE_Rl, Rl_Ql, Ql_Rl, Ql_Ql, PS_Q, Q_PS, PE_Q, Q_PE]

theorem Rl_P (c : Chan) : Rl * P c = P c := by
  cases c <;> simp [P, Pw, mul_sub, Rl_idem, Rl_PS, Rl_PE, Rl_Ql]

theorem P_Tl (A : Matrix (Fin 4) (Fin 4) ℝ) (hA1 : Aᵀ * A = 1) (hA2 : A * Aᵀ = 1) (c : Chan) :
    P c * Tl A = Tl A * P c := by
  cases c
  · exact PS_Tl A hA1 hA2
  · exact PE_Tl A
  · exact Q_Tl A hA1 hA2
  · simp only [P, Pw, sub_mul, mul_sub, Rl_Tl, PS_Tl A hA1 hA2, PE_Tl A, Q_Tl A hA1 hA2]

theorem P_tv (c : Chan) : P c tv = if c = .sc then tv else 0 := by
  cases c
  · show PSl tv = tv
    rw [PSl_apply, div_self nt_pos.ne', one_smul]
  · show PEl tv = 0
    rw [PEl_apply, eps_dot_tv]; simp
  · exact Ql_tv
  · show Rl tv - PSl tv - PEl tv - Ql tv = 0
    rw [Rl_tv, PSl_apply, div_self nt_pos.ne', one_smul, PEl_apply, eps_dot_tv, Ql_tv]; simp

theorem eps_dot_P (c : Chan) (x : V4) :
    epsC ⬝ᵥ P c x = if c = .ps then epsC ⬝ᵥ x else 0 := by
  cases c
  · show epsC ⬝ᵥ PSl x = 0
    rw [PSl_apply, dotProduct_smul, eps_dot_tv]; simp
  · show epsC ⬝ᵥ PEl x = epsC ⬝ᵥ x
    rw [PEl_apply, dotProduct_smul, smul_eq_mul, div_mul_cancel₀ _ ne_pos.ne']
  · exact eps_dot_Ql x
  · show epsC ⬝ᵥ (Rl x - PSl x - PEl x - Ql x) = 0
    rw [dotProduct_sub, dotProduct_sub, dotProduct_sub, ← dot_Rl', Rl_eps, PSl_apply, PEl_apply,
      dotProduct_smul, dotProduct_smul, eps_dot_tv, eps_dot_Ql]
    simp only [smul_eq_mul, mul_zero]
    rw [div_mul_cancel₀ _ ne_pos.ne']
    ring

theorem tv_dot_P (c : Chan) (x : V4) :
    tv ⬝ᵥ P c x = if c = .sc then tv ⬝ᵥ x else 0 := by
  cases c
  · show tv ⬝ᵥ PSl x = tv ⬝ᵥ x
    rw [PSl_apply, dotProduct_smul, smul_eq_mul, div_mul_cancel₀ _ nt_pos.ne']
  · show tv ⬝ᵥ PEl x = 0
    rw [PEl_apply, dotProduct_smul, tv_dot_eps]; simp
  · exact tv_dot_Ql x
  · show tv ⬝ᵥ (Rl x - PSl x - PEl x - Ql x) = 0
    rw [dotProduct_sub, dotProduct_sub, dotProduct_sub, ← dot_Rl', Rl_tv, PSl_apply,
      dotProduct_smul, smul_eq_mul, div_mul_cancel₀ _ nt_pos.ne', PEl_apply, dotProduct_smul,
      tv_dot_eps, tv_dot_Ql]
    simp

theorem trC_dot_P (c : Chan) (hc : c ≠ .sc) (x : V4) : trC ⬝ᵥ P c x = 0 := by
  have e : P c x = Rl (P c x) := (congrArg (fun F : Module.End ℝ V4 => F x) (Rl_P c)).symm
  rw [e, ← dot_Rl']
  change rsym trC ⬝ᵥ P c x = 0
  rw [rsym_trC, smul_dotProduct, tv_dot_P, if_neg hc, smul_zero]

/-! ## Matrices -/

/-- The matrix of the channel projector `P c`. DERIVED: no numeral. -/
irreducible_def Pm (c : Chan) : Matrix Idx4 Idx4 ℝ := LinearMap.toMatrix' (P c)

theorem Pm_mul (c d : Chan) : Pm c * Pm d = if c = d then Pm c else 0 := by
  rw [Pm_def, Pm_def, ← LinearMap.toMatrix'_mul, P_mul]
  split_ifs <;> simp

theorem Pm_Tm (A : Matrix (Fin 4) (Fin 4) ℝ) (hA1 : Aᵀ * A = 1) (hA2 : A * Aᵀ = 1) (c : Chan) :
    Pm c * Tm A = Tm A * Pm c := by
  have e : Tm A = LinearMap.toMatrix' (Tl A) := (LinearMap.toMatrix'_toLin' _).symm
  rw [e, Pm_def, ← LinearMap.toMatrix'_mul, ← LinearMap.toMatrix'_mul, P_Tl A hA1 hA2]

theorem Pm_mulVec (c : Chan) (x : V4) : Pm c *ᵥ x = P c x := by
  rw [Pm_def]; exact LinearMap.toMatrix'_mulVec _ _

theorem Pm_apply (c : Chan) (α γ : Idx4) : Pm c α γ = P c (Pi.single γ 1) α := by
  rw [Pm_def]; exact LinearMap.toMatrix'_apply _ _ _

theorem vec_Pm (v : V4) (c : Chan) (γ : Idx4) :
    ∑ α, v α * Pm c α γ = v ⬝ᵥ P c (Pi.single γ 1) := by
  simp only [Pm_apply, dotProduct]

theorem Pm_rsym (c : Chan) (α γ : Idx4) : Pm c α γ = rsym (P c (Pi.single γ 1)) α := by
  rw [Pm_apply]
  exact (congrFun (congrArg (fun F : Module.End ℝ V4 => F (Pi.single γ 1)) (Rl_P c)) α).symm

/-! ## The data: basis, mixing, per-field factor, bare fields -/

section Data

open MassGap.InfiniteLattice MassGap.ContinuumField MassGap.ContinuumSchwinger
  MassGap.ContinuumFlow MassGap.ObserverSymField MassGap.ClayWiring MassGap.CompositesBuild Filter
open scoped Topology

variable {N : ℕ}

/-- The observer's field `sym (plaqField q0)`. DERIVED: no numeral. -/
irreducible_def obs (N : ℕ) : LField (MassGap.SUN.SU N) :=
  sym (ObserverEnergyMoments.plaqField ObserverEnergyMoments.q0)

/-- The unit configuration. DERIVED: `1` the unit of `SU(N)`. -/
def u1 (N : ℕ) : Cfg N := fun _ => (1 : MassGap.SUN.SU N)

/-- The channel index. DERIVED: `0`–`3` the four channels. -/
def cidx : Chan → ℕ
  | .sc => 0
  | .ps => 1
  | .ri => 2
  | .we => 3

theorem cidx_inj : Function.Injective cidx := by
  intro a b h; cases a <;> cases b <;> simp_all [cidx]

/-- The value of a channel's basis fields at the unit configuration: `obs(1) + 1 + cidx c`.

DERIVED: `1` the offset keeping the value off `obs(1)`. -/
irreducible_def vtag (N : ℕ) (c : Chan) : ℝ := (obs N).1 (u1 N) + 1 + (cidx c : ℝ)

theorem vtag_inj (N : ℕ) {c d : Chan} (h : vtag N c = vtag N d) : c = d := by
  rw [vtag_def, vtag_def] at h
  exact cidx_inj (by exact_mod_cast (by linarith : (cidx c : ℝ) = cidx d))

theorem vtag_ne (N : ℕ) (c : Chan) : vtag N c ≠ (obs N).1 (u1 N) := by
  rw [vtag_def]
  have : (0 : ℝ) ≤ cidx c := Nat.cast_nonneg _
  linarith

/-- The channel-`c` component `∑_δ (P_c)_{γδ} f_δ` of the tensor fields `f`.

DERIVED: no numeral. -/
irreducible_def Fv (f : Idx4 → LField (MassGap.SUN.SU N)) (c : Chan) (γ : Idx4) :
    LField (MassGap.SUN.SU N) :=
  ⟨∑ δ, Pm c γ δ • (f δ).1, Submodule.sum_mem _ fun δ _ => Submodule.smul_mem _ _ (mem_lfSub (f δ))⟩

theorem Fv_val (f : Idx4 → LField (MassGap.SUN.SU N)) (c : Chan) (γ : Idx4) :
    (Fv f c γ).1 = ∑ δ, Pm c γ δ • (f δ).1 := by
  rw [Fv_def]

/-- The constant shift taking `Fv f c γ` to the value `vtag N c` at the unit configuration.

DERIVED: no numeral. -/
irreducible_def sT (f : Idx4 → LField (MassGap.SUN.SU N)) (c : Chan) (γ : Idx4) : ℝ :=
  (Fv f c γ).1 (u1 N) - vtag N c

/-- **The basis field of channel `c`, component `γ`**: `Fv f c γ − sT · 1`.

DERIVED: no numeral. -/
irreducible_def opT (f : Idx4 → LField (MassGap.SUN.SU N)) (c : Chan) (γ : Idx4) :
    LField (MassGap.SUN.SU N) :=
  (Fv f c γ).sub (sT f c γ)

theorem opT_val (f : Idx4 → LField (MassGap.SUN.SU N)) (c : Chan) (γ : Idx4) :
    (opT f c γ).1 = (Fv f c γ).1 - sT f c γ • (1 : C(Cfg N, ℝ)) := by
  rw [opT_def]; rfl

theorem opT_u (f : Idx4 → LField (MassGap.SUN.SU N)) (c : Chan) (γ : Idx4) :
    (opT f c γ).1 (u1 N) = vtag N c := by
  rw [opT_val, sT_def]
  simp

theorem opT_ne (f : Idx4 → LField (MassGap.SUN.SU N)) (c : Chan) (γ : Idx4) :
    opT f c γ ≠ obs N := fun h => vtag_ne N c (by rw [← opT_u f c γ, h])

/-- The basis index: `none` the observer's field, `some (c, γ)` a channel field. -/
abbrev BD : Type := Option (Chan × Idx4)

/-- **The basis**: `obs` at `none`, `opT f c γ` at `some (c, γ)`. DERIVED: no numeral. -/
def opD (f : Idx4 → LField (MassGap.SUN.SU N)) : BD → LField (MassGap.SUN.SU N)
  | none => obs N
  | some p => opT f p.1 p.2

theorem opD_none (f : Idx4 → LField (MassGap.SUN.SU N)) : opD f none = obs N := rfl

theorem opD_some (f : Idx4 → LField (MassGap.SUN.SU N)) (c : Chan) (γ : Idx4) :
    opD f (some (c, γ)) = opT f c γ := rfl

/-- The scalar weight `N/(8 ⟨t, t⟩)`.

DERIVED: `8` the bare normalisation of `ScalarTie`. -/
irreducible_def wD (N : ℕ) : ℝ := N / (8 * (tv ⬝ᵥ tv))

/-- **The constant coefficients**: `w t_α` on the observer's field; `(P_c)_{αγ}` on the channel
fields of the channels other than the scalar one; `0` on the scalar channel fields.

DERIVED: `0` the scalar channel's fields. -/
def mD (N : ℕ) (α : Idx4) : BD → ℝ
  | none => wD N * tv α
  | some p => if p.1 = .sc then 0 else Pm p.1 α p.2

theorem mD_none (N : ℕ) (α : Idx4) : mD N α none = wD N * tv α := rfl

theorem mD_some (N : ℕ) (α : Idx4) (c : Chan) (γ : Idx4) :
    mD N α (some (c, γ)) = if c = .sc then 0 else Pm c α γ := rfl

open Classical in
/-- **The per-field factor**: `z_sc k` on the observer's field; `z_c k` on a field with value
`vtag N c` at the unit configuration; `0` elsewhere.

DERIVED: `0` off the basis. -/
def ZD (z : Chan → ℕ → ℝ) (k : ℕ) (O : LField (MassGap.SUN.SU N)) : ℝ :=
  if O = obs N then z .sc k else ∑ c, if O.1 (u1 N) = vtag N c then z c k else 0

theorem ZD_obs (z : Chan → ℕ → ℝ) (k : ℕ) : ZD z k (obs N) = z .sc k := by
  simp [ZD]

/-- **The factor reads the channel**: `ZD z k (opT f c γ) = z_c k`. DERIVED: no numeral. -/
theorem ZD_opT (z : Chan → ℕ → ℝ) (k : ℕ) (f : Idx4 → LField (MassGap.SUN.SU N)) (c : Chan)
    (γ : Idx4) : ZD z k (opT f c γ) = z c k := by
  rw [ZD, if_neg (opT_ne f c γ), opT_u, Finset.sum_eq_single c]
  · simp
  · intro d _ hd
    rw [if_neg fun h => hd (vtag_inj N h).symm]
  · intro h; exact absurd (Finset.mem_univ c) h

/-- **The mixing** `mixOfZ BD (opD f) (mD N) (ZD z)`. DERIVED: no numeral. -/
def rhoD (f : Idx4 → LField (MassGap.SUN.SU N)) (z : Chan → ℕ → ℝ) : RenormMix N :=
  mixOfZ BD (opD f) (mD N) (ZD z)

/-- **The bare tensor field** `w t_α obs + ∑_{c ≠ sc} Fv f c α`. DERIVED: no numeral. -/
irreducible_def bareT (f : Idx4 → LField (MassGap.SUN.SU N)) (α : Idx4) :
    LField (MassGap.SUN.SU N) :=
  ⟨(wD N * tv α) • (obs N).1 + ∑ c, (if c = .sc then 0 else (Fv f c α).1),
    Submodule.add_mem _ (Submodule.smul_mem _ _ (mem_lfSub _))
      (Submodule.sum_mem _ fun c _ => by
        split_ifs
        · exact Submodule.zero_mem _
        · exact mem_lfSub _)⟩

theorem bareT_val (f : Idx4 → LField (MassGap.SUN.SU N)) (α : Idx4) :
    (bareT f α).1 = (wD N * tv α) • (obs N).1 + ∑ c, (if c = .sc then 0 else (Fv f c α).1) := by
  rw [bareT_def]

/-- **The bare fields**: `bareT f α` at `eI α`, `bareO i` at the other monomials.

DERIVED: no numeral. -/
def bareD (f : Idx4 → LField (MassGap.SUN.SU N)) (bareO : Ix0 → LField (MassGap.SUN.SU N)) :
    Ix0 → LField (MassGap.SUN.SU N) := fun i =>
  match dec i.1 with
  | some α => bareT f α
  | none => bareO i

theorem bareD_eI (f : Idx4 → LField (MassGap.SUN.SU N)) (bareO : Ix0 → LField (MassGap.SUN.SU N))
    (α : Idx4) : bareD f bareO (eI α) = bareT f α := by
  show (match dec (emono α) with
    | some α => bareT f α
    | none => bareO (eI α)) = _
  rw [dec_emono]

/-- **The channel matrix** `Zc k = ∑_c z_c k P_c`. DERIVED: no numeral. -/
def Zc (z : Chan → ℕ → ℝ) (k : ℕ) : Idx4 → Idx4 → ℝ := fun α β => ∑ c, z c k * Pm c α β

/-! ## The mixing as a combination of the observer's field and the channel fields -/

/-- `∑_b (M_{βb} ζ) op b` for a channel weight `ζ`. DERIVED: no numeral. -/
def Ecomb (f : Idx4 → LField (MassGap.SUN.SU N)) (ζ : Chan → ℝ) (β : Idx4) : C(Cfg N, ℝ) :=
  (wD N * tv β * ζ .sc) • (obs N).1
    + ∑ c, ∑ γ, ((if c = .sc then 0 else Pm c β γ) * ζ c) • (opT f c γ).1

theorem sum_BD {M : Type*} [AddCommMonoid M] (F : BD → M) :
    ∑ b, F b = F none + ∑ c, ∑ γ, F (some (c, γ)) := by
  rw [Fintype.sum_option, Fintype.sum_prod_type]

theorem mixF_mixOfZ {B : Type} [Fintype B] (op : B → LField (MassGap.SUN.SU N))
    (m : Idx4 → B → ℝ) (Z : ℕ → LField (MassGap.SUN.SU N) → ℝ) (k : ℕ) (β : Idx4) :
    (mixF (mixOfZ B op m Z) k β).1 = ∑ b, (m β b * Z k (op b)) • (op b).1 := rfl

theorem mixF_rhoD (f : Idx4 → LField (MassGap.SUN.SU N)) (z : Chan → ℕ → ℝ) (k : ℕ) (β : Idx4) :
    (mixF (rhoD f z) k β).1 = Ecomb f (fun c => z c k) β := by
  rw [rhoD, mixF_mixOfZ, sum_BD]
  simp only [mD_none, mD_some, opD_none, opD_some, ZD_obs, ZD_opT, Ecomb]

theorem sum_mD (f : Idx4 → LField (MassGap.SUN.SU N)) (β : Idx4) :
    ∑ b, mD N β b • (opD f b).1 = Ecomb f (fun _ => 1) β := by
  rw [sum_BD]
  simp only [mD_none, mD_some, opD_none, opD_some, Ecomb, mul_one]

theorem rsum_swap (v : Idx4 → ℝ) (K : Idx4 → Chan → Idx4 → ℝ) (X : Chan → Idx4 → ℝ) :
    ∑ β, v β * ∑ c, ∑ γ, K β c γ * X c γ = ∑ c, ∑ γ, (∑ β, v β * K β c γ) * X c γ := by
  simp only [Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun γ _ => Finset.sum_congr rfl fun β _ => by ring

theorem Ecomb_apply (f : Idx4 → LField (MassGap.SUN.SU N)) (ζ : Chan → ℝ) (β : Idx4) (U : Cfg N) :
    Ecomb f ζ β U = wD N * tv β * ζ .sc * (obs N).1 U
      + ∑ c, ∑ γ, ((if c = .sc then 0 else Pm c β γ) * ζ c) * (opT f c γ).1 U := by
  simp only [Ecomb, ContinuousMap.add_apply, ContinuousMap.smul_apply, smul_eq_mul,
    ContinuousMap.coe_sum, Finset.sum_apply]

theorem Ecomb_tv (f : Idx4 → LField (MassGap.SUN.SU N)) (ζ : Chan → ℝ) :
    ∑ β, tv β • Ecomb f ζ β = (wD N * ζ .sc * (tv ⬝ᵥ tv)) • (obs N).1 := by
  ext U
  simp only [ContinuousMap.coe_sum, Finset.sum_apply, ContinuousMap.smul_apply, smul_eq_mul,
    Ecomb_apply, mul_add, Finset.sum_add_distrib]
  rw [rsum_swap]
  have h0 : ∀ c γ, ∑ β, tv β * ((if c = .sc then 0 else Pm c β γ) * ζ c) = 0 := by
    intro c γ
    by_cases hc : c = .sc
    · simp [hc]
    · simp only [hc, if_false]
      have := vec_Pm tv c γ
      rw [tv_dot_P, if_neg hc] at this
      calc ∑ β, tv β * (Pm c β γ * ζ c) = (∑ β, tv β * Pm c β γ) * ζ c := by
            rw [Finset.sum_mul]; exact Finset.sum_congr rfl fun _ _ => by ring
        _ = 0 := by rw [this, zero_mul]
  simp only [h0, zero_mul, Finset.sum_const_zero, add_zero]
  simp only [dotProduct, Finset.mul_sum, Finset.sum_mul]
  exact Finset.sum_congr rfl fun _ _ => by ring

theorem Pm_comp {M : Type*} [AddCommMonoid M] [Module ℝ M] (c d : Chan) (α : Idx4)
    (Φ : Idx4 → M) :
    ∑ γ, Pm c α γ • ∑ δ, Pm d γ δ • Φ δ = ∑ δ, (Pm c * Pm d) α δ • Φ δ := by
  simp only [Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun δ _ => ?_
  rw [← Finset.sum_smul]
  rfl

theorem sum_Pm_opT (f : Idx4 → LField (MassGap.SUN.SU N)) (c : Chan) (α : Idx4) :
    ∑ γ, Pm c α γ • (opT f c γ).1
      = (Fv f c α).1 - (∑ γ, Pm c α γ * sT f c γ) • (1 : C(Cfg N, ℝ)) := by
  simp only [opT_val, smul_sub, Finset.sum_sub_distrib, smul_smul, ← Finset.sum_smul]
  congr 1
  simp only [Fv_val]
  rw [Pm_comp, Pm_mul, if_pos rfl]

theorem Ecomb_Pm (f : Idx4 → LField (MassGap.SUN.SU N)) (ζ : Chan → ℝ) (c₀ : Chan) (hc₀ : c₀ ≠ .sc)
    (α : Idx4) :
    ∑ β, Pm c₀ α β • Ecomb f ζ β = ζ c₀ • ∑ γ, Pm c₀ α γ • (opT f c₀ γ).1 := by
  ext U
  simp only [ContinuousMap.coe_sum, Finset.sum_apply, ContinuousMap.smul_apply, smul_eq_mul,
    Ecomb_apply, mul_add, Finset.sum_add_distrib]
  rw [rsum_swap]
  have hobs : ∑ β, Pm c₀ α β * (wD N * tv β * ζ .sc * (obs N).1 U) = 0 := by
    have h := congrFun (Pm_mulVec c₀ tv) α
    rw [P_tv, if_neg hc₀] at h
    have : ∑ β, Pm c₀ α β * (wD N * tv β * ζ .sc * (obs N).1 U)
        = (wD N * ζ .sc * (obs N).1 U) * (Pm c₀ *ᵥ tv) α := by
      simp only [Matrix.mulVec, dotProduct, Finset.mul_sum]
      exact Finset.sum_congr rfl fun _ _ => by ring
    rw [this, h]; simp
  have hcoef : ∀ c γ, ∑ β, Pm c₀ α β * ((if c = .sc then 0 else Pm c β γ) * ζ c)
      = if c = c₀ then ζ c₀ * Pm c₀ α γ else 0 := by
    intro c γ
    by_cases hc : c = .sc
    · have : c ≠ c₀ := fun h => hc₀ (h ▸ hc)
      rw [if_neg this]
      simp [hc]
    · simp only [hc, if_false]
      have hm := congrFun (congrFun (Pm_mul c₀ c) α) γ
      have e : ∑ β, Pm c₀ α β * (Pm c β γ * ζ c) = ζ c * (Pm c₀ * Pm c) α γ := by
        simp only [Matrix.mul_apply, Finset.mul_sum]
        exact Finset.sum_congr rfl fun _ _ => by ring
      rw [e, hm]
      by_cases h : c = c₀
      · subst h; simp
      · simp [h, Ne.symm h]
  rw [hobs, zero_add]
  simp only [hcoef]
  simp only [ite_mul, zero_mul]
  rw [Finset.sum_eq_single c₀]
  · simp only [Finset.mul_sum]
    exact Finset.sum_congr rfl fun _ _ => by rw [if_pos trivial]; ring
  · intro d _ hd
    exact Finset.sum_eq_zero fun γ _ => if_neg hd
  · intro h; exact absurd (Finset.mem_univ _) h

theorem Ecomb_one (f : Idx4 → LField (MassGap.SUN.SU N)) (β : Idx4) :
    Ecomb f (fun _ => 1) β = (bareT f β).1
      - (∑ c, if c = .sc then 0 else ∑ γ, Pm c β γ * sT f c γ) • (1 : C(Cfg N, ℝ)) := by
  have e : ∀ c, ∑ γ, (if c = .sc then 0 else Pm c β γ) • (opT f c γ).1
      = (if c = .sc then 0 else (Fv f c β).1)
        - (if c = .sc then 0 else ∑ γ, Pm c β γ * sT f c γ) • (1 : C(Cfg N, ℝ)) := by
    intro c
    by_cases hc : c = .sc
    · simp [hc]
    · simp only [hc, if_false]
      exact sum_Pm_opT f c β
  simp only [Ecomb, mul_one]
  simp only [e, Finset.sum_sub_distrib, ← Finset.sum_smul]
  rw [bareT_val]
  abel

/-! ## Spans -/

/-- **The observer's field and the channel fields from the mixing components**: a subspace holding
`1` and every `Ecomb f ζ β`, with `ζ` non-vanishing, holds `obs` and `Fv f c γ` for `c ≠ sc`.

DERIVED: `0` the excluded colour count and the non-vanishing of `ζ`; `1` the unit field. -/
theorem mem_of_Ecomb (hN : N ≠ 0) (f : Idx4 → LField (MassGap.SUN.SU N))
    (Sp : Submodule ℝ C(Cfg N, ℝ)) (h1 : (1 : C(Cfg N, ℝ)) ∈ Sp) (ζ : Chan → ℝ)
    (hζ : ∀ c, ζ c ≠ 0) (hE : ∀ β, Ecomb f ζ β ∈ Sp) :
    (obs N).1 ∈ Sp ∧ ∀ c, c ≠ .sc → ∀ γ, (Fv f c γ).1 ∈ Sp := by
  have hw : wD N ≠ 0 := by
    rw [wD_def]
    exact div_ne_zero (Nat.cast_ne_zero.2 hN) (mul_ne_zero (by norm_num) nt_pos.ne')
  refine ⟨?_, fun c hc γ => ?_⟩
  · have h := Ecomb_tv f ζ
    have hm : ∑ β, tv β • Ecomb f ζ β ∈ Sp :=
      Submodule.sum_mem _ fun β _ => Submodule.smul_mem _ _ (hE β)
    rw [h] at hm
    have hc : wD N * ζ .sc * (tv ⬝ᵥ tv) ≠ 0 := mul_ne_zero (mul_ne_zero hw (hζ _)) nt_pos.ne'
    have := Submodule.smul_mem Sp (wD N * ζ .sc * (tv ⬝ᵥ tv))⁻¹ hm
    rwa [smul_smul, inv_mul_cancel₀ hc, one_smul] at this
  · have hm : ∑ β, Pm c γ β • Ecomb f ζ β ∈ Sp :=
      Submodule.sum_mem _ fun β _ => Submodule.smul_mem _ _ (hE β)
    rw [Ecomb_Pm f ζ c hc γ, sum_Pm_opT] at hm
    have h2 := Submodule.smul_mem Sp (ζ c)⁻¹ hm
    rw [smul_smul, inv_mul_cancel₀ (hζ c), one_smul] at h2
    have h3 := Sp.add_mem h2 (Sp.smul_mem (∑ γ', Pm c γ γ' * sT f c γ') h1)
    rwa [sub_add_cancel] at h3

theorem Ecomb_mem (f : Idx4 → LField (MassGap.SUN.SU N)) (Sp : Submodule ℝ C(Cfg N, ℝ))
    (h1 : (1 : C(Cfg N, ℝ)) ∈ Sp) (hobs : (obs N).1 ∈ Sp)
    (hF : ∀ c, c ≠ .sc → ∀ γ, (Fv f c γ).1 ∈ Sp) (ζ : Chan → ℝ) (β : Idx4) :
    Ecomb f ζ β ∈ Sp := by
  refine Sp.add_mem (Sp.smul_mem _ hobs) (Sp.sum_mem fun c _ => Sp.sum_mem fun γ _ => ?_)
  by_cases hc : c = .sc
  · simp [hc, Sp.zero_mem]
  · refine Sp.smul_mem _ ?_
    rw [opT_val]
    exact Sp.sub_mem (hF c hc γ) (Sp.smul_mem _ h1)

theorem bareT_mem (f : Idx4 → LField (MassGap.SUN.SU N)) (Sp : Submodule ℝ C(Cfg N, ℝ))
    (hobs : (obs N).1 ∈ Sp) (hF : ∀ c, c ≠ .sc → ∀ γ, (Fv f c γ).1 ∈ Sp) (β : Idx4) :
    (bareT f β).1 ∈ Sp := by
  rw [bareT_val]
  refine Sp.add_mem (Sp.smul_mem _ hobs) (Sp.sum_mem fun c _ => ?_)
  by_cases hc : c = .sc
  · simp [hc, Sp.zero_mem]
  · simp only [hc, if_false]; exact hF c hc β

/-- **`RenTensor` at the data**, given non-vanishing channel factors.

DERIVED: `0` the excluded colour count and the non-vanishing of the factors; `4` the dimension of
`tr F F`. -/
theorem renTensor_D (hN : N ≠ 0) (f : Idx4 → LField (MassGap.SUN.SU N))
    (bareO : Ix0 → LField (MassGap.SUN.SU N)) (z : Chan → ℕ → ℝ) (hz : ∀ c k, z c k ≠ 0) :
    RenTensor (rhoD f z) (bareD f bareO) := by
  intro k α
  constructor
  · set Sp := bareSpan (bareD f bareO) 4
    have h1 : (1 : C(Cfg N, ℝ)) ∈ Sp := Submodule.subset_span (Set.mem_insert _ _)
    have hb : ∀ β, (bareT f β).1 ∈ Sp := fun β => by
      rw [← bareD_eI f bareO β]
      exact Submodule.subset_span
        (Set.mem_insert_of_mem _ ⟨⟨eI β, le_of_eq (cdim_emono β)⟩, rfl⟩)
    have hE : ∀ β, Ecomb f (fun _ => 1) β ∈ Sp := fun β => by
      rw [Ecomb_one]; exact Sp.sub_mem (hb β) (Sp.smul_mem _ h1)
    obtain ⟨hobs, hF⟩ := mem_of_Ecomb hN f Sp h1 _ (fun _ => one_ne_zero) hE
    rw [mixF_rhoD]
    exact Ecomb_mem f Sp h1 hobs hF _ α
  · set Sp := mixSpan (rhoD f z) (bareD f bareO) k
    have h1 : (1 : C(Cfg N, ℝ)) ∈ Sp := Submodule.subset_span (Set.mem_insert _ _)
    have hE : ∀ β, Ecomb f (fun c => z c k) β ∈ Sp := fun β => by
      rw [← mixF_rhoD]
      exact Submodule.subset_span (Set.mem_insert_of_mem _ (Or.inl ⟨β, rfl⟩))
    obtain ⟨hobs, hF⟩ := mem_of_Ecomb hN f Sp h1 _ (fun c => hz c k) hE
    rw [bareD_eI]
    exact bareT_mem f Sp hobs hF α

/-! ## The Riemann symmetries and the trace -/

theorem tv_swap01 (α : Idx4) : tv (swap01 α) = -tv α := by
  simp only [tv, rsym_swap01]; ring
theorem tv_swap23 (α : Idx4) : tv (swap23 α) = -tv α := by
  simp only [tv, rsym_swap23]; ring
theorem tv_pairEx (α : Idx4) : tv (pairEx α) = tv α := by
  simp only [tv, rsym_pairEx]

/-- **The Riemann symmetries of the coefficients**: `t` and every column of `Pm c` lie in the image
of the symmetriser. DERIVED: no numeral. -/
theorem coefRiemann_mD (N : ℕ) : CoefRiemann (mD N) := by
  intro α b
  cases b with
  | none =>
    refine ⟨?_, ?_, ?_⟩ <;> simp [mD_none, tv_swap01, tv_swap23, tv_pairEx]
  | some p =>
    obtain ⟨c, γ⟩ := p
    by_cases hc : c = .sc
    · simp [mD_some, hc]
    · refine ⟨?_, ?_, ?_⟩ <;> simp [mD_some, hc, Pm_rsym, rsym_swap01, rsym_swap23, rsym_pairEx]

/-- **The trace coefficients**: `N/16` on the observer's field, `0` on every channel field.

DERIVED: `16 = 8 · 2` from `w = N/(8⟨t, t⟩)` and `⟨trC, t⟩ = ⟨t, t⟩/2`; `0` the excluded colour
count and the other coefficients. -/
theorem coefC_mD (N : ℕ) (hN : N ≠ 0) (b : BD) :
    coefC (mD N) trC b = if b = none then (N : ℝ) / 16 else 0 := by
  cases b with
  | none =>
    simp only [coefC, mD_none, if_true]
    have e : ∑ α, trC α * (wD N * tv α) = wD N * (trC ⬝ᵥ tv) := by
      simp only [dotProduct, Finset.mul_sum]
      exact Finset.sum_congr rfl fun _ _ => by ring
    have htr : trC ⬝ᵥ tv = (1 / 2 : ℝ) * (tv ⬝ᵥ tv) := by
      calc trC ⬝ᵥ tv = trC ⬝ᵥ Rl tv := by rw [Rl_tv]
        _ = Rl trC ⬝ᵥ tv := dot_Rl tv trC
        _ = (1 / 2 : ℝ) * (tv ⬝ᵥ tv) := by
          change rsym trC ⬝ᵥ tv = _
          rw [rsym_trC, smul_dotProduct, smul_eq_mul]
    rw [e, htr, wD_def]
    field_simp [nt_pos.ne']
    ring
  | some p =>
    obtain ⟨c, γ⟩ := p
    simp only [reduceCtorEq, if_false]
    by_cases hc : c = .sc
    · simp [coefC, mD_some, hc]
    · simp only [coefC, mD_some, hc, if_false]
      rw [vec_Pm, trC_dot_P c hc]

/-! ## The channel tie -/

theorem Zc_mat (z : Chan → ℕ → ℝ) (k : ℕ) :
    (Matrix.of (Zc z k) : Matrix Idx4 Idx4 ℝ) = ∑ c, z c k • Pm c := by
  ext α β
  simp [Zc, Matrix.sum_apply]

theorem zAct_eq (Z : Idx4 → Idx4 → ℝ) (v : Idx4 → ℝ) :
    zAct Z v = Matrix.vecMul v (Matrix.of Z) := by
  funext β; simp [zAct, Matrix.vecMul, dotProduct]

theorem rotC_eq (A : Matrix (Fin 4) (Fin 4) ℝ) (v : Idx4 → ℝ) :
    rotC A v = Matrix.vecMul v (Tm A) := by
  funext β; simp [rotC, Matrix.vecMul, dotProduct, Tm]

/-- **The channel matrix commutes with the tensor action of an orthogonal `A`.**

DERIVED: `4` the dimension; `1` the identity matrix. -/
theorem Zc_Tm (z : Chan → ℕ → ℝ) (k : ℕ) (A : Matrix (Fin 4) (Fin 4) ℝ) (hA1 : Aᵀ * A = 1)
    (hA2 : A * Aᵀ = 1) : Tm A * Matrix.of (Zc z k) = Matrix.of (Zc z k) * Tm A := by
  rw [Zc_mat, Finset.mul_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [Matrix.mul_smul, Matrix.smul_mul, Pm_Tm A hA1 hA2]

/-- **The mixing factors through the channel matrix**: `M k α b = ∑_β (Zc k)_{αβ} (mD N)_{βb}`.

DERIVED: no numeral. -/
theorem M_rhoD (f : Idx4 → LField (MassGap.SUN.SU N)) (z : Chan → ℕ → ℝ) (k : ℕ) (α : Idx4)
    (b : BD) : (rhoD f z).M k α b = ∑ β, Zc z k α β * mD N β b := by
  show mD N α b * ZD z k (opD f b) = _
  cases b with
  | none =>
    simp only [mD_none, opD_none, ZD_obs, Zc]
    have e : ∑ β, (∑ c, z c k * Pm c α β) * (wD N * tv β)
        = wD N * ∑ c, z c k * (Pm c *ᵥ tv) α := by
      simp only [Matrix.mulVec, dotProduct, Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
    rw [e]
    simp only [Pm_mulVec, P_tv]
    rw [Finset.sum_eq_single Chan.sc]
    · simp; ring
    · intro c _ hc; simp [hc]
    · intro h; exact absurd (Finset.mem_univ _) h
  | some p =>
    obtain ⟨c, γ⟩ := p
    simp only [mD_some, opD_some, ZD_opT, Zc]
    by_cases hc : c = .sc
    · simp [hc]
    · simp only [hc, if_false]
      have e : ∑ β, (∑ d, z d k * Pm d α β) * Pm c β γ = ∑ d, z d k * (Pm d * Pm c) α γ := by
        simp only [Matrix.mul_apply, Finset.sum_mul, Finset.mul_sum]
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
      rw [e]
      simp only [Pm_mul]
      rw [Finset.sum_eq_single c]
      · simp; ring
      · intro d _ hd; simp [hd]
      · intro h; exact absurd (Finset.mem_univ _) h

/-- **The pseudoscalar channel**: `(zAct (Zc k) ε)_{id} = z_ps k`. DERIVED: no numeral. -/
theorem zAct_eps (z : Chan → ℕ → ℝ) (k : ℕ) : zAct (Zc z k) epsC id = z .ps k := by
  show ∑ α, epsC α * Zc z k α id = _
  simp only [Zc, Finset.mul_sum]
  rw [Finset.sum_comm]
  have e : ∀ c, ∑ α, epsC α * (z c k * Pm c α id) = z c k * (epsC ⬝ᵥ P c (Pi.single id 1)) := by
    intro c
    rw [← vec_Pm, Finset.mul_sum]
    exact Finset.sum_congr rfl fun _ _ => by ring
  simp only [e, eps_dot_P]
  rw [Finset.sum_eq_single Chan.ps]
  · simp [dotProduct_single, eps_id]
  · intro c _ hc; simp [hc]
  · intro h; exact absurd (Finset.mem_univ _) h

theorem cval_emono (g : ℝ) (A : GPot N) (β : Idx4) : cval g A (emono β) = ffT g A β := by
  simp [cval, emono, wordTr, ffT]

theorem classicalLead_add_const {L L' : Cfg N → ℝ} {d : ℕ} {P : GPot N → ℝ → ℝ} (c : ℝ)
    (h : ∀ U, L' U = L U + c) (hL : ClassicalLead L d P) : ClassicalLead L' d P := by
  intro A hA g U hU
  exact (hL A hA g U hU).congr fun a => by rw [h, h]; ring

/-- **The classical lead of the channel tie from `TiedB`**: `∑_b (mD N)_{βb} op b` is
`bareT f β` plus a constant (`sum_mD`, `Ecomb_one`), and `TiedB` at `eI β` is the lead
`g² ffT g A β` at dimension `4`.

DERIVED: `4` the dimension; `2` the power of the coupling. -/
theorem channelLead_of_tied (f : Idx4 → LField (MassGap.SUN.SU N))
    (bareO : Ix0 → LField (MassGap.SUN.SU N)) (hT : TiedB (bareD f bareO)) (β : Idx4) :
    ClassicalLead (fun U => ∑ b, mD N β b * (opD f b).1 U) 4
      (fun A g => g ^ 2 * ffT g A β) := by
  have h := hT (eI β)
  rw [bareD_eI] at h
  have e1 : cdim (eI β).1 = 4 := cdim_emono β
  have e2 : cnF (eI β).1 = 2 := rfl
  rw [e1, e2] at h
  simp only [show (eI β).1 = emono β from rfl, cval_emono] at h
  refine classicalLead_add_const
    (-(∑ c, if c = .sc then 0 else ∑ γ, Pm c β γ * sT f c γ)) (fun U => ?_) h
  have := congrArg (fun F : C(Cfg N, ℝ) => F U) ((sum_mD f β).trans (Ecomb_one f β))
  simp only [ContinuousMap.coe_sum, Finset.sum_apply, ContinuousMap.smul_apply, smul_eq_mul,
    ContinuousMap.sub_apply, ContinuousMap.one_apply, mul_one] at this
  rw [this]; ring

end Data

/-! ## The connected reading, and `TiedB` from the lead of `obs` -/

section ObsTie

open MassGap.InfiniteLattice MassGap.ContinuumField MassGap.ContinuumSchwinger
  MassGap.ContinuumFlow MassGap.ObserverSymField MassGap.ClayWiring MassGap.CompositesBuild Filter
open scoped Topology

variable {N : ℕ}

/-- **The constant shift drops out of the connected basis field** read by `latT` and `mixLatT`:
at `opT f c γ`, `locField` is `Fv f c γ` minus its expectation in `stateK hN k`.

DERIVED: no numeral. -/
theorem locField_opT (hN : N ≠ 0) (f : Idx4 → LField (MassGap.SUN.SU N)) (z : Chan → ℕ → ℝ)
    (k : ℕ) (c : Chan) (γ : Idx4) (u : TestFn) :
    locField hN (rhoD f z) k (some (c, γ)) u
      = ((Fv f c γ).sub (stateK hN k (Fv f c γ).1), u) := by
  show ((opT f c γ).sub (stateK hN k (opT f c γ).1), u) = _
  refine Prod.ext (Subtype.ext ?_) rfl
  show (opT f c γ).1 - (stateK hN k (opT f c γ).1) • (1 : C(Cfg N, ℝ))
    = (Fv f c γ).1 - (stateK hN k (Fv f c γ).1) • (1 : C(Cfg N, ℝ))
  rw [opT_val, (stateK hN k).map_sub, (stateK hN k).map_smul, (stateK hN k).map_one, mul_one,
    sub_smul]
  abel

/-- The channel projectors off the scalar channel sum to `Rl − P sc`. DERIVED: no numeral. -/
theorem sum_P_nsc (x : V4) :
    ∑ c, (if c = Chan.sc then (0 : V4) else P c x) = Rl x - PSl x := by
  have hu : (Finset.univ : Finset Chan) = {Chan.sc, Chan.ps, Chan.ri, Chan.we} := by decide
  rw [hu]
  simp only [Finset.mem_insert, Finset.mem_singleton, reduceCtorEq, or_self, not_false_eq_true,
    Finset.sum_insert, Finset.sum_singleton, if_true, if_false, zero_add, P, Pw]
  simp only [LinearMap.sub_apply]
  abel

/-- On a tensor with the Riemann symmetries, `⟨trC, x⟩ = ⟨t, x⟩/2`.

DERIVED: `1/2` from `rsym trC = t/2` (`rsym_trC`). -/
theorem trC_dot_Rl (x : V4) (hx : Rl x = x) : trC ⬝ᵥ x = (1 / 2 : ℝ) * (tv ⬝ᵥ x) := by
  calc trC ⬝ᵥ x = trC ⬝ᵥ Rl x := by rw [hx]
    _ = Rl trC ⬝ᵥ x := dot_Rl x trC
    _ = (1 / 2 : ℝ) * (tv ⬝ᵥ x) := by
      change rsym trC ⬝ᵥ x = _
      rw [rsym_trC, smul_dotProduct, smul_eq_mul]

/-- **The algebra of the lead of `bareT`**: on a tensor `x` with the Riemann symmetries, the
coefficient `w t_β` times the `obs` lead `(16/N) ⟨trC, x⟩` plus the channel sum
`∑_{c ≠ sc} (Pm c x)_β` is `x_β`.

DERIVED: `16` the normalisation of `ScalarTie`; `0` the excluded colour count. -/
theorem lead_alg (hN : N ≠ 0) (x : V4) (hx : Rl x = x) (β : Idx4) :
    wD N * tv β * ((16 / (N : ℝ)) * (trC ⬝ᵥ x))
      + ∑ c, ∑ δ, (if c = Chan.sc then 0 else Pm c β δ) * x δ = x β := by
  have e1 : ∀ c, ∑ δ, (if c = Chan.sc then 0 else Pm c β δ) * x δ
      = (if c = Chan.sc then (0 : V4) else P c x) β := by
    intro c
    by_cases hc : c = Chan.sc
    · simp [hc]
    · simp only [hc, if_false]
      rw [← Pm_mulVec]; rfl
  simp only [e1]
  rw [← Finset.sum_apply, sum_P_nsc, Pi.sub_apply, hx, PSl_apply, trC_dot_Rl x hx, wD_def]
  simp only [Pi.smul_apply, smul_eq_mul]
  have hN' : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hN
  have ht : tv ⬝ᵥ tv ≠ 0 := nt_pos.ne'
  field_simp
  ring

/-- The tensor fields `bareF (emono δ)` each lead with `g² ffT g A δ` at dimension `4`
(`ClassicalLimit.classicalLead_ffT`).

DERIVED: `4` the dimension; `2` the power of the coupling. -/
theorem lead_f (δ : Idx4) :
    ClassicalLead (N := N) (ClassicalLimit.bareF (emono δ)).1 4 (fun A g => g ^ 2 * ffT g A δ) :=
  ClassicalLimit.classicalLead_ffT δ

/-- **`TiedB (bareD f bareO)` at `f = bareF ∘ emono`, `bareO = bareF`** from the classical lead of
`obs` and the Riemann symmetries of every `ffT g A`. Off the tensor monomials it is
`ClassicalLimit.tiedB_bareF`; at `eI β` the lead of `bareT f β` is the combination of the leads of
`obs` and of the `bareF (emono δ)` (`ClassicalLimit.classicalLead_sum`), which is `g² ffT g A β`
(`lead_alg`).

DERIVED: `4` the dimension; `2` the power of the coupling; `16` as in `lead_alg`; `0` the excluded
colour count. -/
theorem tiedB_bareD_of_obs
    (hobs : ClassicalLead (obs N).1 4
      (fun A g => (16 / (N : ℝ)) * (g ^ 2 * (trC ⬝ᵥ ffT g A))))
    (hR : ∀ (A : GPot N) (g : ℝ), Rl (ffT g A) = ffT g A) (hN : N ≠ 0) :
    TiedB (bareD (fun δ => ClassicalLimit.bareF (N := N) (emono δ))
      (fun i => ClassicalLimit.bareF i.1)) := by
  intro i
  cases hd : dec i.1 with
  | none =>
    have : bareD (fun δ => ClassicalLimit.bareF (N := N) (emono δ))
        (fun i => ClassicalLimit.bareF i.1) i = ClassicalLimit.bareF i.1 := by
      show (match dec i.1 with | some α => _ | none => _) = _
      rw [hd]
    rw [this]
    exact ClassicalLimit.tiedB_bareF i
  | some β =>
    have hi : i = eI β := eI_of_dec hd
    subst hi
    rw [bareD_eI]
    have e1 : cdim (eI β).1 = 4 := cdim_emono β
    have e2 : cnF (eI β).1 = 2 := rfl
    rw [e1, e2]
    simp only [show (eI β).1 = emono β from rfl, cval_emono]
    let cf : BD → ℝ := fun i => match i with
      | none => wD N * tv β
      | some p => if p.1 = Chan.sc then 0 else Pm p.1 β p.2
    let L : BD → Cfg N → ℝ := fun i => match i with
      | none => (obs N).1
      | some p => (ClassicalLimit.bareF (N := N) (emono p.2)).1
    let Pl : BD → GPot N → ℝ → ℝ := fun i => match i with
      | none => fun A g => (16 / (N : ℝ)) * (g ^ 2 * (trC ⬝ᵥ ffT g A))
      | some p => fun A g => g ^ 2 * ffT g A p.2
    have hall : ∀ i ∈ (Finset.univ : Finset BD), ClassicalLead (L i) 4 (Pl i) := by
      intro i _
      cases i with
      | none => exact hobs
      | some p => exact lead_f p.2
    have hs := ClassicalLimit.classicalLead_sum Finset.univ cf L Pl 4 hall
    have hP : (fun A g => ∑ i ∈ (Finset.univ : Finset BD), cf i * Pl i A g)
        = fun (A : GPot N) (g : ℝ) => g ^ 2 * ffT g A β := by
      funext A g
      rw [sum_BD]
      have := lead_alg hN (ffT g A) (hR A g) β
      simp only [cf, Pl]
      rw [← this]
      simp only [mul_add, Finset.mul_sum]
      congr 1
      · ring
      · exact Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun δ _ => by ring
    rw [hP] at hs
    refine classicalLead_add_const 0 (fun U => ?_) hs
    rw [add_zero, sum_BD]
    simp only [cf, L]
    rw [bareT_val]
    simp only [ContinuousMap.add_apply, ContinuousMap.smul_apply, smul_eq_mul,
      ContinuousMap.coe_sum, Finset.sum_apply]
    congr 1
    refine Finset.sum_congr rfl fun c _ => ?_
    by_cases hc : c = Chan.sc
    · simp [hc]
    · simp only [hc, if_false, Fv_val, ContinuousMap.coe_sum, Finset.sum_apply,
        ContinuousMap.smul_apply, smul_eq_mul]

/-- A tensor fixed by `swap01`, `swap23` up to sign and by `pairEx` is fixed by `Rl`.

DERIVED: no numeral. -/
theorem Rl_fix (x : V4) (h1 : ∀ α, x (swap01 α) = -x α) (h2 : ∀ α, x (swap23 α) = -x α)
    (h3 : ∀ α, x (pairEx α) = x α) : Rl x = x := by
  funext α
  rw [Rl_apply, rsym_eq]
  have q1 : p1 α = swap01 α := rfl
  have q2 : p2 α = swap23 α := rfl
  have q3 : p3 α = swap01 (swap23 α) := by funext i; fin_cases i <;> rfl
  have q4 : p4 α = pairEx α := rfl
  have q5 : p5 α = pairEx (swap01 α) := by funext i; fin_cases i <;> rfl
  have q6 : p6 α = pairEx (swap23 α) := by funext i; fin_cases i <;> rfl
  have q7 : p7 α = pairEx (swap01 (swap23 α)) := by funext i; fin_cases i <;> rfl
  rw [q1, q2, q3, q4, q5, q6, q7, h3, h3, h3, h3, h1, h1, h2]
  ring

/-- `F_{σρ} = −F_{ρσ}`. DERIVED: no numeral. -/
theorem covDF_swap (g : ℝ) (A : GPot N) (ρ σ : Fin 4) (y : Fin 4 → ℝ) :
    covDF g A σ ρ [] y = -covDF g A ρ σ [] y := by
  have hm : mcomm (A y σ) (A y ρ) = -mcomm (A y ρ) (A y σ) := by
    funext i j
    simp [mcomm, Matrix.sub_apply]
  simp only [covDF, hm, smul_neg]
  abel

/-- **`ffT g A` has the Riemann symmetries**: antisymmetric in each pair (`covDF_swap`) and
symmetric under the pair exchange (cyclicity of the trace).

DERIVED: no numeral. -/
theorem ffT_riemann (g : ℝ) (A : GPot N) : Rl (ffT g A) = ffT g A := by
  refine Rl_fix _ (fun α => ?_) (fun α => ?_) (fun α => ?_)
  · simp only [ffT, swap01, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
    rw [covDF_swap g A (α 0) (α 1),
      show ∀ X : Fin N → Fin N → ℂ, Matrix.of (-X) = -Matrix.of X from fun _ => rfl,
      neg_mul, Matrix.trace_neg, Complex.neg_re]
  · simp only [ffT, swap23, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
    rw [covDF_swap g A (α 2) (α 3),
      show ∀ X : Fin N → Fin N → ℂ, Matrix.of (-X) = -Matrix.of X from fun _ => rfl,
      mul_neg, Matrix.trace_neg, Complex.neg_re]
  · simp only [ffT, pairEx, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
    rw [Matrix.trace_mul_comm]

/-- **`TiedB (bareD f bareO)` at `f = bareF ∘ emono`, `bareO = bareF`, from the classical lead of
`obs` alone**: `tiedB_bareD_of_obs` with the Riemann symmetries `ffT_riemann`.

DERIVED: `4` the dimension; `2` the power of the coupling; `16` as in `lead_alg`; `0` the excluded
colour count. -/
theorem tiedB_bareD_of_obs' (hN : N ≠ 0)
    (hobs : ClassicalLead (obs N).1 4
      (fun A g => (16 / (N : ℝ)) * (g ^ 2 * (trC ⬝ᵥ ffT g A)))) :
    TiedB (bareD (fun δ => ClassicalLimit.bareF (N := N) (emono δ))
      (fun i => ClassicalLimit.bareF i.1)) :=
  tiedB_bareD_of_obs hobs (fun A g => ffT_riemann g A) hN

end ObsTie

/-! ## The capstone -/

section Capstone

open MassGap.InfiniteLattice MassGap.ContinuumField MassGap.ContinuumSchwinger
  MassGap.ContinuumFlow MassGap.ContinuumHypercubic MassGap.ObserverOS MassGap.ObserverOSGrowth
  MassGap.ObserverOSSchwartz MassGap.ObserverOSTempered MassGap.ObserverEnergyBox
  MassGap.ObserverOSEuclidS MassGap.ObserverOSReconstructionS MassGap.ObserverOSLinked
  MassGap.ObserverRotation MassGap.ObserverSymField MassGap.ContinuumTimeGroup
  MassGap.ClayFull MassGap.ObserverNontrivial MassGap.ClayStatement MassGap.ClayWiring Filter
  MassGap.PreObserver MassGap.CompositesBuild
open scoped Topology

variable {N : ℕ}

/-- **The physical range at margin `r > 0`** from a vanishing physical reach `aₖ · range k → 0`
(`ObserverAxioms.physRange_all_of_reach`).

DERIVED: `0` the limit and the sign. -/
theorem physD (W : ConfFlow N)
    (hreach : Tendsto (fun k => dySpacing N k * (W.range k : ℝ)) atTop (𝓝 0)) {r : ℝ}
    (hr : 0 < r) : (energy0 W (SymPlaqClass N) (symPlaq_refl N)).PhysRange r :=
  ObserverAxioms.physRange_all_of_reach W (SymPlaqClass N) (symPlaq_refl N) hreach r hr

/-- **The scalar tie at the data** from `z_sc k · a_k⁴ → 2`: the trace coefficient is `N/16` on the
observer's field and `0` on the channel fields (`coefC_mD`).

DERIVED: `0` the excluded colour count; `2`, `16`, `8`, `4` as in `ScalarTie` and `TopNorm`. -/
theorem scalarTie_D (hN : N ≠ 0) (f : Idx4 → LField (MassGap.SUN.SU N)) (z : Chan → ℕ → ℝ)
    (hzS : Tendsto (fun k => z .sc k * dySpacing N k ^ 4) atTop (𝓝 2)) :
    ScalarTie (rhoD f z) (sym (ObserverEnergyMoments.plaqField ObserverEnergyMoments.q0)) := by
  refine scalarTie_mixOfZ (opD f) (mD N) (ZD z) none ((N : ℝ) / 16) (coefC_mD N hN)
    (by rw [opD_none, obs_def]) ?_
  rw [opD_none]
  simp only [ZD_obs]
  have h := hzS.const_mul ((N : ℝ) / 16)
  have e : (N : ℝ) / 16 * 2 = N / 8 := by ring
  rw [e] at h
  exact h.congr fun k => by ring

/-- **The channel tie and the topological normalisation at the data**: `Mb = mD N`,
`Zc k = ∑_c z_c k P_c`; the factorisation (`M_rhoD`), the commutation with the hypercubic group
(`Zc_Tm`), the classical lead from `TiedB` (`channelLead_of_tied`), and `(zAct (Zc k) ε) id = z_ps k`
(`zAct_eps`).

DERIVED: `2` the limit of `TopNorm`; `4` the dimension. -/
theorem channelTie_D (f : Idx4 → LField (MassGap.SUN.SU N))
    (bareO : Ix0 → LField (MassGap.SUN.SU N)) (z : Chan → ℕ → ℝ)
    (hzP : Tendsto (fun k => z .ps k * dySpacing N k ^ 4) atTop (𝓝 2))
    (hT : TiedB (bareD f bareO)) :
    ∃ (Mb : Idx4 → (rhoD f z).B → ℝ) (Zc' : ℕ → Idx4 → Idx4 → ℝ),
      ChannelTie (rhoD f z) Mb Zc'
        ∧ Tendsto (fun k => zAct (Zc' k) epsC id * dySpacing N k ^ 4) atTop (𝓝 2) := by
  refine ⟨mD N, Zc z, ⟨fun k α b => M_rhoD f z k α b, fun k A hA c => ?_,
    channelLead_of_tied f bareO hT⟩, ?_⟩
  · have hA1 : Aᵀ * A = 1 := transpose_mul_self_of_orth hA.1
    have hA2 : A * Aᵀ = 1 := mul_eq_one_comm.mp hA1
    rw [zAct_eq, zAct_eq, rotC_eq, rotC_eq, Matrix.vecMul_vecMul, Matrix.vecMul_vecMul,
      Zc_Tm z k A hA1 hA2]
  · simp only [zAct_eps]
    exact hzP

/-- **`CompositesBuild.clayStatementAt_SU_build` at the data.** The mixing is
`mixOfZ BD (opD f) (mD N) (ZD z)` with the channel-diagonal factor `ZD z` (`z_c k` on the fields of
channel `c`, `z_sc k` on the observer's field); the bare fields are `bareD f bareO`.

Discharged: `hRie` (`coefRiemann_mD`); `hTie` from `hzS` (`scalarTie_D`); `hCT` from `hzP` and
`hT` (`channelTie_D`); `RenTensor` from `hz` (`renTensor_D`). `hphys` is taken at one `r`;
`physD` gives it from `aₖ · range k → 0` when that holds.
The inputs left: `hU`, `hphys`, `hfar`, the tensor fields `f`, the bare fields `bareO`,
the channel factors `z` with `hz`, `hzS`, `hzP`, the kernel `G` with `hK`, `hAF`, `hNG`, `hWard`,
`hT`, `hCO`, `wC`, `hLC`, `hX`.

DERIVED: `2` the least colour count and the limits of the scalar and pseudoscalar factors; `0` the
plane; `4` the dimension. -/
theorem clayStatementAt_SU_data (hN2 : 2 ≤ N) (W : ConfFlow N)
    {t C : ℝ} (ht : 0 < t)
    (hU : ClassMoments (ne_zero_of_two_le hN2) W (SymPlaqClass N) t C)
    {r : ℝ} (hphys : (energy0 W (SymPlaqClass N) (symPlaq_refl N)).PhysRange r)
    (hfar : WDeltaRun.RunSeed N)
    (f : Idx4 → LField (MassGap.SUN.SU N)) (bareO : Ix0 → LField (MassGap.SUN.SU N))
    (z : Chan → ℕ → ℝ) (hz : ∀ c k, z c k ≠ 0)
    (hzS : Tendsto (fun k => z .sc k * dySpacing N k ^ 4) atTop (𝓝 2))
    (hzP : Tendsto (fun k => z .ps k * dySpacing N k ^ 4) atTop (𝓝 2))
    (G : ℝ → ℝ) (hK : TwoPointKernel (ne_zero_of_two_le hN2) (rhoD f z) G)
    (hAF : AFCoefficient N G)
    (hNG : NonGaussianT (ne_zero_of_two_le hN2) (rhoD f z))
    (hWard : WardT (ne_zero_of_two_le hN2) (rhoD f z))
    (hT : TiedB (bareD f bareO))
    (hCO : CompOS (ne_zero_of_two_le hN2) (build (rhoD f z) (bareD f bareO)))
    (wC : TSepG (build (rhoD f z) (bareD f bareO)).Ix 0 →
      preH (ne_zero_of_two_le hN2) W hU hphys)
    (hLC : LinkCPre (ne_zero_of_two_le hN2) 0
      (preVac (ne_zero_of_two_le hN2) W hU hphys)
      (preTime (ne_zero_of_two_le hN2) W hU hphys)
      (build (rhoD f z) (bareD f bareO)) wC)
    (hX : ∀ (P : TSep 0) (Q : MarginMonoD N (SymPlaqClass N) 0 r),
      Tendsto (fun k => mixLatT (ne_zero_of_two_le hN2) (rhoD f z)
          (energy0 W (SymPlaqClass N) (symPlaq_refl N)) 0 k P.1 Q.1.1) (ultra : Filter ℕ)
          (𝓝 (mixT (ne_zero_of_two_le hN2) (rhoD f z)
            (energy0 W (SymPlaqClass N) (symPlaq_refl N)) 0 P.1 Q.1.1))
        ∧ inner ℂ (LinkReduce.wOfC eI wC P)
            (preCvec (ne_zero_of_two_le hN2) W hU hphys Q)
          = (mixT (ne_zero_of_two_le hN2) (rhoD f z)
              (energy0 W (SymPlaqClass N) (symPlaq_refl N)) 0 P.1 Q.1.1 : ℂ)) :
    ClayStatementAt hN2 W (SymPlaqClass N) (symPlaq_refl N) :=
  clayStatementAt_SU_build hN2 W ht hU hphys hfar (rhoD f z)
    (riemann_mixOfZ (opD f) (mD N) (ZD z) (coefRiemann_mD N))
    (scalarTie_D (ne_zero_of_two_le hN2) f z hzS).2
    (channelTie_D f bareO z hzP hT) G hK hAF hNG hWard (bareD f bareO) hT
    (renTensor_D (ne_zero_of_two_le hN2) f bareO z hz) hCO wC hLC hX

end Capstone

