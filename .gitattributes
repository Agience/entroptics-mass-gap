# Committed data artifacts are text, normalised to LF in the repository.
#
# The section scripts write their CSVs through Python's `csv` module, whose lineterminator is CRLF
# on every platform, while some artifacts were committed LF -- so the tree held 11 CRLF files and 6
# LF ones by nothing more than which writer touched each one last, and a regeneration rewrote every
# line of a file whose numbers had not moved. That is the diff an audit most needs to be able to
# trust, so the convention is enforced here, once, for every writer rather than in each script.
*.csv text eol=lf

# Keep the rest of the text tree normalised on the same terms.
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.lean  text eol=lf
*.json  text eol=lf
*.cff   text eol=lf
*.yml   text eol=lf
*.tex   text eol=lf
*.latex text eol=lf
*.lua   text eol=lf

# Figures and archives are binary -- never touch them.
*.png   binary
*.tar   binary
*.gz    binary
*.pdf   binary

# Paths kept out of the release archive. GitHub's source archive, which Zenodo's GitHub integration
# deposits as the software record, is built by `git archive` and leaves out every path marked
# `export-ignore`; the files stay in the repository. The list is the "Excluded" table of
# research/RELEASE-MANIFEST.md.
research.local.env                              export-ignore
staged.json                                     export-ignore
research/code/staged.json                       export-ignore
**/__pycache__/**                               export-ignore
**/.pytest_cache/**                             export-ignore
research/code/tests/.ensemble-cache/**          export-ignore
research/lean/.lake/**                          export-ignore
research/code/remote_run.py                     export-ignore
research/code/tests/test_remote_run.py          export-ignore
research/code/zenodo_deposit.py                 export-ignore
research/code/zenodo_open_dataset.py            export-ignore
research/code/tests/test_provenance.py          export-ignore
.github/workflows/publish.yml                   export-ignore
research/RELEASE-MANIFEST.md                    export-ignore
