import Mathlib
import MassGap.PurityRepCharacter

/-!
# MassGap.PurityPeterWeyl — coefficients of unitary representations are dense in `C(G)`

Appendix C of D. Bhattacharjee, U. Bhattacharya, J. M. Lockwood, T. Romanov, I. J. Sessford and
S. Singha Roy, *Thermal Purity Bounds for Yang–Mills Theory at Weak Coupling* (research draft,
15 November 2026, <https://github.com/anaxia-research/4Y-M>, commit 8e01510, `Paper-2/Paper-2.pdf`),
uses that the matrix coefficients of the irreducible
representations of a compact gauge group `G` span a dense subspace of `L²(G)` (Peter–Weyl), so
that the blocks of `PurityConvEigen.conv_eigen_multiplicity` exhaust `L²(G)`.

Every `GaugeGroup` is a matrix group: `repM G` is a continuous injective unitary
representation. For matrix groups the uniform density of unitary representation coefficients in `C(G)` is
Stone–Weierstrass, with no compact-operator theory (the `C(G)` step toward the Peter–Weyl density
used in Appendix C):

* `IsCoeff f`: `f g = Tr (A σ(g))` for a continuous unitary representation `σ` on a finite type.
* `isCoeff_const`, `isCoeff_add` (direct sum), `isCoeff_mul` (`PurityRepCharacter.kron`),
  `isCoeff_star` (`PurityRepCharacter.conjRep`), `isCoeff_entry` (the entries of `repM G`): the
  coefficients form a star subalgebra of `C(G, ℂ)` containing the entries of `repM G`.
* `coeffAlg`: the star subalgebra generated by the entries of `repM G`; `isCoeff_of_mem`: each
  of its elements is a coefficient; `coeffAlg_separatesPoints` (`repM_injective`).
* `coeffAlg_dense`: `coeffAlg` is dense (Stone–Weierstrass).
* `coeff_dense`: every continuous `f : G → ℂ` is uniformly within any `ε > 0` of a coefficient
  of a continuous unitary representation.

The density of the coefficients of irreducible representations is
`PurityReducible.irredSpan_dense`. The passage to `L²(G)` is `PurityL2.eq_zero_of_inner_coeff`.
-/

namespace MassGap.PurityPeterWeyl

open MeasureTheory MassGap MassGap.GaugeGroup MassGap.PurityRepCharacter

open scoped Matrix Kronecker

variable {G : Type} [Group G] [TopologicalSpace G] [MeasurableSpace G] [GaugeGroup G]

/-- `f` is a coefficient of a continuous unitary representation: `f g = Tr (A σ(g))`. -/
def IsCoeff (f : G → ℂ) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι) (_ : DecidableEq ι) (σ : G →* Matrix ι ι ℂ) (A : Matrix ι ι ℂ),
    Continuous σ ∧ (∀ g, σ g ∈ Matrix.unitaryGroup ι ℂ) ∧ ∀ g, f g = Matrix.trace (A * σ g)

/-! ## Closure properties -/

theorem isCoeff_const (c : ℂ) : IsCoeff (fun _ : G => c) := by
  refine ⟨Unit, inferInstance, inferInstance, 1, Matrix.of fun _ _ => c, continuous_const,
    fun _ => one_mem _, fun g => ?_⟩
  simp [Matrix.trace]

section Sum

variable {ι κ : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- The direct sum `σ ⊕ τ`. -/
def dsum (σ : G →* Matrix ι ι ℂ) (τ : G →* Matrix κ κ ℂ) : G →* Matrix (ι ⊕ κ) (ι ⊕ κ) ℂ where
  toFun g := Matrix.fromBlocks (σ g) 0 0 (τ g)
  map_one' := by simp only [map_one, Matrix.fromBlocks_one]
  map_mul' g h := by simp [map_mul, Matrix.fromBlocks_multiply]

theorem continuous_dsum {σ : G →* Matrix ι ι ℂ} {τ : G →* Matrix κ κ ℂ} (hσ : Continuous σ)
    (hτ : Continuous τ) : Continuous (dsum σ τ) :=
  continuous_pi fun a => continuous_pi fun b => by
    rcases a with a | a <;> rcases b with b | b
    · exact hσ.matrix_elem a b
    · exact continuous_const
    · exact continuous_const
    · exact hτ.matrix_elem a b

theorem dsum_mem {σ : G →* Matrix ι ι ℂ} {τ : G →* Matrix κ κ ℂ}
    (hσ : ∀ g, σ g ∈ Matrix.unitaryGroup ι ℂ) (hτ : ∀ g, τ g ∈ Matrix.unitaryGroup κ ℂ) (g : G) :
    dsum σ τ g ∈ Matrix.unitaryGroup (ι ⊕ κ) ℂ := by
  rw [Matrix.mem_unitaryGroup_iff]
  have h1 := Matrix.mem_unitaryGroup_iff.mp (hσ g)
  have h2 := Matrix.mem_unitaryGroup_iff.mp (hτ g)
  show Matrix.fromBlocks (σ g) 0 0 (τ g) * star (Matrix.fromBlocks (σ g) 0 0 (τ g)) = 1
  rw [Matrix.star_eq_conjTranspose, Matrix.fromBlocks_conjTranspose, Matrix.fromBlocks_multiply]
  rw [← Matrix.star_eq_conjTranspose, ← Matrix.star_eq_conjTranspose, h1, h2]
  simp [Matrix.fromBlocks_one]

theorem trace_fromBlocks_mul (A S : Matrix ι ι ℂ) (B T : Matrix κ κ ℂ) :
    Matrix.trace (Matrix.fromBlocks A 0 0 B * Matrix.fromBlocks S 0 0 T) =
      Matrix.trace (A * S) + Matrix.trace (B * T) := by
  rw [Matrix.fromBlocks_multiply]
  simp [Matrix.trace, Fintype.sum_sum_type]

end Sum

theorem isCoeff_add {f₁ f₂ : G → ℂ} (h₁ : IsCoeff f₁) (h₂ : IsCoeff f₂) :
    IsCoeff (fun g => f₁ g + f₂ g) := by
  obtain ⟨ι, _, _, σ, A, hσc, hσu, hf₁⟩ := h₁
  obtain ⟨κ, _, _, τ, B, hτc, hτu, hf₂⟩ := h₂
  refine ⟨ι ⊕ κ, inferInstance, inferInstance, dsum σ τ, Matrix.fromBlocks A 0 0 B,
    continuous_dsum hσc hτc, dsum_mem hσu hτu, fun g => ?_⟩
  show f₁ g + f₂ g = _
  rw [hf₁, hf₂]
  exact (trace_fromBlocks_mul A (σ g) B (τ g)).symm

theorem kron_mem {ι κ : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
    {σ : G →* Matrix ι ι ℂ} {τ : G →* Matrix κ κ ℂ}
    (hσ : ∀ g, σ g ∈ Matrix.unitaryGroup ι ℂ) (hτ : ∀ g, τ g ∈ Matrix.unitaryGroup κ ℂ) (g : G) :
    kron σ τ g ∈ Matrix.unitaryGroup (ι × κ) ℂ := by
  rw [Matrix.mem_unitaryGroup_iff, kron_apply, Matrix.star_eq_conjTranspose,
    Matrix.conjTranspose_kronecker, ← Matrix.mul_kronecker_mul, ← Matrix.star_eq_conjTranspose,
    ← Matrix.star_eq_conjTranspose, Matrix.mem_unitaryGroup_iff.mp (hσ g),
    Matrix.mem_unitaryGroup_iff.mp (hτ g), Matrix.one_kronecker_one]

theorem isCoeff_mul {f₁ f₂ : G → ℂ} (h₁ : IsCoeff f₁) (h₂ : IsCoeff f₂) :
    IsCoeff (fun g => f₁ g * f₂ g) := by
  obtain ⟨ι, _, _, σ, A, hσc, hσu, hf₁⟩ := h₁
  obtain ⟨κ, _, _, τ, B, hτc, hτu, hf₂⟩ := h₂
  refine ⟨ι × κ, inferInstance, inferInstance, kron σ τ, A ⊗ₖ B,
    continuous_kron hσc hτc, kron_mem hσu hτu, fun g => ?_⟩
  show f₁ g * f₂ g = _
  rw [hf₁, hf₂, kron_apply, ← Matrix.mul_kronecker_mul, Matrix.trace_kronecker]

theorem conjRep_mem {ι : Type} [Fintype ι] [DecidableEq ι] {σ : G →* Matrix ι ι ℂ}
    (hσ : ∀ g, σ g ∈ Matrix.unitaryGroup ι ℂ) (g : G) :
    conjRep σ g ∈ Matrix.unitaryGroup ι ℂ := by
  rw [Matrix.mem_unitaryGroup_iff, conjRep_apply]
  have h1 := Matrix.mem_unitaryGroup_iff.mp (hσ g)
  have hstar : star ((σ g).map (starRingEnd ℂ)) = (star (σ g)).map (starRingEnd ℂ) := by
    ext i j
    simp [Matrix.star_apply]
  rw [hstar, ← Matrix.map_mul, h1, Matrix.map_one _ (map_zero _) (map_one _)]

theorem isCoeff_star {f : G → ℂ} (h : IsCoeff f) : IsCoeff (fun g => starRingEnd ℂ (f g)) := by
  obtain ⟨ι, _, _, σ, A, hσc, hσu, hf⟩ := h
  refine ⟨ι, inferInstance, inferInstance, conjRep σ, A.map (starRingEnd ℂ),
    continuous_conjRep hσc, conjRep_mem hσu, fun g => ?_⟩
  show starRingEnd ℂ (f g) = _
  rw [hf, conjRep_apply, ← Matrix.map_mul]
  simp only [Matrix.trace, Matrix.diag, Matrix.map_apply, map_sum]

theorem isCoeff_entry (i j : Fin (dim G)) : IsCoeff (fun g : G => repM G g i j) := by
  refine ⟨Fin (dim G), inferInstance, inferInstance, repHom G, Matrix.single j i 1,
    continuous_repHom, fun g => repM_mem g, fun g => ?_⟩
  rw [repHom_apply]
  simp [Matrix.trace, Matrix.mul_apply, Matrix.single_apply, ite_and]

/-! ## The star subalgebra generated by the entries -/

theorem continuous_entry (p : Fin (dim G) × Fin (dim G)) :
    Continuous (fun g : G => repM G g p.1 p.2) :=
  continuous_repM.matrix_elem p.1 p.2

variable (G) in
/-- The star subalgebra of `C(G, ℂ)` generated by the entries of `repM G`. -/
noncomputable def coeffAlg : StarSubalgebra ℂ C(G, ℂ) :=
  StarAlgebra.adjoin ℂ
    (Set.range fun p : Fin (dim G) × Fin (dim G) => (⟨_, continuous_entry p⟩ : C(G, ℂ)))

theorem isCoeff_of_mem {f : C(G, ℂ)} (hf : f ∈ coeffAlg G) : IsCoeff (f : G → ℂ) := by
  induction hf using StarAlgebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨p, rfl⟩ := hx
    exact isCoeff_entry p.1 p.2
  | algebraMap r => exact isCoeff_const r
  | add x y _ _ hx hy => exact isCoeff_add hx hy
  | mul x y _ _ hx hy => exact isCoeff_mul hx hy
  | star x _ hx => exact isCoeff_star hx

theorem coeffAlg_separatesPoints : (coeffAlg G).SeparatesPoints := by
  intro x y hxy
  have hne : repM G x ≠ repM G y := fun h => hxy (repM_injective h)
  obtain ⟨i, j, hij⟩ : ∃ i j, repM G x i j ≠ repM G y i j := by
    by_contra h
    push Not at h
    exact hne (Matrix.ext h)
  refine ⟨_, ⟨⟨_, continuous_entry (i, j)⟩, StarAlgebra.subset_adjoin ℂ _ ⟨(i, j), rfl⟩, rfl⟩,
    hij⟩

theorem coeffAlg_dense : (coeffAlg G).topologicalClosure = ⊤ :=
  ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints _
    coeffAlg_separatesPoints

/-- Density of coefficients: every continuous `f` is uniformly within `ε` of a coefficient of a
continuous unitary representation. -/
theorem coeff_dense (f : C(G, ℂ)) {ε : ℝ} (hε : 0 < ε) :
    ∃ (ι : Type) (_ : Fintype ι) (_ : DecidableEq ι) (σ : G →* Matrix ι ι ℂ)
      (A : Matrix ι ι ℂ), Continuous σ ∧ (∀ g, σ g ∈ Matrix.unitaryGroup ι ℂ) ∧
        ∀ g, ‖f g - Matrix.trace (A * σ g)‖ < ε := by
  have hf : f ∈ closure ((coeffAlg G : Set C(G, ℂ))) := by
    rw [← StarSubalgebra.topologicalClosure_coe, coeffAlg_dense]
    exact StarSubalgebra.mem_top
  obtain ⟨b, hb, hfb⟩ := Metric.mem_closure_iff.mp hf ε hε
  obtain ⟨ι, i1, i2, σ, A, hσc, hσu, hbA⟩ := isCoeff_of_mem hb
  refine ⟨ι, i1, i2, σ, A, hσc, hσu, fun g => ?_⟩
  rw [← hbA g, ← dist_eq_norm]
  exact lt_of_le_of_lt (ContinuousMap.dist_apply_le_dist g) hfb

#print axioms isCoeff_add
#print axioms isCoeff_mul
#print axioms isCoeff_star
#print axioms isCoeff_entry
#print axioms isCoeff_of_mem
#print axioms coeffAlg_separatesPoints
#print axioms coeffAlg_dense
#print axioms coeff_dense

end MassGap.PurityPeterWeyl
