/-! ## 1. The charged-sector bound on a twist deficit (any finite abelian group) -/

section Deficit

open MassGap.KernelPower MassGap.FluxSectorFourier MassGap.TwistDeficitUnionN

variable {X : Type*} [MeasurableSpace X] {μ : Measure X} [IsProbabilityMeasure μ]
variable {G : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]
variable {act : G → X → X} {a : X → X → ℝ}

/-- **A twist removes at most twice the charged sectors**: `deficit g ≤ 2 · oddTrace g`, the sum of the sector
traces with `ψ(g) ≠ 1`. -/
theorem deficit_le_two_oddTrace (ha : Bdd a) (hsym : ∀ x y, a x y = a y x)
    (hA : CentreAction μ act) (g : G) :
    deficit μ a act g ≤ 2 * VortexAperture.oddTrace μ a act g := by
  classical
  rw [deficit_eq_sum ha hsym hA, VortexAperture.oddTrace, Finset.sum_filter, Finset.mul_sum]
  refine Finset.sum_le_sum fun ψ _ => ?_
  have hc := sectorTrace_nonneg (μ := μ) (a := a) (act := act) ψ
  by_cases h : ψ g = 1
  · rw [if_neg (fun hne => hne h), h, Complex.one_re]
    simp
  · rw [if_pos h]
    have hn := Complex.abs_re_le_norm (ψ g)
    rw [AddChar.norm_apply] at hn
    have hre : -1 ≤ (ψ g).re := (abs_le.1 hn).1
    nlinarith

end Deficit

/-! ## 2. Loops, loop states and loop shells at `SU(N)` -/

section Loops

variable {N : ℕ} {i : Fin 4} {T : Dir i → ℕ}

/-- **The holonomy of a word** of oriented links at `SU(N)`: the ordered product. -/
def whN (w : List (SpT i T × Bool)) (V : SpT i T → SUN.SU N) : SUN.SU N :=
  (w.map fun lo => if lo.2 then V lo.1 else (V lo.1)⁻¹).prod

/-- The holonomy of a word is continuous in the configuration. -/
theorem continuous_whN (w : List (SpT i T × Bool)) :
    Continuous fun V : SpT i T → SUN.SU N => whN w V := by
  induction w with
  | nil => simpa [whN] using continuous_const
  | cons x w ih =>
      have hx : Continuous fun V : SpT i T → SUN.SU N => if x.2 then V x.1 else (V x.1)⁻¹ := by
        by_cases h : x.2
        · simp only [h, if_true]; exact continuous_apply _
        · simp only [h]; exact (continuous_apply _).inv
      have : (fun V : SpT i T → SUN.SU N => whN (x :: w) V)
          = fun V => (if x.2 then V x.1 else (V x.1)⁻¹) * whN w V := by
        funext V; simp [whN]
      rw [this]
      exact hx.mul ih

/-- The holonomy of a loop at `SU(N)`, from its base. -/
def holN (C : Loop i T) (V : SpT i T → SUN.SU N) : SUN.SU N := whN (walk C.base C.steps) V

/-- **The `SU(N)` Wilson loop** `Re tr hol_C`. -/
def wlN (C : Loop i T) (V : SpT i T → SUN.SU N) : ℝ :=
  (Matrix.trace (holN C V : Matrix (Fin N) (Fin N) ℂ)).re

/-- The Wilson loop is continuous in the configuration. -/
theorem continuous_wlN (C : Loop i T) : Continuous (wlN (N := N) C) := by
  unfold wlN holN
  exact Complex.continuous_re.comp
    ((continuous_subtype_val.comp (continuous_whN _)).matrix_trace)

/-- `|W_C| ≤ N`. -/
theorem abs_wlN_le (C : Loop i T) (V : SpT i T → SUN.SU N) : |wlN C V| ≤ N :=
  WilsonAction.abs_re_trace_le (holN C V)

/-- **`Im tr hol_C`**, the part of the trace that `wlN` drops. -/
def imN (C : Loop i T) (V : SpT i T → SUN.SU N) : ℝ :=
  (Matrix.trace (holN C V : Matrix (Fin N) (Fin N) ℂ)).im

/-- `Im tr hol_C` is continuous in the configuration. -/
theorem continuous_imN (C : Loop i T) : Continuous (imN (N := N) C) := by
  unfold imN holN
  exact Complex.continuous_im.comp
    ((continuous_subtype_val.comp (continuous_whN _)).matrix_trace)

/-- **A loop letter**: `(C, true)` reads `Re tr hol_C`, `(C, false)` reads `Im tr hol_C`. -/
def lfN (c : Loop i T × Bool) (V : SpT i T → SUN.SU N) : ℝ :=
  if c.2 then wlN c.1 V else imN c.1 V

/-- A loop letter is continuous in the configuration. -/
theorem continuous_lfN (c : Loop i T × Bool) : Continuous (lfN (N := N) c) := by
  unfold lfN
  by_cases h : c.2
  · simp only [h, if_true]; exact continuous_wlN c.1
  · simp only [h]; exact continuous_imN c.1

/-- **A loop word**: the product of its letters (the empty word is `1`). -/
def pfN (L : List (Loop i T × Bool)) (V : SpT i T → SUN.SU N) : ℝ :=
  (L.map fun c => lfN c V).prod

/-- A loop word is continuous in the configuration. -/
theorem continuous_pfN (L : List (Loop i T × Bool)) : Continuous (pfN (N := N) L) := by
  induction L with
  | nil =>
      have e : pfN (N := N) ([] : List (Loop i T × Bool)) = fun _ => 1 := funext fun V => by simp [pfN]
      rw [e]; exact continuous_const
  | cons c L ih =>
      have e : pfN (N := N) (c :: L) = fun V => lfN c V * pfN L V := by
        funext V; simp [pfN]
      rw [e]; exact (continuous_lfN c).mul ih

/-- **The size of a word**: its total perimeter plus one per junction between letters, so a single loop has
size `len C`, and finitely many words have size at most any bound. -/
def wsize (L : List (Loop i T × Bool)) : ℕ := (L.map fun c => c.1.len).sum + (L.length - 1)

/-- **Finitely many words have size at most `M`.** -/
theorem finite_words (M : ℕ) : {L : List (Loop i T × Bool) | wsize L ≤ M}.Finite := by
  set S : Set (Loop i T × Bool) := {c | c.1.len ≤ M} with hSdef
  have hS : S.Finite :=
    ((finite_loops (i := i) (T := T) M).prod Set.finite_univ).subset fun c hc => ⟨hc, trivial⟩
  haveI := hS.to_subtype
  refine ((List.finite_length_le S (M + 1)).image (List.map Subtype.val)).subset ?_
  intro L hL
  have hL' : wsize L ≤ M := hL
  unfold wsize at hL'
  have hall : ∀ c ∈ L, c ∈ S := fun c hc =>
    (List.le_sum_of_mem (List.mem_map_of_mem (f := fun c : Loop i T × Bool => c.1.len) hc)).trans
      (by omega)
  lift L to List S using hall
  refine ⟨L, ?_, rfl⟩
  have : (L.map Subtype.val).length - 1 ≤ M := by omega
  simp only [List.length_map] at this
  show L.length ≤ M + 1
  omega

variable {μ : Measure (SpT i T → SUN.SU N)}

/-- The expectation of the word `L` in the state `Ω`: `∫ W_L Ω²`. -/
def vevN (μ : Measure (SpT i T → SUN.SU N)) (Ω : (SpT i T → SUN.SU N) → ℝ)
    (L : List (Loop i T × Bool)) : ℝ :=
  ∫ V, pfN L V * Ω V ^ 2 ∂μ

/-- **The loop state of a word** `ψ_L = (W_L − ⟨W_L⟩) Ω`, `W_L` the product of the letters of `L`. -/
def loopStateN (μ : Measure (SpT i T → SUN.SU N)) (Ω : (SpT i T → SUN.SU N) → ℝ)
    (L : List (Loop i T × Bool)) : (SpT i T → SUN.SU N) → ℝ :=
  fun V => (pfN L V - vevN μ Ω L) * Ω V

/-- **The two loop families.** `single`: the words `[(C, true)]`, one loop read by `Re tr` (the loop states of
`ElectricLoops`). `words`: every word, so the span of the loop states is the state image of the algebra that
`Re tr hol_C` and `Im tr hol_C` generate. -/
inductive LoopFam : Type
  | single
  | words

/-- The words a family admits. -/
def LoopFam.adm : LoopFam → List (Loop i T × Bool) → Prop
  | .single, L => ∃ C : Loop i T, L = [(C, true)]
  | .words, _ => True

/-- **The loop states of the family `F` of physical size at most `R`**, as `L²` vectors. -/
def loopSetN (μ : Measure (SpT i T → SUN.SU N)) (Ω : (SpT i T → SUN.SU N) → ℝ) (F : LoopFam) (a R : ℝ) :
    Set (Lp ℝ 2 μ) :=
  {g | ∃ L : List (Loop i T × Bool), F.adm L ∧ a * (wsize L : ℝ) ≤ R ∧
    (g : (SpT i T → SUN.SU N) → ℝ) =ᵐ[μ] loopStateN μ Ω L}

/-- **`H_R`**: the span of the loop states of size at most `R`. -/
def HN (μ : Measure (SpT i T → SUN.SU N)) (Ω : (SpT i T → SUN.SU N) → ℝ) (F : LoopFam) (a R : ℝ) :
    Submodule ℝ (Lp ℝ 2 μ) :=
  Submodule.span ℝ (loopSetN μ Ω F a R)

/-- `H_R` grows with `R`. -/
theorem HN_mono (Ω : (SpT i T → SUN.SU N) → ℝ) (F : LoopFam) (a : ℝ) {R R' : ℝ} (h : R ≤ R') :
    HN μ Ω F a R ≤ HN μ Ω F a R' :=
  Submodule.span_mono fun _ ⟨L, hF, hL, he⟩ => ⟨L, hF, hL.trans h, he⟩

/-- **The loop shells**: `S₀ = H_{R₀}`, `S_{k+1} = H_{R_{k+1}} ⊖ H_{R_k}`. -/
def shellN (μ : Measure (SpT i T → SUN.SU N)) (Ω : (SpT i T → SUN.SU N) → ℝ) (F : LoopFam) (a : ℝ)
    (R : ℕ → ℝ) : ℕ → Submodule ℝ (Lp ℝ 2 μ) :=
  shellOf fun k => HN μ Ω F a (R k)

/-- All loop states of the family `F`, as `L²` vectors. -/
def allLoopsN (μ : Measure (SpT i T → SUN.SU N)) (Ω : (SpT i T → SUN.SU N) → ℝ) (F : LoopFam) :
    Set (Lp ℝ 2 μ) :=
  {g | ∃ L : List (Loop i T × Bool), F.adm L ∧ (g : (SpT i T → SUN.SU N) → ℝ) =ᵐ[μ] loopStateN μ Ω L}

/-- The single loops are words: `allLoopsN single ⊆ allLoopsN words`. -/
theorem allLoopsN_single_subset (Ω : (SpT i T → SUN.SU N) → ℝ) :
    allLoopsN μ Ω .single ⊆ allLoopsN μ Ω .words :=
  fun _ ⟨L, _, he⟩ => ⟨L, trivial, he⟩

/-- **Finitely many loop states have size at most `R`** (at lattice spacing `a > 0`). -/
theorem finite_loopSetN (Ω : (SpT i T → SUN.SU N) → ℝ) (F : LoopFam) {a : ℝ} (ha : 0 < a) (R : ℝ) :
    (loopSetN μ Ω F a R).Finite := by
  have hF := finite_words (i := i) (T := T) ⌊R / a⌋₊
  refine (hF.biUnion fun L _ => (?_ : ({g : Lp ℝ 2 μ |
      (g : (SpT i T → SUN.SU N) → ℝ) =ᵐ[μ] loopStateN μ Ω L}).Finite)).subset ?_
  · refine Set.Subsingleton.finite fun g hg g' hg' => Lp.ext ?_
    exact (Set.mem_setOf_eq ▸ hg).trans (Set.mem_setOf_eq ▸ hg').symm
  · rintro g ⟨L, -, hL, he⟩
    refine Set.mem_biUnion (x := L) ?_ he
    show wsize L ≤ ⌊R / a⌋₊
    refine Nat.le_floor ?_
    rw [le_div_iff₀ ha]
    linarith

/-- `H_R` is finite-dimensional, so it has an orthogonal projection. -/
theorem hasOrthogonalProjection_HN (Ω : (SpT i T → SUN.SU N) → ℝ) (F : LoopFam) {a : ℝ} (ha : 0 < a)
    (R : ℝ) : (HN μ Ω F a R).HasOrthogonalProjection := by
  haveI : FiniteDimensional ℝ (HN μ Ω F a R) :=
    FiniteDimensional.span_of_finite ℝ (finite_loopSetN Ω F ha R)
  haveI : CompleteSpace (HN μ Ω F a R) := FiniteDimensional.complete ℝ _
  exact Submodule.HasOrthogonalProjection.ofCompleteSpace _

/-- The loop shells are mutually orthogonal. -/
theorem shellN_orth (Ω : (SpT i T → SUN.SU N) → ℝ) (F : LoopFam) (a : ℝ) {R : ℕ → ℝ} (hR : Monotone R) :
    ∀ k l, k ≠ l → ∀ x ∈ shellN μ Ω F a R k, ∀ y ∈ shellN μ Ω F a R l, inner ℝ x y = 0 :=
  shellOf_orth _ fun _ _ h => HN_mono Ω F a (hR h)

/-- **The loops' span lies in the span of the shells**, for radii that are monotone and reach every
size. -/
theorem span_allLoopsN_le (Ω : (SpT i T → SUN.SU N) → ℝ) (F : LoopFam) {a : ℝ} (ha : 0 < a)
    {R : ℕ → ℝ} (hR : Monotone R) (hreach : ∀ L : ℕ, ∃ k, a * (L : ℝ) ≤ R k) :
    Submodule.span ℝ (allLoopsN μ Ω F) ≤ ⨆ k, shellN μ Ω F a R k := by
  rw [Submodule.span_le]
  rintro g ⟨L, hF, he⟩
  obtain ⟨k, hk⟩ := hreach (wsize L)
  have hg : g ∈ HN μ Ω F a (R k) := Submodule.subset_span ⟨L, hF, hk, he⟩
  exact le_iSup_shellOf (fun k => HN μ Ω F a (R k)) (fun _ _ h => HN_mono Ω F a (hR h))
    (fun k => hasOrthogonalProjection_HN Ω F ha (R k)) k hg

/-- The one-letter word `[(C, true)]` reads `W_C`. -/
theorem pfN_single (C : Loop i T) (V : SpT i T → SUN.SU N) : pfN [(C, true)] V = wlN C V := by
  simp [pfN, lfN]

/-- The one-letter word `[(C, true)]` has the size of `C`. -/
theorem wsize_single (C : Loop i T) : wsize [(C, true)] = C.len := by
  simp [wsize]

/-- At `N = 2` the loop state of `[(C, true)]` is the `ElectricLoops` loop state of `C`. -/
theorem loopStateN_two (μ : Measure (SpT i T → SUN.SU 2)) (Ω : (SpT i T → SUN.SU 2) → ℝ) (C : Loop i T) :
    loopStateN μ Ω [(C, true)] = loopState μ Ω C := by
  have h : pfN (N := 2) [(C, true)] = C.wl := funext fun V => pfN_single C V
  unfold loopStateN vevN loopState vev
  rw [h]

/-- At `N = 2` the single-loop family has the loop states of `ElectricLoops` at each size. -/
theorem loopSetN_two (μ : Measure (SpT i T → SUN.SU 2)) (Ω : (SpT i T → SUN.SU 2) → ℝ) (a R : ℝ) :
    loopSetN μ Ω .single a R = loopSet μ Ω a R := by
  ext g
  constructor
  · rintro ⟨L, ⟨C, rfl⟩, hL, he⟩
    rw [wsize_single] at hL
    rw [loopStateN_two] at he
    exact ⟨C, hL, he⟩
  · rintro ⟨C, hC, he⟩
    refine ⟨[(C, true)], ⟨C, rfl⟩, by rw [wsize_single]; exact hC, ?_⟩
    rw [loopStateN_two]; exact he

/-- At `N = 2` the single-loop shells are those of `ElectricLoops`. -/
theorem shellN_two (μ : Measure (SpT i T → SUN.SU 2)) (Ω : (SpT i T → SUN.SU 2) → ℝ) (a : ℝ)
    (R : ℕ → ℝ) : shellN μ Ω .single a R = shell μ Ω a R := by
  unfold shellN shell HN H
  simp only [loopSetN_two]

/-- At `N = 2` the single-loop states are those of `ElectricLoops`. -/
theorem allLoopsN_two (μ : Measure (SpT i T → SUN.SU 2)) (Ω : (SpT i T → SUN.SU 2) → ℝ) :
    allLoopsN μ Ω .single = allLoops μ Ω := by
  ext g
  constructor
  · rintro ⟨L, ⟨C, rfl⟩, he⟩
    rw [loopStateN_two] at he
    exact ⟨C, he⟩
  · rintro ⟨C, he⟩
    exact ⟨[(C, true)], ⟨C, rfl⟩, by rw [loopStateN_two]; exact he⟩

end Loops

/-! ## 3. The zero-flux slice at `SU(N)`: levels and the gap from the loop shells -/

section Slice

variable {N : ℕ} [NeZero N]

variable (N) in
/-- Slice configurations of step `i` at side `n`, `SU(N)`. -/
abbrev SliceN (n : ℕ) (i : Fin 4) : Type := SpT i (Tr n i) → SUN.SU N

variable (N) in
/-- **The zero-flux levels with their eigenfunctions named** (`SU(N)`): `TensionFloor.EigenLevels` at `SU(N)`,
the clauses of `GlueballArea.ZeroFluxLevels N β n i g₀ E` with `φ` and `μ` explicit. Bookkeeping: the
Hilbert–Schmidt spectral theorem for `trivKN N`, not proved in the tree. -/
structure EigenLevelsN (β : ℝ) (n : ℕ) (i : Fin 4) {ι : Type*} (g₀ : ι) (E : ι → ℝ)
    (φ : ι → SliceN N n i → ℝ) (μ : ι → ℝ) : Prop where
  ground : ∀ j, E g₀ ≤ E j
  norm : ∀ j, ∫ x, φ j x * φ j x ∂(hSN N n i) = 1
  orth : ∀ j k, j ≠ k → ∫ x, φ j x * φ k x ∂(hSN N n i) = 0
  eigen : ∀ j x, ∫ y, trivKN N β n i x y * φ j y ∂(hSN N n i) = μ j * φ j x
  energy : ∀ j, μ j ^ 2 = Real.exp (-(E j * ((n : ℝ) * aRun N β)))
  hs_eq : hs (hSN N n i) (trivKN N β n i) = ∑' j, Real.exp (-(E j * ((n : ℝ) * aRun N β)))
  hs_conv_eq : hs (hSN N n i) (conv (hSN N n i) (trivKN N β n i) (trivKN N β n i))
      = ∑' j, Real.exp (-(E j * (2 * ((n : ℝ) * aRun N β))))

theorem EigenLevelsN.zeroFluxLevels {β : ℝ} {n : ℕ} {i : Fin 4} {ι : Type*} {g₀ : ι} {E : ι → ℝ}
    {φ : ι → SliceN N n i → ℝ} {μ : ι → ℝ} (h : EigenLevelsN N β n i g₀ E φ μ) :
    ZeroFluxLevels N β n i g₀ E :=
  ⟨h.ground, ⟨φ, μ, h.norm, h.orth, h.eigen, h.energy⟩, h.hs_eq, h.hs_conv_eq⟩

/-- At `N = 2`, `EigenLevelsN` is `TensionFloor.EigenLevels`. -/
theorem eigenLevelsN_two {β : ℝ} {n : ℕ} {i : Fin 4} {ι : Type*} {g₀ : ι} {E : ι → ℝ}
    {φ : ι → SliceN 2 n i → ℝ} {μ : ι → ℝ} (h : TensionFloor.EigenLevels β n i g₀ E φ μ) :
    EigenLevelsN 2 β n i g₀ E φ μ :=
  ⟨h.ground, h.norm, h.orth, h.eigen, h.energy, h.hs_eq, h.hs_conv_eq⟩

/-- The operator of `trivKN N` acts on the level `φ_j` by `μ_j`. -/
theorem trivKN_vecOfN {β : ℝ} {n : ℕ} {i : Fin 4}
    {ι : Type*} {g₀ : ι} {E : ι → ℝ} {φ : ι → SliceN N n i → ℝ} {μv : ι → ℝ}
    (hL : EigenLevelsN N β n i g₀ E φ μv) (hm : ∀ j, Measurable (φ j))
    {C : ℝ} (hkm : Measurable (Function.uncurry (trivKN N β n i))) (hC0 : 0 ≤ C)
    (hkb : ∀ x y, |trivKN N β n i x y| ≤ C) (j : ι) :
    kernelCLM (trivKN N β n i) C hkm hC0 hkb (hSN N n i) (hSN N n i) (vecOf (hm j) (hL.norm j))
      = μv j • vecOf (hm j) (hL.norm j) := by
  apply Lp.ext
  filter_upwards [coeFn_kernelCLM (trivKN N β n i) C hkm hC0 hkb (hSN N n i) (hSN N n i)
      (vecOf (hm j) (hL.norm j)), Lp.coeFn_smul (μv j) (vecOf (hm j) (hL.norm j)),
      (memLp_of_norm (hm j) (hL.norm j)).coeFn_toLp] with z h1 h2 h3
  rw [h1, h2, Pi.smul_apply, smul_eq_mul]
  change kernelFun (trivKN N β n i) (hSN N n i)
      (((memLp_of_norm (hm j) (hL.norm j)).toLp (φ j) : Lp ℝ 2 (hSN N n i)) : SliceN N n i → ℝ) z
    = μv j * (((memLp_of_norm (hm j) (hL.norm j)).toLp (φ j) : Lp ℝ 2 (hSN N n i)) :
        SliceN N n i → ℝ) z
  rw [h3, KernelPower.kernelFun_congr (memLp_of_norm (hm j) (hL.norm j)).coeFn_toLp z]
  exact hL.eigen j z

/-- **A relative bound on the excited levels is the gap clause** (`SU(N)`). -/
theorem zeroFluxGap_of_levelBoundN {β : ℝ} (hβ : 0 < β) {n : ℕ} (hn : 0 < n) {i : Fin 4}
    {ι : Type*} {g₀ : ι} {E : ι → ℝ} {φ : ι → SliceN N n i → ℝ} {μv : ι → ℝ}
    (hL : EigenLevelsN N β n i g₀ E φ μv) (hm : ∀ j, Measurable (φ j))
    {C : ℝ} (hkm : Measurable (Function.uncurry (trivKN N β n i))) (hC0 : 0 ≤ C)
    (hkb : ∀ x y, |trivKN N β n i x y| ≤ C) {m : ℝ}
    (h : ∀ j, j ≠ g₀ →
      ‖kernelCLM (trivKN N β n i) C hkm hC0 hkb (hSN N n i) (hSN N n i) (vecOf (hm j) (hL.norm j))‖
        ≤ |μv g₀| * Real.exp (-(m * ((n : ℝ) * aRun N β)) / 2) * ‖vecOf (hm j) (hL.norm j)‖) :
    ZeroFluxGap g₀ E m := by
  intro j hj
  have hN1 : 1 ≤ N := Nat.one_le_iff_ne_zero.mpr (NeZero.ne N)
  set t := (n : ℝ) * aRun N β with ht
  have htpos : 0 < t := mul_pos (by exact_mod_cast hn) (aRun_pos hN1 hβ)
  have hb := h j hj
  rw [trivKN_vecOfN hL hm hkm hC0 hkb j, norm_smul, norm_vecOf, mul_one, mul_one,
    Real.norm_eq_abs] at hb
  have hsq : μv j ^ 2 ≤ μv g₀ ^ 2 * Real.exp (-(m * t)) := by
    have := pow_le_pow_left₀ (abs_nonneg _) hb 2
    have he : Real.exp (-(m * t) / 2) ^ 2 = Real.exp (-(m * t)) := by
      rw [← Real.exp_nat_mul]; congr 1; push_cast; ring
    rw [sq_abs, mul_pow, sq_abs, he] at this
    exact this
  rw [hL.energy j, hL.energy g₀, ← Real.exp_add, Real.exp_le_exp] at hsq
  have : (E g₀ + m) * t ≤ E j * t := by linarith
  exact le_of_mul_le_mul_right this htpos

/-- **The gap from diagonal shell bounds** (`SU(N)`): `LoopZoom.zeroFluxGap_of_shellDiag` on the `SU(N)` loop
shells. -/
theorem zeroFluxGap_of_shellDiagN {β : ℝ} (hβ : 0 < β) {n : ℕ} (hn : 0 < n) {i : Fin 4}
    {ι : Type*} {g₀ : ι} {E : ι → ℝ} {φ : ι → SliceN N n i → ℝ} {μv : ι → ℝ}
    (hL : EigenLevelsN N β n i g₀ E φ μv) (hm : ∀ j, Measurable (φ j))
    {C : ℝ} (hkm : Measurable (Function.uncurry (trivKN N β n i))) (hC0 : 0 ≤ C)
    (hkb : ∀ x y, |trivKN N β n i x y| ≤ C)
    (F : LoopFam) {R : ℕ → ℝ} (hR : Monotone R) (hreach : ∀ L : ℕ, ∃ k, aRun N β * (L : ℝ) ≤ R k)
    (hgen : ∀ j, j ≠ g₀ → vecOf (hm j) (hL.norm j)
      ∈ closure (Submodule.span ℝ (allLoopsN (hSN N n i) (φ g₀) F) : Set (Lp ℝ 2 (hSN N n i))))
    (s : ℕ → ℝ) (hs0 : ∀ k, 0 ≤ s k)
    (hdiag : ∀ k, ∀ x ∈ shellN (hSN N n i) (φ g₀) F (aRun N β) R k,
      ‖kernelCLM (trivKN N β n i) C hkm hC0 hkb (hSN N n i) (hSN N n i) x‖ ≤ s k * ‖x‖)
    {m : ℝ} (hsum : ∀ F : Finset ℕ, ∑ l ∈ F, s l
      ≤ |μv g₀| * Real.exp (-(m * ((n : ℝ) * aRun N β)) / 2)) :
    ZeroFluxGap g₀ E m := by
  have hN1 : 1 ≤ N := Nat.one_le_iff_ne_zero.mpr (NeZero.ne N)
  have ha : 0 < aRun N β := aRun_pos hN1 hβ
  refine zeroFluxGap_of_levelBoundN hβ hn hL hm hkm hC0 hkb fun j hj => ?_
  exact bound_on_diagShells (shellN (hSN N n i) (φ g₀) F (aRun N β) R) (shellN_orth _ F _ hR) s hs0 hdiag
    hsum _ (closure_mono (span_allLoopsN_le (φ g₀) F ha hR hreach) (hgen j hj))

/-- **The electric reduction with the diagonal shell rate** (`SU(N)`): `LoopZoom.zeroFluxGap_of_electricDiag`
on the `SU(N)` loop shells. -/
theorem zeroFluxGap_of_electricDiagN {β : ℝ} (hβ : 0 < β) {n : ℕ} (hn : 0 < n) {i : Fin 4}
    {ι : Type*} {g₀ : ι} {E : ι → ℝ} {φ : ι → SliceN N n i → ℝ} {μv : ι → ℝ}
    (hL : EigenLevelsN N β n i g₀ E φ μv) (hm : ∀ j, Measurable (φ j))
    {C : ℝ} (hkm : Measurable (Function.uncurry (trivKN N β n i))) (hC0 : 0 ≤ C)
    (hkb : ∀ x y, |trivKN N β n i x y| ≤ C)
    (F : LoopFam) {R : ℕ → ℝ} (hR : Monotone R) (hreach : ∀ L : ℕ, ∃ k, aRun N β * (L : ℝ) ≤ R k)
    (hgen : ∀ j, j ≠ g₀ → vecOf (hm j) (hL.norm j)
      ∈ closure (Submodule.span ℝ (allLoopsN (hSN N n i) (φ g₀) F) : Set (Lp ℝ 2 (hSN N n i))))
    {c c' σ δ : ℝ} (hc : 0 ≤ c) (hc' : 0 ≤ c') (hσ : 0 ≤ σ) (hδ : 0 < c * σ * δ)
    (hR0 : ∀ k, 0 < R k) (hRδ : ∀ k : ℕ, ((k : ℝ) + 1) * δ ≤ R k)
    (hdiag : ∀ k, ∀ x ∈ shellN (hSN N n i) (φ g₀) F (aRun N β) R k,
      ‖kernelCLM (trivKN N β n i) C hkm hC0 hkb (hSN N n i) (hSN N n i) x‖ ^ 2
        ≤ μv g₀ ^ 2 * Real.exp (-((c * σ * R k + c' / R k) * ((n : ℝ) * aRun N β))) * ‖x‖ ^ 2) :
    ZeroFluxGap g₀ E (diagRate c c' σ δ ((n : ℝ) * aRun N β)) := by
  have hN1 : 1 ≤ N := Nat.one_le_iff_ne_zero.mpr (NeZero.ne N)
  set t := (n : ℝ) * aRun N β with ht
  have htpos : 0 < t := mul_pos (by exact_mod_cast hn) (aRun_pos hN1 hβ)
  set q := Real.exp (-(c * σ * δ * t / 4)) with hqdef
  set A := Real.exp (-(Real.sqrt (c * c' * σ) * t / 2)) with hAdef
  have hq0 : 0 ≤ q := (Real.exp_pos _).le
  have hq1 : q < 1 := by
    rw [hqdef, ← Real.exp_zero]; exact Real.exp_lt_exp.2 (by nlinarith)
  set X := A * (q / (1 - q)) with hXdef
  have hX : 0 < X := mul_pos (Real.exp_pos _) (div_pos (Real.exp_pos _) (by linarith))
  set s : ℕ → ℝ := fun k => |μv g₀| * Real.exp (-((c * σ * R k + c' / R k) * t) / 2) with hsdef
  have hs0 : ∀ k, 0 ≤ s k := fun k => mul_nonneg (abs_nonneg _) (Real.exp_pos _).le
  have hdiag' : ∀ k, ∀ x ∈ shellN (hSN N n i) (φ g₀) F (aRun N β) R k,
      ‖kernelCLM (trivKN N β n i) C hkm hC0 hkb (hSN N n i) (hSN N n i) x‖ ≤ s k * ‖x‖ := by
    intro k x hx
    have h := hdiag k x hx
    have he : Real.exp (-((c * σ * R k + c' / R k) * t) / 2) ^ 2
        = Real.exp (-((c * σ * R k + c' / R k) * t)) := by
      rw [sq, ← Real.exp_add]; congr 1; ring
    have h2 : ‖kernelCLM (trivKN N β n i) C hkm hC0 hkb (hSN N n i) (hSN N n i) x‖ ^ 2
        ≤ (s k * ‖x‖) ^ 2 := by
      rw [hsdef]
      simp only
      rw [mul_pow, mul_pow, sq_abs, he]
      exact h
    exact le_of_pow_le_pow_left₀ two_ne_zero (mul_nonneg (hs0 k) (norm_nonneg _)) h2
  have hterm : ∀ k : ℕ, s k ≤ |μv g₀| * A * q ^ (k + 1) := by
    intro k
    have h1 := AttractCost.two_sqrt_le_cost hc hc' hσ (hR0 k)
    have h2 : c * σ * (((k : ℝ) + 1) * δ) ≤ c * σ * R k :=
      mul_le_mul_of_nonneg_left (hRδ k) (mul_nonneg hc hσ)
    have h3 : 0 ≤ c' / R k := div_nonneg hc' (hR0 k).le
    have hk : Real.sqrt (c * c' * σ) * t / 2 + ((k : ℝ) + 1) * (c * σ * δ * t / 4)
        ≤ (c * σ * R k + c' / R k) * t / 2 := by
      nlinarith [mul_le_mul_of_nonneg_right h1 htpos.le, mul_le_mul_of_nonneg_right h2 htpos.le,
        mul_nonneg h3 htpos.le]
    have hqk : q ^ (k + 1) = Real.exp (((k : ℝ) + 1) * (-(c * σ * δ * t / 4))) := by
      rw [hqdef, ← Real.exp_nat_mul]; push_cast; ring_nf
    rw [hsdef, mul_assoc]
    refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
    rw [hAdef, hqk, ← Real.exp_add, Real.exp_le_exp]
    nlinarith [hk]
  have hsum : ∀ F : Finset ℕ, ∑ l ∈ F, s l
      ≤ |μv g₀| * Real.exp (-(diagRate c c' σ δ t * t) / 2) := by
    intro F
    have hgeom : Summable fun l : ℕ => q ^ (l + 1) := by
      have := (summable_geometric_of_lt_one hq0 hq1).mul_left q
      refine this.congr fun l => ?_
      ring
    have htsum : ∑' l : ℕ, q ^ (l + 1) = q / (1 - q) := by
      have e : (fun l : ℕ => q ^ (l + 1)) = fun l => q * q ^ l := funext fun l => by ring
      rw [e, tsum_mul_left, tsum_geometric_of_lt_one hq0 hq1, div_eq_mul_inv]
    have hF : ∑ l ∈ F, q ^ (l + 1) ≤ q / (1 - q) := by
      rw [← htsum]
      exact hgeom.sum_le_tsum F (fun l _ => pow_nonneg hq0 _)
    have hrate : Real.exp (-(diagRate c c' σ δ t * t) / 2) = X := by
      unfold diagRate
      rw [← hqdef, ← hAdef, ← hXdef]
      have : -(-2 * Real.log X / t * t) / 2 = Real.log X := by field_simp
      rw [this, Real.exp_log hX]
    rw [hrate]
    calc ∑ l ∈ F, s l ≤ ∑ l ∈ F, |μv g₀| * A * q ^ (l + 1) := Finset.sum_le_sum fun l _ => hterm l
      _ = |μv g₀| * A * ∑ l ∈ F, q ^ (l + 1) := by rw [Finset.mul_sum]
      _ ≤ |μv g₀| * A * (q / (1 - q)) :=
          mul_le_mul_of_nonneg_left hF (mul_nonneg (abs_nonneg _) (Real.exp_pos _).le)
      _ = |μv g₀| * X := by rw [hXdef]; ring
  exact zeroFluxGap_of_shellDiagN hβ hn hL hm hkm hC0 hkb F hR hreach hgen s hs0 hdiag' hsum

/-- **The gap from the loop-shell pair bounds** (`SU(N)`): `FocusFeed.zeroFluxGap_of_shellPairs` on the `SU(N)`
loop shells. -/
theorem zeroFluxGap_of_shellPairsN {β : ℝ} (hβ : 0 < β) {n : ℕ} (hn : 0 < n) {i : Fin 4}
    {ι : Type*} {g₀ : ι} {E : ι → ℝ} {φ : ι → SliceN N n i → ℝ} {μv : ι → ℝ}
    (hL : EigenLevelsN N β n i g₀ E φ μv) (hm : ∀ j, Measurable (φ j))
    {C : ℝ} (hkm : Measurable (Function.uncurry (trivKN N β n i))) (hC0 : 0 ≤ C)
    (hkb : ∀ x y, |trivKN N β n i x y| ≤ C)
    (F : LoopFam) {R : ℕ → ℝ} (hR : Monotone R) (hreach : ∀ L : ℕ, ∃ k, aRun N β * (L : ℝ) ≤ R k)
    (hgen : ∀ j, j ≠ g₀ → vecOf (hm j) (hL.norm j)
      ∈ closure (Submodule.span ℝ (allLoopsN (hSN N n i) (φ g₀) F) : Set (Lp ℝ 2 (hSN N n i))))
    {c c' σ δ : ℝ} (hc : 0 ≤ c) (hc' : 0 ≤ c') (hσ : 0 ≤ σ) (hδ : 0 < c * σ * δ)
    (hR0 : ∀ k, 0 < R k) (hRδ : ∀ k : ℕ, ((k : ℝ) + 1) * δ ≤ R k)
    (κ : ℕ → Type*) [∀ k, Fintype (κ k)] (v : ∀ k, κ k → Lp ℝ 2 (hSN N n i))
    (hspan : ∀ k, shellN (hSN N n i) (φ g₀) F (aRun N β) R k ≤ Submodule.span ℝ (Set.range (v k)))
    (lam : ℕ → ℝ) (hlam : ∀ k, 0 < lam k)
    (hgram : ∀ k (a : κ k → ℝ), lam k * ∑ j, a j ^ 2 ≤ ‖∑ j, a j • v k j‖ ^ 2)
    (e : ℕ → ℝ)
    (he : ∀ k j l, |inner ℝ (kernelCLM (trivKN N β n i) C hkm hC0 hkb (hSN N n i) (hSN N n i) (v k j))
      (kernelCLM (trivKN N β n i) C hkm hC0 hkb (hSN N n i) (hSN N n i) (v k l))| ≤ e k)
    (hrate : ∀ k, (Fintype.card (κ k) : ℝ) * e k
      ≤ lam k * (μv g₀ ^ 2 * Real.exp (-((c * σ * R k + c' / R k) * ((n : ℝ) * aRun N β))))) :
    ZeroFluxGap g₀ E (diagRate c c' σ δ ((n : ℝ) * aRun N β)) := by
  refine zeroFluxGap_of_electricDiagN hβ hn hL hm hkm hC0 hkb F hR hreach hgen hc hc' hσ hδ hR0 hRδ ?_
  intro k x hx
  have h := FocusFeed.norm_sq_le_on_span _ (v k) (he k) (hlam k) (hgram k) x (hspan k hx)
  have hq : (Fintype.card (κ k) : ℝ) * e k / lam k
      ≤ μv g₀ ^ 2 * Real.exp (-((c * σ * R k + c' / R k) * ((n : ℝ) * aRun N β))) := by
    rw [div_le_iff₀ (hlam k), mul_comm _ (lam k)]
    exact hrate k
  exact h.trans (mul_le_mul_of_nonneg_right hq (sq_nonneg _))

/-- **The zero-flux ground weight is at most the zero-flux trace**: `e^{−E_{g₀} n a} ≤ hs(trivKN N)`. -/
theorem exp_ground_le_hsN {β : ℝ} (hβ : 0 ≤ β) {n : ℕ} {i : Fin 4} {ι : Type*} {g₀ : ι} {E : ι → ℝ}
    {φ : ι → SliceN N n i → ℝ} {μ : ι → ℝ} (hL : EigenLevelsN N β n i g₀ E φ μ) :
    Real.exp (-(E g₀ * ((n : ℝ) * aRun N β))) ≤ hs (hSN N n i) (trivKN N β n i) := by
  have hpos := CentreSectorSeedN.hs_trivKN_pos (N := N) hβ n i
  rw [hL.hs_eq] at hpos ⊢
  have hsum : Summable (fun j => Real.exp (-(E j * ((n : ℝ) * aRun N β)))) := by
    by_contra h
    rw [tsum_eq_zero_of_not_summable h] at hpos
    exact lt_irrefl _ hpos
  exact hsum.le_tsum g₀ (fun j _ => (Real.exp_pos _).le)

end Slice

/-! ## 4. The slice records -/

section Records

variable (N : ℕ) [NeZero N]

/-- **The control of one zero-flux slice at `SU(N)`, on the slice alone**: `MultiScale.SliceEnd` at `SU(N)`, its
shells built on the loop family `fam`, with the field `gen` added. -/
structure SliceEndN (c c' σ δ t₀ Cc : ℝ) (β : ℝ) (n : ℕ) (i : Fin 4) : Type 1 where
  /-- Index type of the levels. -/
  ι : Type
  /-- The ground level. -/
  g₀ : ι
  /-- The level energies. -/
  E : ι → ℝ
  /-- The eigenfunctions. -/
  φ : ι → SliceN N n i → ℝ
  /-- The eigenvalues. -/
  μ : ι → ℝ
  /-- Bookkeeping (spectral theorem, not in the tree): orthonormal eigenfunctions exhausting both traces. -/
  levels : EigenLevelsN N β n i g₀ E φ μ
  /-- Bookkeeping: each eigenfunction is measurable. -/
  meas : ∀ j, Measurable (φ j)
  /-- The loop family the shells are built on: `single` (one loop, `Re tr`) or `words` (products of `Re tr` and
  `Im tr` of loops). -/
  fam : LoopFam
  /-- `SU(N)` content: every excited zero-flux level lies in the closed span of the loop states
  `(W_L − ⟨W_L⟩) φ_{g₀}` of `fam`. On `single` it is proved at `N = 2`
  (`LoopsGenerate.excited_mem_closure_loops`) and fails at `N ≥ 3` on every `C`-odd excited level (the
  single-loop states are invariant under `U ↦ Ū`, `LoopsGenerateN.not_mem_closure_single_of_odd`). On `words`
  it follows at every `N` from the separation of gauge orbits by the complex traces of based loops
  (`LoopsGenerateN.excited_mem_closure_wordsN`). -/
  gen : ∀ j, j ≠ g₀ → vecOf (meas j) (levels.norm j)
    ∈ closure (Submodule.span ℝ (allLoopsN (hSN N n i) (φ g₀) fam) : Set (Lp ℝ 2 (hSN N n i)))
  /-- Bookkeeping: a bound of the kernel. -/
  C : ℝ
  kmeas : Measurable (Function.uncurry (trivKN N β n i))
  C0 : 0 ≤ C
  kbd : ∀ x y, |trivKN N β n i x y| ≤ C
  /-- Bookkeeping: the shell radii. -/
  R : ℕ → ℝ
  R_mono : Monotone R
  R_reach : ∀ L : ℕ, ∃ k, aRun N β * (L : ℝ) ≤ R k
  R_pos : ∀ k, 0 < R k
  R_step : ∀ k : ℕ, ((k : ℝ) + 1) * δ ≤ R k
  /-- Bookkeeping: a finite family spanning each shell. -/
  κ : ℕ → Type
  [κfin : ∀ k, Fintype (κ k)]
  v : ∀ k, κ k → Lp ℝ 2 (hSN N n i)
  span : ∀ k, shellN (hSN N n i) (φ g₀) fam (aRun N β) R k ≤ Submodule.span ℝ (Set.range (v k))
  /-- Bookkeeping: the Gram lower bound. -/
  lam : ℕ → ℝ
  lam_pos : ∀ k, 0 < lam k
  gram : ∀ k (a : κ k → ℝ), lam k * ∑ j, a j ^ 2 ≤ ‖∑ j, a j • v k j‖ ^ 2
  /-- The pair errors. -/
  η : ℕ → ℝ
  /-- Physics, open: the slice pair bound of the loop shells. -/
  pair : ∀ k j l,
    |inner ℝ (kernelCLM (trivKN N β n i) C kmeas C0 kbd (hSN N n i) (hSN N n i) (v k j))
      (kernelCLM (trivKN N β n i) C kmeas C0 kbd (hSN N n i) (hSN N n i) (v k l))| ≤ η k
  /-- Physics, open: the pair errors beat the number of pairs at the shell rate. -/
  rate : ∀ k, (Fintype.card (κ k) : ℝ) * η k
    ≤ lam k * (μ g₀ ^ 2 * Real.exp (-((c * σ * R k + c' / R k) * ((n : ℝ) * aRun N β))))
  /-- Physics, open: the count clause at the physical time `t₀`. -/
  count : ZeroFluxCount g₀ E t₀ Cc

/-- **The charged-flux trace in direction `ν`**: the summed trace of the sectors `ψ` of `Z_N³` with
`ψ(e_ν) ≠ 1`, for the transfer `halfKN N`. At `N = 2` it is `VortexAperture.oddFlux`. -/
def chargedFlux (β : ℝ) (n : ℕ) (i : Fin 4) (ν : Dir i) : ℝ :=
  VortexAperture.oddTrace (hSN N n i) (halfKN N β n i)
    (SliceCentreAction.act (μ := i) (T := Tr n i) (N := N)) (Pi.single ν 1)

/-- **The charged electric-flux sectors of the plane `(i, ν)` in their levels** (`SU(N)`), relative to the
zero-flux ground `E g₀`: `ScaleControlRun.OddLevels` at `SU(N)`. Eigenfunctions of the complex sector kernels
`FluxSectorFourier.sec` of `halfKN N` in sectors with `ψ(e_ν) ≠ 1`, orthonormal, eigenvalues
`λ_j² = e^{−F_j n a}` exhausting `chargedFlux` (bookkeeping, spectral theorem); the gap `F_j ≥ E g₀ + m` and the
count at `t₀` (physics, open). -/
structure FluxLevels (β : ℝ) (n : ℕ) (i : Fin 4) (ν : Dir i) {ι : Type} (g₀ : ι)
    (E : ι → ℝ) (m t₀ Co : ℝ) : Type 1 where
  /-- Index type of the charged levels. -/
  κ : Type
  /-- The sector character of each level. -/
  ψ : κ → AddChar (Cen i N) ℂ
  /-- The eigenfunctions. -/
  φ : κ → SliceN N n i → ℂ
  /-- The eigenvalues. -/
  lam : κ → ℝ
  /-- The level energies. -/
  F : κ → ℝ
  /-- Bookkeeping: each level lies in a sector charged under the twist `e_ν`. -/
  charged : ∀ j, ψ j (Pi.single ν 1) ≠ 1
  /-- Bookkeeping: orthonormal eigenfunctions of the charged sector kernels. -/
  norm : ∀ j, ∫ x, starRingEnd ℂ (φ j x) * φ j x ∂(hSN N n i) = 1
  orth : ∀ j k, j ≠ k → ∫ x, starRingEnd ℂ (φ j x) * φ k x ∂(hSN N n i) = 0
  eigen : ∀ j x, ∫ y, FluxSectorFourier.sec (halfKN N β n i)
      (SliceCentreAction.act (μ := i) (T := Tr n i) (N := N)) (ψ j) x y * φ j y
        ∂(hSN N n i) = (lam j : ℂ) * φ j x
  energy : ∀ j, lam j ^ 2 = Real.exp (-(F j * ((n : ℝ) * aRun N β)))
  /-- Bookkeeping: the levels exhaust the charged trace. -/
  trace : chargedFlux N β n i ν = ∑' j, Real.exp (-(F j * ((n : ℝ) * aRun N β)))
  /-- Physics, open: winding electric flux costs at least `m` above the zero-flux ground. -/
  gap : ∀ j, E g₀ + m ≤ F j
  /-- Physics, open: the charged heat trace at `t₀`, relative to the zero-flux ground, is at most `Co`. -/
  count_summable : Summable (fun j => Real.exp (-((F j - E g₀) * t₀)))
  count : ∑' j, Real.exp (-((F j - E g₀) * t₀)) ≤ Co

/-- **One slice of the `SU(N)` endpoint**: a `SliceEndN` record and, for every transverse `ν`, the charged levels
on the same zero-flux levels. -/
structure EndRunN (c c' σ δ t₀ Cc m Co : ℝ) (β : ℝ) (n : ℕ) (i : Fin 4) : Type 1 where
  core : SliceEndN N c c' σ δ t₀ Cc β n i
  flux : ∀ ν : Dir i, FluxLevels N β n i ν core.g₀ core.E m t₀ Co

/-- **The `SU(N)` endpoint at the window `[2ℓ, 5ℓ]`**: sign conditions and, eventually in `β`, an `EndRunN` at
every power-of-two side `n ≥ 2` with `n a ∈ [2ℓ, 5ℓ]` and every step. -/
structure EndpointNAt (c c' σ δ t₀ Cc m Co ℓ : ℝ) : Prop where
  c_nonneg : 0 ≤ c
  c'_nonneg : 0 ≤ c'
  σ_nonneg : 0 ≤ σ
  step_pos : 0 < c * σ * δ
  t₀_nonneg : 0 ≤ t₀
  t₀_le : t₀ ≤ 2 * ℓ
  slices : ∀ᶠ β in atTop, ∀ n : ℕ, PeriodicState.IsPow2 n → 2 ≤ n →
    2 * ℓ ≤ (n : ℝ) * aRun N β → (n : ℝ) * aRun N β ≤ 5 * ℓ → ∀ i : Fin 4,
      Nonempty (EndRunN N c c' σ δ t₀ Cc m Co β n i)

/-- **The strong-coupling end at `SU(N)`**: constants fixed once, a positive zero-flux rate at `ℓ₀ > 0`, a
positive charged gap `m`, and `EndpointNAt` frequently in `ℓ`. -/
def EndpointN : Prop :=
  ∃ c c' σ δ t₀ Cc m Co ℓ₀ : ℝ, 0 < ℓ₀ ∧ 0 < diagRate c c' σ δ (2 * ℓ₀) ∧ 0 < m ∧ 0 ≤ Cc ∧
    0 ≤ Co ∧ ∃ᶠ ℓ in atTop, EndpointNAt N c c' σ δ t₀ Cc m Co ℓ

end Records

/-! ## 5. The two halves and the run seed -/

section Run

variable {N : ℕ} [NeZero N]

/-- **One slice record gives the zero-flux gap** at `diagRate c c' σ δ (n a)`. -/
theorem SliceEndN.gap {c c' σ δ t₀ Cc β : ℝ} {n : ℕ} {i : Fin 4} (S : SliceEndN N c c' σ δ t₀ Cc β n i)
    (hβ : 0 < β) (hn : 0 < n) (hc : 0 ≤ c) (hc' : 0 ≤ c') (hσ : 0 ≤ σ) (hδ : 0 < c * σ * δ) :
    ZeroFluxGap S.g₀ S.E (diagRate c c' σ δ ((n : ℝ) * aRun N β)) := by
  letI := S.κfin
  exact zeroFluxGap_of_shellPairsN hβ hn S.levels S.meas S.kmeas S.C0 S.kbd S.fam S.R_mono S.R_reach S.gen
    hc hc' hσ hδ S.R_pos S.R_step S.κ S.v S.span S.lam S.lam_pos S.gram S.η S.pair S.rate

/-- **(V) on one slice from the charged levels**: `1 − Z_{e_ν}/Z ≤ 2 Co e^{m t₀} e^{−m n a}`. -/
theorem one_sub_twistRatioN_le_of_fluxLevels {β : ℝ} (hβ : 0 ≤ β) {n : ℕ} {i : Fin 4} (ν : Dir i)
    {ι : Type} {g₀ : ι} {E : ι → ℝ} {φ : ι → SliceN N n i → ℝ} {μ : ι → ℝ}
    (hL : EigenLevelsN N β n i g₀ E φ μ) {m t₀ Co : ℝ} (O : FluxLevels N β n i ν g₀ E m t₀ Co)
    (ht : t₀ ≤ (n : ℝ) * aRun N β) :
    1 - twistRatioN N β n i (Pi.single ν 1)
      ≤ 2 * Co * Real.exp (m * t₀) * Real.exp (-(m * ((n : ℝ) * aRun N β))) := by
  rw [TwistDeficitUnionN.one_sub_twistRatioN (N := N) hβ n i]
  have hD := deficit_le_two_oddTrace (CentreSectorSeedN.bdd_halfKN (N := N) hβ n i)
    (CentreSectorSeedN.symm_halfKN (N := N) hβ n i) SliceCentreAction.centreAction
    (Pi.single ν 1 : Cen i N)
  have hH := CentreSectorSeedN.hs_halfKN_pos (N := N) hβ n i
  have hle := CentreSectorSeedN.hs_trivKN_le (N := N) hβ n i
  have hG := exp_ground_le_hsN hβ hL
  have hO : chargedFlux N β n i ν ≤ Real.exp (-(E g₀ * ((n : ℝ) * aRun N β)))
      * (Co * Real.exp (m * t₀) * Real.exp (-(m * ((n : ℝ) * aRun N β)))) := by
    rw [O.trace]
    exact ScaleControlRun.tsum_odd_le O.gap O.count_summable O.count ht
  have hCo : 0 ≤ Co := (tsum_nonneg fun j => (Real.exp_pos _).le).trans O.count
  have hR : 0 ≤ Co * Real.exp (m * t₀) * Real.exp (-(m * ((n : ℝ) * aRun N β))) := by positivity
  have hD' : TwistDeficitUnionN.deficit (hSN N n i) (halfKN N β n i)
      (SliceCentreAction.act (μ := i) (T := Tr n i) (N := N)) (Pi.single ν 1)
      ≤ 2 * chargedFlux N β n i ν := hD
  rw [div_le_iff₀ hH]
  have := mul_le_mul_of_nonneg_right (hG.trans hle) hR
  nlinarith

/-- **The zero-flux half at the window**: `UniformGlueball N (diagRate c c' σ δ (2ℓ)) t₀ Cc ℓ` (`ℓ > 0`). -/
theorem uniformGlueball_of_endpointNAt {c c' σ δ t₀ Cc m Co ℓ : ℝ} (hℓ : 0 < ℓ)
    (h : EndpointNAt N c c' σ δ t₀ Cc m Co ℓ) :
    UniformGlueball N (diagRate c c' σ δ (2 * ℓ)) t₀ Cc ℓ := by
  filter_upwards [h.slices, eventually_gt_atTop (0 : ℝ)] with β hS hβ n hn h2 hlo hhi i
  obtain ⟨S⟩ := hS n hn h2 hlo hhi i
  have hn0 : 0 < n := by omega
  have h2ℓ : 0 < 2 * ℓ := by linarith
  have hg := S.core.gap hβ hn0 h.c_nonneg h.c'_nonneg h.σ_nonneg h.step_pos
  exact ⟨S.core.ι, S.core.g₀, S.core.E, S.core.levels.zeroFluxLevels,
    ScaleControl.zeroFluxGap_mono hg (ScaleControl.diagRate_mono h.step_pos h2ℓ hlo), S.core.count⟩

/-- **(T) at the window**: `HiddenCostAt N m (2 Cc e^{m t₀}) ℓ`, `m = diagRate c c' σ δ (2ℓ)` (`ℓ > 0`). -/
theorem hiddenCostAt_of_endpointNAt {c c' σ δ t₀ Cc m Co ℓ : ℝ} (hℓ : 0 < ℓ)
    (h : EndpointNAt N c c' σ δ t₀ Cc m Co ℓ) :
    ObserverTheory.HiddenCostAt N (diagRate c c' σ δ (2 * ℓ))
      (2 * Cc * Real.exp (diagRate c c' σ δ (2 * ℓ) * t₀)) ℓ :=
  GlueballArea.hiddenCostAt_of_uniformGlueball h.t₀_nonneg h.t₀_le (uniformGlueball_of_endpointNAt hℓ h)

/-- **(V) at the window**: `PlaneCostAt N m (2 Co e^{m t₀}) ℓ`. -/
theorem planeCostAt_of_endpointNAt {c c' σ δ t₀ Cc m Co ℓ : ℝ}
    (h : EndpointNAt N c c' σ δ t₀ Cc m Co ℓ) :
    FluxCost.PlaneCostAt N m (2 * Co * Real.exp (m * t₀)) ℓ := by
  filter_upwards [h.slices, eventually_ge_atTop (0 : ℝ)] with β hS hβ0 n hn h2 hlo hhi i ν
  obtain ⟨R⟩ := hS n hn h2 hlo hhi i
  exact one_sub_twistRatioN_le_of_fluxLevels hβ0 ν R.core.levels (R.flux ν) (h.t₀_le.trans hlo)

/-- `HiddenCostAt N` at a smaller rate and a larger constant. -/
theorem hiddenCostAt_weaken {σ σ' A A' ℓ : ℝ} (hσ : σ' ≤ σ) (hA0 : 0 ≤ A) (hA : A ≤ A')
    (h : ObserverTheory.HiddenCostAt N σ A ℓ) : ObserverTheory.HiddenCostAt N σ' A' ℓ := by
  have hN1 : 1 ≤ N := Nat.one_le_iff_ne_zero.mpr (NeZero.ne N)
  filter_upwards [h, eventually_gt_atTop (0 : ℝ)] with β hβ hβ0 n hn h2 hlo hup i
  have hx : 0 ≤ (n : ℝ) * aRun N β := mul_nonneg (Nat.cast_nonneg n) (aRun_pos hN1 hβ0).le
  have he : Real.exp (-(σ * ((n : ℝ) * aRun N β))) ≤ Real.exp (-(σ' * ((n : ℝ) * aRun N β))) :=
    Real.exp_le_exp.2 (by nlinarith)
  refine (hβ n hn h2 hlo hup i).trans ?_
  calc A * Real.exp (-(σ * ((n : ℝ) * aRun N β))) ≤ A * Real.exp (-(σ' * ((n : ℝ) * aRun N β))) :=
        mul_le_mul_of_nonneg_left he hA0
    _ ≤ A' * Real.exp (-(σ' * ((n : ℝ) * aRun N β))) :=
        mul_le_mul_of_nonneg_right hA (Real.exp_pos _).le

/-- `PlaneCostAt N` at a smaller rate and a larger constant. -/
theorem planeCostAt_weaken {σ σ' A A' ℓ : ℝ} (hσ : σ' ≤ σ) (hA0 : 0 ≤ A) (hA : A ≤ A')
    (h : FluxCost.PlaneCostAt N σ A ℓ) : FluxCost.PlaneCostAt N σ' A' ℓ := by
  have hN1 : 1 ≤ N := Nat.one_le_iff_ne_zero.mpr (NeZero.ne N)
  filter_upwards [h, eventually_gt_atTop (0 : ℝ)] with β hβ hβ0 n hn h2 hlo hup i ν
  have hx : 0 ≤ (n : ℝ) * aRun N β := mul_nonneg (Nat.cast_nonneg n) (aRun_pos hN1 hβ0).le
  have he : Real.exp (-(σ * ((n : ℝ) * aRun N β))) ≤ Real.exp (-(σ' * ((n : ℝ) * aRun N β))) :=
    Real.exp_le_exp.2 (by nlinarith)
  refine (hβ n hn h2 hlo hup i ν).trans ?_
  calc A * Real.exp (-(σ * ((n : ℝ) * aRun N β))) ≤ A * Real.exp (-(σ' * ((n : ℝ) * aRun N β))) :=
        mul_le_mul_of_nonneg_left he hA0
    _ ≤ A' * Real.exp (-(σ' * ((n : ℝ) * aRun N β))) :=
        mul_le_mul_of_nonneg_right hA (Real.exp_pos _).le

/-- **The gap input at `SU(N)` from the endpoint**: `EndpointN N → WDeltaRun.RunSeed N`, through
`FluxCost.runSeed_iff_bindingPlane`. -/
theorem runSeed_of_endpointN (h : EndpointN N) : WDeltaRun.RunSeed N := by
  obtain ⟨c, c', σ, δ, t₀, Cc, m, Co, ℓ₀, hℓ₀, hpos, hm, hCc, hCo, hfr⟩ := h
  set Mx := Real.sqrt (c * c' * σ) + c * σ * δ / 2
  refine (FluxCost.runSeed_iff_bindingPlane N).2
    ⟨min (diagRate c c' σ δ (2 * ℓ₀)) m,
      max (2 * Cc * Real.exp (Mx * t₀)) (2 * Co * Real.exp (m * t₀)), lt_min hpos hm, ?_⟩
  refine (hfr.and_eventually (eventually_ge_atTop ℓ₀)).mono fun ℓ ⟨hR, hℓ⟩ => ⟨?_, ?_⟩
  · exact planeCostAt_weaken (min_le_right _ _) (by positivity) (le_max_right _ _)
      (planeCostAt_of_endpointNAt hR)
  · have hℓ0 : 0 < ℓ := by linarith
    have h2ℓ₀ : 0 < 2 * ℓ₀ := by linarith
    have h2ℓ : 0 < 2 * ℓ := by linarith
    have hmono := ScaleControl.diagRate_mono (c' := c') hR.step_pos h2ℓ₀ (by linarith : 2 * ℓ₀ ≤ 2 * ℓ)
    have hsup := ScaleControlRun.diagRate_le_sup (c' := c') h2ℓ hR.step_pos
    have hA : 2 * Cc * Real.exp (diagRate c c' σ δ (2 * ℓ) * t₀) ≤ 2 * Cc * Real.exp (Mx * t₀) :=
      mul_le_mul_of_nonneg_left
        (Real.exp_le_exp.2 (mul_le_mul_of_nonneg_right hsup hR.t₀_nonneg)) (by positivity)
    exact hiddenCostAt_weaken ((min_le_left _ _).trans hmono) (by positivity)
      (hA.trans (le_max_left _ _)) (hiddenCostAt_of_endpointNAt hℓ0 hR)

end Run

/-! ## 6. `N = 2`: the `SU(2)` endpoint is an instance -/

section Two

open MassGap.MultiScale (SliceEnd EndRun EndpointAt Endpoint)
open MassGap.ScaleControlRun (OddLevels)

/-- **`SliceEnd` gives `SliceEndN 2`** (`β > 0`, `n > 0`) on the family `single`: `gen` is
`LoopsGenerate.excited_mem_closure_loops`; the shells and loop states are those of `ElectricLoops` (`shellN_two`,
`allLoopsN_two`). -/
def _root_.MassGap.MultiScale.SliceEnd.toN {c c' σ δ t₀ Cc β : ℝ} {n : ℕ} {i : Fin 4} (hβ : 0 < β)
    (hn : 0 < n) (S : SliceEnd c c' σ δ t₀ Cc β n i) : SliceEndN 2 c c' σ δ t₀ Cc β n i where
  ι := S.ι
  g₀ := S.g₀
  E := S.E
  φ := S.φ
  μ := S.μ
  levels := eigenLevelsN_two S.levels
  meas := S.meas
  fam := .single
  gen := by
    rw [allLoopsN_two]
    have hpos : ∀ j : {j : Fin 4 // j ≠ i}, 0 < CentreSectorSeed.Tr n i j := fun j => by
      simp only [CentreSectorSeed.Tr, RectWilson.tr, DoublingWilson.ext]
      positivity
    exact MassGap.LoopsGenerate.excited_mem_closure_loops hβ S.levels S.meas (fun j => ⟨0, hpos j⟩)
  C := S.C
  kmeas := S.kmeas
  C0 := S.C0
  kbd := S.kbd
  R := S.R
  R_mono := S.R_mono
  R_reach := S.R_reach
  R_pos := S.R_pos
  R_step := S.R_step
  κ := S.κ
  κfin := S.κfin
  v := S.v
  span := by rw [shellN_two]; exact S.span
  lam := S.lam
  lam_pos := S.lam_pos
  gram := S.gram
  η := S.η
  pair := S.pair
  rate := S.rate
  count := S.count

/-- Every element of `Z₂³` has order two. -/
theorem cen_two_add_self {i : Fin 4} (g : Cen i 2) : g + g = 0 := by
  funext j
  simp only [Pi.add_apply, Pi.zero_apply]
  generalize g j = x
  revert x
  decide

/-- **`OddLevels` gives `FluxLevels 2`**: the real eigenfunctions of the real sector kernels as complex
eigenfunctions of the complex ones (`ElectricLoops.sec_eq_rsec`: the characters of `Z₂³` are real). -/
def _root_.MassGap.ScaleControlRun.OddLevels.toN {β : ℝ} {n : ℕ} {i : Fin 4} {ν : Dir i} {ι : Type}
    {g₀ : ι} {E : ι → ℝ} {m t₀ Co : ℝ} (O : OddLevels β n i ν g₀ E m t₀ Co) :
    FluxLevels 2 β n i ν g₀ E m t₀ Co where
  κ := O.κ
  ψ := O.ψ
  φ := fun j x => (O.φ j x : ℂ)
  lam := O.lam
  F := O.F
  charged := O.odd
  norm j := by
    have h : (fun x => starRingEnd ℂ ((O.φ j x : ℝ) : ℂ) * ((O.φ j x : ℝ) : ℂ))
        = fun x => ((O.φ j x * O.φ j x : ℝ) : ℂ) := funext fun x => by
      rw [Complex.conj_ofReal]; push_cast; rfl
    rw [h, integral_complex_ofReal, O.norm j, Complex.ofReal_one]
  orth j k hjk := by
    have h : (fun x => starRingEnd ℂ ((O.φ j x : ℝ) : ℂ) * ((O.φ k x : ℝ) : ℂ))
        = fun x => ((O.φ j x * O.φ k x : ℝ) : ℂ) := funext fun x => by
      rw [Complex.conj_ofReal]; push_cast; rfl
    rw [h, integral_complex_ofReal, O.orth j k hjk, Complex.ofReal_zero]
  eigen j x := by
    have hre : ∀ g, (O.ψ j g).im = 0 := fun g => by
      rcases VortexAperture.char_two_torsion (O.ψ j) (cen_two_add_self g) with h | h <;> simp [h]
    have h : (fun y => FluxSectorFourier.sec (halfKN 2 β n i)
        (SliceCentreAction.act (μ := i) (T := Tr n i) (N := 2)) (O.ψ j) x y * ((O.φ j y : ℝ) : ℂ))
        = fun y => ((ElectricLoops.rsec (halfKN 2 β n i)
          (SliceCentreAction.act (μ := i) (T := Tr n i) (N := 2)) (O.ψ j) x y * O.φ j y : ℝ) : ℂ) :=
      funext fun y => by rw [ElectricLoops.sec_eq_rsec hre]; push_cast; rfl
    rw [h, integral_complex_ofReal, O.eigen j x]
    push_cast
    rfl
  energy := O.energy
  trace := O.trace
  gap := O.gap
  count_summable := O.count_summable
  count := O.count

/-- **The `SU(2)` endpoint is the `SU(N)` endpoint at `N = 2`**: `MultiScale.Endpoint → EndpointN 2`. -/
theorem endpointN_two_of_endpoint (h : Endpoint) : EndpointN 2 := by
  obtain ⟨c, c', σ, δ, t₀, Cc, m, Co, ℓ₀, h1, h2, h3, h4, h5, hf⟩ := h
  refine ⟨c, c', σ, δ, t₀, Cc, m, Co, ℓ₀, h1, h2, h3, h4, h5, hf.mono fun ℓ hℓ => ?_⟩
  exact
    { c_nonneg := hℓ.c_nonneg
      c'_nonneg := hℓ.c'_nonneg
      σ_nonneg := hℓ.σ_nonneg
      step_pos := hℓ.step_pos
      t₀_nonneg := hℓ.t₀_nonneg
      t₀_le := hℓ.t₀_le
      slices := by
        filter_upwards [hℓ.slices, eventually_gt_atTop (0 : ℝ)] with β hS hβ n hn h2 hlo hhi i
        obtain ⟨R⟩ := hS n hn h2 hlo hhi i
        exact ⟨⟨R.core.toN hβ (by omega), fun ν => (R.odd ν).toN⟩⟩ }

end Two

end MassGap.RunSeedN

end

