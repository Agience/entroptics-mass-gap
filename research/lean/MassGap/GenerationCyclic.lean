  MassGap.MixConvRP MassGap.MultiScaleAll MassGap.CompositesRen MassGap.CompositesRenAll
  MassGap.MultiScaleOS MassGap.ApproxFromExpand MassGap.StrongExpand MassGap.CovFromFlow
  MassGap.SU2Best MassGap.NondegFromProxy MassGap.NonGaussFromScale
  MassGap.ProxyGenObserver MassGap.ProxyBoundFromScale MassGap.ObserverFlowSUN MassGap.FlowChoice
  MassGap.ProxyGenLimN MassGap.FlowCovN MassGap.ApproxJoint MassGap.ClayNarrow
  MassGap.ObserverMultigrid MassGap.ClayNarrowMG MassGap.ScalePC MassGap.ScalePM MassGap.ClusterRoute

variable {N : ℕ}

/-- **The observer is cyclic at the capstone's joint data**: `ObserverCyclic` of `capData` at the
renormalised composites `CRen N z μ`, for some `ClassMoments` and `CompOS` witnesses. DERIVED: `0` the
plane. -/
def ObserverCyclicCL (hN2 : 2 ≤ N) [NeZero N] (W : ConfFlow N) {r : ℝ}
    (hphys : (Φ0 W).PhysRange r) (z : Chan → ℕ → ℝ) (μ : OffMix) : Prop :=
  ∃ (t C : ℝ) (hU : ClassMoments (NeZero.ne N) W (SymPlaqClass N) t C)
    (hCO : CompOS (NeZero.ne N) (CRen N z μ)),
    ObserverCyclic (capData hN2 W hU hphys (CRen N z μ)
      (unifLocal_buildRen (rhoD (fR N) z) (bareD (fR N) (bR N)) μ) (reflCovLat_CRen z μ) hCO)

/-- **The generation clause from cyclicity** (`cyclic_iff_forall`). DERIVED: `2` the least colour
count; `0` the plane. -/
theorem generation_of_cyclic (hN2 : 2 ≤ N) [NeZero N] {W : ConfFlow N} {r : ℝ}
    {hphys : (Φ0 W).PhysRange r} {z : Chan → ℕ → ℝ} {μ : OffMix}
    (h : ObserverCyclicCL hN2 W hphys z μ) :
    ∀ P : TSepG (CRen N z μ).Ix 0, BeyondR r P → ApproxKAt (kernC (NeZero.ne N) (CRen N z μ) 0)
      (mixKG hN2 W (CRen N z μ) r) (gramF hN2 W r) P := by
  obtain ⟨t, C, hU, hCO, hc⟩ := h
  intro P _
  exact (cyclic_iff_forall _).1 hc P

/-- **Cyclicity from the generation clause**, under the cluster route's core (`exists_beyond_iterate`,
`cyclic_iff_beyond`). DERIVED: `2` the least colour count; `0` the plane and the reference step. -/
theorem cyclic_of_generation (hN2 : 2 ≤ N) [NeZero N] {W : ConfFlow N} {z : Chan → ℕ → ℝ}
    {μ : OffMix} {b r : ℝ} {Wf : ℝ → ConfFlow N} {cf : Ix0 → ℝ → (MIx →₀ ℝ)}
    (S : SubstrateCoreCL W z b Wf) (hE : ExpandStrong Wf cf z μ) (hcl : ClusterPM Wf cf)
    (hV : CovC (NeZero.ne N) (CRen N z μ)) (hP : CompNondeg (NeZero.ne N) (CRen N z μ))
    (hphys : (Φ0 W).PhysRange r)
    (hB : ∀ P : TSepG (CRen N z μ).Ix 0, BeyondR r P → ApproxKAt (kernC (NeZero.ne N) (CRen N z μ) 0)
      (mixKG hN2 W (CRen N z μ) r) (gramF hN2 W r) P) :
    ObserverCyclicCL hN2 W hphys z μ := by
  obtain ⟨t, C, ht, hS⟩ := uv_of_chan S.b_pos S.top S.scale
  have hU := ClaySUFinal.classMoments_of_siteExp (NeZero.ne N) W ht hS
  have hCO := compOS_of_covC_cl S hE hcl hV hP
  refine ⟨_, _, hU, hCO, ?_⟩
  refine (cyclic_iff_beyond _ (fun P => BeyondR r P) fun P => ?_).2 hB
  obtain ⟨n, hn⟩ := exists_beyond_iterate (NeZero.ne N) r P
  exact ⟨0, n, hn⟩

/-- **`NarrowInputsAtCL` with the generation clause replaced by cyclicity of the observer.**
DERIVED: `2` the least colour count; `0` the plane. -/
def NarrowCyclicAtCL (N : ℕ) (hN2 : 2 ≤ N) (W : ConfFlow N) (r : ℝ) : Prop :=
  haveI : NeZero N := ⟨by omega⟩
  ∃ (hphys : (Φ0 W).PhysRange r) (zri zwe : ℕ → ℝ) (_ : ∀ k, zri k ≠ 0) (_ : ∀ k, zwe k ≠ 0)
    (μ : OffMix) (b : ℝ) (Wf : ℝ → ConfFlow N) (cf : Ix0 → ℝ → (MIx →₀ ℝ)),
    SubstrateCoreCL W (ZCanon.zFix N zri zwe) b Wf
      ∧ ExpandStrong Wf cf (ZCanon.zFix N zri zwe) μ
      ∧ ClusterPM Wf cf
      ∧ CovC (NeZero.ne N) (CRen N (ZCanon.zFix N zri zwe) μ)
      ∧ WardT (NeZero.ne N) (rhoD (fR N) (ZCanon.zFix N zri zwe))
      ∧ CompNondeg (NeZero.ne N) (CRen N (ZCanon.zFix N zri zwe) μ)
      ∧ ObserverCyclicCL hN2 W hphys (ZCanon.zFix N zri zwe) μ
      ∧ (∃ ℓ : ℝ, 0 < ℓ ∧ ThreePointAtScale (ne_zero_of_two_le hN2) ℓ)
      ∧ RunSeedN.EndpointN N

/-- **The cyclic bundle is the narrow bundle.** DERIVED: `2` the least colour count. -/
theorem narrowAtCL_iff_cyclic (hN2 : 2 ≤ N) {W : ConfFlow N} {r : ℝ} :
    NarrowCyclicAtCL N hN2 W r ↔ NarrowInputsAtCL N hN2 W r := by
  haveI : NeZero N := ⟨by omega⟩
  constructor
  · rintro ⟨hphys, zri, zwe, hri, hwe, μ, b, Wf, cf, S, hE, hcl, hV, hW, hP, hC, h3, hEnd⟩
    exact ⟨hphys, zri, zwe, hri, hwe, μ, b, Wf, cf, S, hE, hcl, hV, hW, hP,
      generation_of_cyclic hN2 hC, h3, hEnd⟩
  · rintro ⟨hphys, zri, zwe, hri, hwe, μ, b, Wf, cf, S, hE, hcl, hV, hW, hP, hB, h3, hEnd⟩
    exact ⟨hphys, zri, zwe, hri, hwe, μ, b, Wf, cf, S, hE, hcl, hV, hW, hP,
      cyclic_of_generation hN2 S hE hcl hV hP hphys hB, h3, hEnd⟩

end Capstone

end MassGap.GenerationCyclic

