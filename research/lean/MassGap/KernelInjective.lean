import Mathlib
import MassGap.CharacterExpansion
import MassGap.SUN

/-!
# MassGap.KernelInjective — the crossing form of a Wilson link kernel is definite

For a compact space `X`, a finite family of continuous real coordinates `φ : P → X → ℝ` that
separates the points of `X`, and `β > 0`, the crossing form

    crossForm μ φ β f = ∫∫ f(x) f(y) exp (β ∑ₚ φₚ(x) φₚ(y)) dμ(x) dμ(y)

vanishes on a continuous `f` only at `f = 0`, for every finite measure `μ` that charges every
nonempty open set (`crossForm_eq_zero_iff`). No representation theory enters: the role of the
characters is played by monomials in the coordinates, and the role of Peter–Weyl by
Stone–Weierstrass.

## The route

* `coordKernel_pow`: `(∑ₚ φₚ(x) φₚ(y))ᵏ = ∑_α pmono φ α x · pmono φ α y`, the sum running over all
  `α : Fin k → P`, with `pmono φ α = ∏ₜ φ_{α t}`. Every monomial of degree `k` in the coordinates
  appears, as a product of the same function of `x` and of `y`, with coefficient one; no sign enters,
  so no cancellation between terms is possible.
* `hasSum_crossForm`: the exponential series and dominated convergence on `μ.prod μ` give
  `crossForm μ φ β f = ∑ₖ (βᵏ / k!) · ∑_α (∫ f · pmono φ α dμ)²`.
* `moment_eq_zero`: at `β > 0` every coefficient is positive, so a vanishing form kills every
  moment `∫ f · pmono φ α dμ`.
* `coordAlg`, the subalgebra of `C(X, ℝ)` generated by the coordinates, separates points
  (`coordAlg_separatesPoints`) and is spanned by the monomials (`mem_closure_coords`), so
  `ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints` makes the monomials dense.
  Integration against `f` is a continuous linear functional (`continuous_pairLin`) vanishing on the
  monomials, hence on `f` itself: `∫ f² dμ = 0`. A continuous function vanishing `μ`-a.e. vanishes
  (`Measure.eq_of_ae_eq`, open-positivity of `μ`).
* `weighted_crossForm_eq_zero_iff`: the same with `f` replaced by `w · f`, `w` continuous and nowhere
  zero. A transfer kernel `w(x)^{1/2} K(x, y) w(y)^{1/2}` has form `crossForm μ φ β (w^{1/2} f)`.

## Instances on `SU(N)`

* `link_form_eq_zero_iff`: one link. `X = SU N`, `μ = probHaar (SU N)`, the coordinates the real and
  imaginary parts of the matrix entries (`suCoord`), and the kernel `exp (β · Re tr (u vᴴ))`. For `v`
  in `SU N`, `vᴴ = v⁻¹`, so this is the single-link Wilson crossing kernel `exp (β Re tr (u v⁻¹))`.
* `plane_form_eq_zero_iff`: a finite family `ι` of crossing links on one torus. `X = ι → SU N` with
  the product Haar measure and the kernel `∏ₗ exp (β · Re tr (U_l V_lᴴ))`.

What this is, in the ledger: a component of `TorusCapstone.TorusRefPos` (the definiteness of the
link-plane crossing kernel on one torus at fixed extent), not of the pinned `ExistencePos.LagOnePos`,
which is stated in the infinite-volume state, and not a discharge of `TorusRefPos`. It gives no
constant uniform in the extent. On a periodic torus the lag-one reflected form crosses two slabs, so
it is the `plane_form_eq_zero_iff` instance with `ι` the spatial links of both crossing slices.

Foundational footprint only (`#print axioms` at the end).
Build: `python code/lean_build.py build MassGap.KernelInjective`.
-/

namespace MassGap.KernelInjective

open MeasureTheory Set
open MassGap.CharacterExpansion

/-! ## 1. A general compact space with separating coordinates -/

section General

variable {X : Type*} {P : Type*}

/-- The coordinate kernel `∑ₚ φₚ(x) φₚ(y)`.

DERIVED: no numeral appears in the statement. -/
noncomputable def coordKernel [Fintype P] (φ : P → X → ℝ) (x y : X) : ℝ := ∑ p, φ p x * φ p y

/-- The monomial `∏ₜ φ_{α t}` of degree `k` in the coordinates.

DERIVED: no numeral appears in the statement. -/
noncomputable def pmono (φ : P → X → ℝ) {k : ℕ} (α : Fin k → P) (x : X) : ℝ := ∏ t, φ (α t) x

/-- The `k`-th power of the coordinate kernel is the sum, over every `α : Fin k → P`, of
`pmono φ α x · pmono φ α y`, each with coefficient one.

DERIVED: no numeral appears in the statement. -/
theorem coordKernel_pow [Fintype P] (φ : P → X → ℝ) (k : ℕ) (x y : X) :
    coordKernel φ x y ^ k = ∑ α : Fin k → P, pmono φ α x * pmono φ α y := by
  unfold coordKernel
  rw [Fintype.sum_pow]
  refine Finset.sum_congr rfl (fun α _ => ?_)
  unfold pmono
  rw [← Finset.prod_mul_distrib]

/-- The crossing form `∫∫ f(x) f(y) exp (β · coordKernel φ x y)` over `μ.prod μ`.

DERIVED: no numeral appears in the statement. -/
noncomputable def crossForm [Fintype P] [MeasurableSpace X] (μ : Measure X) (φ : P → X → ℝ) (β : ℝ) (f : X → ℝ) : ℝ :=
  ∫ z, f z.1 * f z.2 * Real.exp (β * coordKernel φ z.1 z.2) ∂(μ.prod μ)

/-- The order-`k` sum of squares `∑_α (∫ f · pmono φ α dμ)²`.

DERIVED: the `2` is the exponent of the square. -/
noncomputable def orderTerm [Fintype P] [MeasurableSpace X] (μ : Measure X) (φ : P → X → ℝ) (f : X → ℝ) (k : ℕ) : ℝ :=
  ∑ α : Fin k → P, (∫ x, f x * pmono φ α x ∂μ) ^ 2

theorem orderTerm_nonneg [Fintype P] [MeasurableSpace X] (μ : Measure X) (φ : P → X → ℝ) (f : X → ℝ) (k : ℕ) :
    0 ≤ orderTerm μ φ f k :=
  Finset.sum_nonneg (fun _ _ => sq_nonneg _)

/-- A continuous real function on a compact space is integrable for a finite measure. -/
theorem integrable_of_continuous {Y : Type*} [TopologicalSpace Y] [CompactSpace Y]
    [MeasurableSpace Y] [OpensMeasurableSpace Y] {ν : Measure Y} [IsFiniteMeasure ν]
    {g : Y → ℝ} (hg : Continuous g) : Integrable g ν := by
  obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hg.continuousOn
  exact Integrable.of_bound hg.aestronglyMeasurable C (ae_of_all _ fun x => hC x (mem_univ x))

theorem continuous_pmono [TopologicalSpace X] {φ : P → X → ℝ} (hφ : ∀ p, Continuous (φ p))
    {k : ℕ} (α : Fin k → P) : Continuous (pmono φ α) :=
  continuous_finsetProd _ (fun t _ => hφ (α t))

theorem continuous_coordKernel [TopologicalSpace X] [Fintype P] {φ : P → X → ℝ}
    (hφ : ∀ p, Continuous (φ p)) : Continuous (fun z : X × X => coordKernel φ z.1 z.2) :=
  continuous_finsetSum _
    (fun p _ => ((hφ p).comp continuous_fst).mul ((hφ p).comp continuous_snd))

section Series

variable [TopologicalSpace X] [CompactSpace X] [SecondCountableTopology X] [MeasurableSpace X]
  [BorelSpace X] [Fintype P]

/-- The order-`k` part of the crossing form is `wilsonCoef β k` times the order-`k` sum of squares.

DERIVED: no numeral appears in the statement. -/
theorem integral_order (μ : Measure X) [IsFiniteMeasure μ] {φ : P → X → ℝ}
    (hφ : ∀ p, Continuous (φ p)) {f : X → ℝ} (hf : Continuous f) (β : ℝ) (k : ℕ) :
    ∫ z, f z.1 * f z.2 * ((β * coordKernel φ z.1 z.2) ^ k / (k.factorial : ℝ)) ∂(μ.prod μ)
      = wilsonCoef β k * orderTerm μ φ f k := by
  have hpt : (fun z : X × X =>
        f z.1 * f z.2 * ((β * coordKernel φ z.1 z.2) ^ k / (k.factorial : ℝ)))
      = fun z => wilsonCoef β k * ∑ α : Fin k → P,
          (f z.1 * pmono φ α z.1) * (f z.2 * pmono φ α z.2) := by
    funext z
    have h1 : f z.1 * f z.2 * ((β * coordKernel φ z.1 z.2) ^ k / (k.factorial : ℝ))
        = wilsonCoef β k * (f z.1 * f z.2 * coordKernel φ z.1 z.2 ^ k) := by
      rw [wilsonCoef, mul_pow]
      ring
    rw [h1, coordKernel_pow, Finset.mul_sum]
    refine congrArg (wilsonCoef β k * ·) (Finset.sum_congr rfl (fun α _ => ?_))
    ring
  rw [hpt, integral_const_mul, integral_finsetSum]
  · unfold orderTerm
    refine congrArg (wilsonCoef β k * ·) (Finset.sum_congr rfl (fun α _ => ?_))
    rw [sq]
    exact integral_prod_mul (fun x => f x * pmono φ α x) (fun x => f x * pmono φ α x)
  · intro α _
    exact integrable_of_continuous
      (((hf.comp continuous_fst).mul ((continuous_pmono hφ α).comp continuous_fst)).mul
        ((hf.comp continuous_snd).mul ((continuous_pmono hφ α).comp continuous_snd)))

/-- **The crossing form is a sum of squares with coefficients `βᵏ / k!`.**

    crossForm μ φ β f = ∑ₖ (βᵏ / k!) · ∑_α (∫ f · pmono φ α dμ)².

DERIVED: no numeral appears in the statement. -/
theorem hasSum_crossForm (μ : Measure X) [IsFiniteMeasure μ] {φ : P → X → ℝ}
    (hφ : ∀ p, Continuous (φ p)) {f : X → ℝ} (hf : Continuous f) (β : ℝ) :
    HasSum (fun k => wilsonCoef β k * orderTerm μ φ f k) (crossForm μ φ β f) := by
  have hK := continuous_coordKernel hφ
  have hff : Continuous fun z : X × X => f z.1 * f z.2 :=
    (hf.comp continuous_fst).mul (hf.comp continuous_snd)
  have hβK : Continuous fun z : X × X => β * coordKernel φ z.1 z.2 := continuous_const.mul hK
  obtain ⟨M, hM⟩ := isCompact_univ.exists_bound_of_continuousOn hff.continuousOn
  obtain ⟨K, hKb⟩ := isCompact_univ.exists_bound_of_continuousOn hβK.continuousOn
  have key : HasSum (fun k : ℕ => ∫ z, f z.1 * f z.2 *
        ((β * coordKernel φ z.1 z.2) ^ k / (k.factorial : ℝ)) ∂(μ.prod μ))
      (∫ z, f z.1 * f z.2 * Real.exp (β * coordKernel φ z.1 z.2) ∂(μ.prod μ)) := by
    refine hasSum_integral_of_dominated_convergence
      (fun k _ => M * (K ^ k / (k.factorial : ℝ))) ?_ ?_ ?_ ?_ ?_
    · intro k
      exact (hff.mul ((hβK.pow k).div_const _)).aestronglyMeasurable
    · intro k
      refine ae_of_all _ (fun z => ?_)
      have h1 : ‖f z.1 * f z.2‖ ≤ M := hM z (mem_univ z)
      have h2 : ‖β * coordKernel φ z.1 z.2‖ ≤ K := hKb z (mem_univ z)
      rw [norm_mul, norm_div, norm_pow, Real.norm_natCast]
      exact mul_le_mul h1
        (div_le_div_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) h2 k) (Nat.cast_nonneg _))
        (by positivity) ((norm_nonneg _).trans h1)
    · exact ae_of_all _ (fun _ => (Real.summable_pow_div_factorial K).mul_left M)
    · exact integrable_const _
    · exact ae_of_all _ (fun z =>
        (hasSum_exp_div (β * coordKernel φ z.1 z.2)).mul_left (f z.1 * f z.2))
  have e : (fun k : ℕ => ∫ z, f z.1 * f z.2 *
        ((β * coordKernel φ z.1 z.2) ^ k / (k.factorial : ℝ)) ∂(μ.prod μ))
      = fun k => wilsonCoef β k * orderTerm μ φ f k :=
    funext fun k => integral_order μ hφ hf β k
  rw [e] at key
  exact key

/-- At `0 ≤ β` the crossing form is nonnegative.

DERIVED: both `0`s are sign conditions. -/
theorem crossForm_nonneg (μ : Measure X) [IsFiniteMeasure μ] {φ : P → X → ℝ}
    (hφ : ∀ p, Continuous (φ p)) {f : X → ℝ} (hf : Continuous f) {β : ℝ} (hβ : 0 ≤ β) :
    0 ≤ crossForm μ φ β f := by
  rw [← (hasSum_crossForm μ hφ hf β).tsum_eq]
  exact tsum_nonneg (fun k => mul_nonneg (wilsonCoef_nonneg hβ k) (orderTerm_nonneg μ φ f k))

/-- **A vanishing form kills every moment.** At `β > 0`, `crossForm μ φ β f = 0` gives
`∫ f · pmono φ α dμ = 0` for every `α : Fin k → P` and every `k`.

DERIVED: the `0`s are the sign condition on `β` and the vanishing values. -/
theorem moment_eq_zero (μ : Measure X) [IsFiniteMeasure μ] {φ : P → X → ℝ}
    (hφ : ∀ p, Continuous (φ p)) {f : X → ℝ} (hf : Continuous f) {β : ℝ} (hβ : 0 < β)
    (h0 : crossForm μ φ β f = 0) {k : ℕ} (α : Fin k → P) :
    ∫ x, f x * pmono φ α x ∂μ = 0 := by
  have hs := hasSum_crossForm μ hφ hf β
  rw [h0] at hs
  have hnn : ∀ j, 0 ≤ wilsonCoef β j * orderTerm μ φ f j :=
    fun j => mul_nonneg (wilsonCoef_nonneg hβ.le j) (orderTerm_nonneg μ φ f j)
  have hle : wilsonCoef β k * orderTerm μ φ f k ≤ 0 := le_hasSum hs k (fun j _ => hnn j)
  have hc : 0 < wilsonCoef β k :=
    div_pos (pow_pos hβ k) (Nat.cast_pos.mpr (Nat.factorial_pos k))
  have hT : orderTerm μ φ f k = 0 :=
    le_antisymm (le_of_mul_le_mul_left (by rw [mul_zero]; exact hle) hc)
      (orderTerm_nonneg μ φ f k)
  have hall := (Finset.sum_eq_zero_iff_of_nonneg (fun _ _ => sq_nonneg _)).mp hT
  exact (pow_eq_zero_iff two_ne_zero).mp (hall α (Finset.mem_univ α))

end Series

section Density

variable [TopologicalSpace X]

/-- The coordinates as continuous maps. -/
def coordCM {φ : P → X → ℝ} (hφ : ∀ p, Continuous (φ p)) (p : P) : C(X, ℝ) := ⟨φ p, hφ p⟩

/-- The subalgebra of `C(X, ℝ)` generated by the coordinates. -/
noncomputable def coordAlg {φ : P → X → ℝ} (hφ : ∀ p, Continuous (φ p)) : Subalgebra ℝ C(X, ℝ) :=
  Algebra.adjoin ℝ (Set.range (coordCM hφ))

theorem coordAlg_separatesPoints {φ : P → X → ℝ} (hφ : ∀ p, Continuous (φ p))
    (hsep : ∀ x y, (∀ p, φ p x = φ p y) → x = y) : (coordAlg hφ).SeparatesPoints := by
  intro x y hxy
  by_contra hne
  exact hxy (hsep x y fun p => by
    by_contra hp
    exact hne ⟨_, ⟨coordCM hφ p, Algebra.subset_adjoin ⟨p, rfl⟩, rfl⟩, hp⟩)

/-- Every element of the multiplicative closure of the coordinates is a monomial `pmono φ α`. -/
theorem mem_closure_coords {φ : P → X → ℝ} (hφ : ∀ p, Continuous (φ p)) {g : C(X, ℝ)}
    (hg : g ∈ Submonoid.closure (Set.range (coordCM hφ))) :
    ∃ (k : ℕ) (α : Fin k → P), ⇑g = pmono φ α := by
  induction hg using Submonoid.closure_induction with
  | mem u hu =>
    obtain ⟨p, rfl⟩ := hu
    exact ⟨1, fun _ => p, by funext x; simp [pmono, coordCM]⟩
  | one => exact ⟨0, Fin.elim0, by funext x; simp [pmono]⟩
  | mul u v _ _ ihu ihv =>
    obtain ⟨k, α, hα⟩ := ihu
    obtain ⟨l, γ, hγ⟩ := ihv
    refine ⟨k + l, Fin.append α γ, ?_⟩
    funext x
    simp only [ContinuousMap.mul_apply, hα, hγ, pmono, Fin.prod_univ_add, Fin.append_left,
      Fin.append_right]

variable [CompactSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]

/-- Integration against `f`, as a linear functional on `C(X, ℝ)`. -/
noncomputable def pairLin (μ : Measure X) [IsFiniteMeasure μ] (f : C(X, ℝ)) :
    C(X, ℝ) →ₗ[ℝ] ℝ where
  toFun g := ∫ x, f x * g x ∂μ
  map_add' g h := by
    simp only [ContinuousMap.add_apply, mul_add]
    exact integral_add (integrable_of_continuous (f.continuous.mul g.continuous))
      (integrable_of_continuous (f.continuous.mul h.continuous))
  map_smul' c g := by
    simp only [ContinuousMap.smul_apply, smul_eq_mul, RingHom.id_apply]
    rw [← integral_const_mul]
    congr 1
    funext x
    ring

theorem continuous_pairLin (μ : Measure X) [IsFiniteMeasure μ] (f : C(X, ℝ)) :
    Continuous (pairLin μ f) := by
  refine AddMonoidHomClass.continuous_of_bound (pairLin μ f) (‖f‖ * μ.real univ) (fun g => ?_)
  have h := norm_integral_le_of_norm_le_const (μ := μ) (f := fun x => f x * g x)
    (C := ‖f‖ * ‖g‖) (ae_of_all _ fun x => by
      rw [norm_mul]
      exact mul_le_mul (f.norm_coe_le_norm x) (g.norm_coe_le_norm x) (norm_nonneg _)
        (norm_nonneg _))
  calc ‖pairLin μ f g‖ = ‖∫ x, f x * g x ∂μ‖ := rfl
    _ ≤ ‖f‖ * ‖g‖ * μ.real univ := h
    _ = ‖f‖ * μ.real univ * ‖g‖ := by ring

end Density

section Definite

variable [TopologicalSpace X] [CompactSpace X] [SecondCountableTopology X] [MeasurableSpace X]
  [BorelSpace X] [Fintype P]

/-- **The crossing form is definite.** On a compact second-countable space with a finite measure
that charges every nonempty open set, with continuous coordinates separating points and `β > 0`,
`crossForm μ φ β f = 0` forces the continuous function `f` to vanish.

DERIVED: the `0`s are the sign condition on `β` and the vanishing values. -/
theorem eq_zero_of_crossForm_eq_zero (μ : Measure X) [IsFiniteMeasure μ] [μ.IsOpenPosMeasure]
    {φ : P → X → ℝ} (hφ : ∀ p, Continuous (φ p)) (hsep : ∀ x y, (∀ p, φ p x = φ p y) → x = y)
    {β : ℝ} (hβ : 0 < β) (f : C(X, ℝ)) (h0 : crossForm μ φ β f = 0) : f = 0 := by
  have hvan : ∀ g ∈ (coordAlg hφ : Set C(X, ℝ)), pairLin μ f g = 0 := by
    intro g hg
    have hg' : g ∈ Subalgebra.toSubmodule (coordAlg hφ) := hg
    clear hg
    rw [coordAlg, Algebra.adjoin_eq_span] at hg'
    induction hg' using Submodule.span_induction with
    | mem u hu =>
      obtain ⟨k, α, hα⟩ := mem_closure_coords hφ hu
      show ∫ x, f x * u x ∂μ = 0
      rw [hα]
      exact moment_eq_zero μ hφ f.continuous hβ h0 α
    | zero => exact map_zero _
    | add u v _ _ hu hv => rw [map_add, hu, hv, add_zero]
    | smul c u _ hu => rw [map_smul, hu, smul_zero]
  have hclosed : IsClosed {g : C(X, ℝ) | pairLin μ f g = 0} :=
    isClosed_eq (continuous_pairLin μ f) continuous_const
  have htop := ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints
    (coordAlg hφ) (coordAlg_separatesPoints hφ hsep)
  have hf_mem : f ∈ closure (coordAlg hφ : Set C(X, ℝ)) := by
    rw [← Subalgebra.topologicalClosure_coe, htop]
    exact Algebra.mem_top
  have hff : pairLin μ f f = 0 := closure_minimal hvan hclosed hf_mem
  have hsq : ∫ x, f x * f x ∂μ = 0 := hff
  have hc : Continuous fun x => f x * f x := f.continuous.mul f.continuous
  have hae := (integral_eq_zero_iff_of_nonneg (f := fun x => f x * f x)
    (fun x => mul_self_nonneg (f x)) (integrable_of_continuous hc)).mp hsq
  have hpt : (fun x => f x * f x) = (0 : X → ℝ) := Measure.eq_of_ae_eq hae hc continuous_zero
  ext x
  have hx := congrFun hpt x
  simpa using mul_self_eq_zero.mp hx

/-- The crossing form vanishes exactly at `f = 0`.

DERIVED: the `0`s are the sign condition on `β` and the vanishing values. -/
theorem crossForm_eq_zero_iff (μ : Measure X) [IsFiniteMeasure μ] [μ.IsOpenPosMeasure]
    {φ : P → X → ℝ} (hφ : ∀ p, Continuous (φ p)) (hsep : ∀ x y, (∀ p, φ p x = φ p y) → x = y)
    {β : ℝ} (hβ : 0 < β) (f : C(X, ℝ)) : crossForm μ φ β f = 0 ↔ f = 0 := by
  refine ⟨eq_zero_of_crossForm_eq_zero μ hφ hsep hβ f, ?_⟩
  rintro rfl
  simp [crossForm]

/-- **Through a nowhere-vanishing weight.** For continuous `w` with `w x ≠ 0` everywhere, the form
at `w · f` vanishes exactly at `f = 0`. A kernel `w(x)^{1/2} K(x, y) w(y)^{1/2}` with `w > 0` is of
this shape.

DERIVED: the `0`s are the sign condition on `β`, the non-vanishing of `w` and the vanishing
values. -/
theorem weighted_crossForm_eq_zero_iff (μ : Measure X) [IsFiniteMeasure μ] [μ.IsOpenPosMeasure]
    {φ : P → X → ℝ} (hφ : ∀ p, Continuous (φ p)) (hsep : ∀ x y, (∀ p, φ p x = φ p y) → x = y)
    {β : ℝ} (hβ : 0 < β) (w : C(X, ℝ)) (hw : ∀ x, w x ≠ 0) (f : C(X, ℝ)) :
    crossForm μ φ β (fun x => w x * f x) = 0 ↔ f = 0 := by
  rw [show (fun x => w x * f x) = ⇑(w * f) from rfl, crossForm_eq_zero_iff μ hφ hsep hβ]
  constructor
  · intro h
    ext x
    have hx := congrArg (fun g : C(X, ℝ) => g x) h
    simp only [ContinuousMap.mul_apply, ContinuousMap.zero_apply] at hx
    simpa using (mul_eq_zero.mp hx).resolve_left (hw x)
  · rintro rfl
    simp

end Definite

end General

/-! ## 2. One link and one plane of links on `SU(N)` -/

section SU

open MassGap.SUN MassGap.CompactGauge

variable {N : ℕ}

/-- The real coordinates of an element of `SU N`: real and imaginary parts of its entries. -/
noncomputable def suCoord (p : Coord N) (u : SU N) : ℝ :=
  coord p (u : Matrix (Fin N) (Fin N) ℂ)

theorem continuous_suCoord (p : Coord N) : Continuous (suCoord (N := N) p) := by
  obtain ⟨i, j, b⟩ := p
  have hij : Continuous fun u : SU N => (u : Matrix (Fin N) (Fin N) ℂ) i j :=
    continuous_subtype_val.matrix_elem i j
  cases b
  · show Continuous fun u : SU N => coord (i, j, false) (u : Matrix (Fin N) (Fin N) ℂ)
    simp only [coord, Bool.false_eq_true, ↓reduceIte]
    exact Complex.continuous_im.comp hij
  · show Continuous fun u : SU N => coord (i, j, true) (u : Matrix (Fin N) (Fin N) ℂ)
    simp only [coord, ↓reduceIte]
    exact Complex.continuous_re.comp hij

theorem suCoord_sep (u v : SU N) (h : ∀ p, suCoord p u = suCoord p v) : u = v := by
  apply Subtype.ext
  ext i j
  apply Complex.ext
  · simpa [suCoord, coord] using h (i, j, true)
  · simpa [suCoord, coord] using h (i, j, false)

theorem coordKernel_suCoord (u v : SU N) :
    coordKernel suCoord u v = hsRe (u : Matrix (Fin N) (Fin N) ℂ) v :=
  (hsRe_eq_sum _ _).symm

/-- **One link.** At `β > 0` the single-link crossing form
`∫∫ f(u) f(v) exp (β Re tr (u vᴴ)) dHaar dHaar` vanishes on a continuous `f` only at `f = 0`.

DERIVED: the `0`s are the sign condition on `β` and the vanishing values. -/
theorem link_form_eq_zero_iff {β : ℝ} (hβ : 0 < β) (f : C(SU N, ℝ)) :
    ∫ z, f z.1 * f z.2 * Real.exp (β * hsRe (z.1 : Matrix (Fin N) (Fin N) ℂ) z.2)
        ∂((probHaar (SU N)).prod (probHaar (SU N))) = 0 ↔ f = 0 := by
  have h := crossForm_eq_zero_iff (probHaar (SU N)) continuous_suCoord suCoord_sep hβ f
  simp only [crossForm, coordKernel_suCoord] at h
  exact h

/-- The coordinates of a configuration of `ι` links. -/
noncomputable def planeCoord {ι : Type*} (q : ι × Coord N) (U : ι → SU N) : ℝ :=
  suCoord q.2 (U q.1)

theorem continuous_planeCoord {ι : Type*} (q : ι × Coord N) :
    Continuous (planeCoord (N := N) (ι := ι) q) :=
  (continuous_suCoord q.2).comp (continuous_apply q.1)

theorem planeCoord_sep {ι : Type*} (U V : ι → SU N) (h : ∀ q, planeCoord q U = planeCoord q V) :
    U = V :=
  funext fun l => suCoord_sep (U l) (V l) (fun p => h (l, p))

theorem exp_coordKernel_planeCoord {ι : Type*} [Fintype ι] (β : ℝ) (U V : ι → SU N) :
    Real.exp (β * coordKernel planeCoord U V)
      = ∏ l, Real.exp (β * hsRe (U l : Matrix (Fin N) (Fin N) ℂ) (V l)) := by
  rw [← Real.exp_sum, ← Finset.mul_sum]
  congr 2
  unfold coordKernel
  rw [Fintype.sum_prod_type]
  exact Finset.sum_congr rfl
    (fun l _ => (hsRe_eq_sum (U l : Matrix (Fin N) (Fin N) ℂ) (V l)).symm)

/-- **One plane of crossing links.** For a finite family `ι` of links, with the product Haar
measure on `ι → SU N` and the product kernel `∏ₗ exp (β Re tr (U_l V_lᴴ))`, the crossing form
vanishes on a continuous `f` only at `f = 0`, at `β > 0`.

DERIVED: the `0`s are the sign condition on `β` and the vanishing values. -/
theorem plane_form_eq_zero_iff {ι : Type*} [Fintype ι] {β : ℝ} (hβ : 0 < β)
    (f : C(ι → SU N, ℝ)) :
    ∫ z, f z.1 * f z.2 * ∏ l, Real.exp (β * hsRe (z.1 l : Matrix (Fin N) (Fin N) ℂ) (z.2 l))
        ∂((Measure.pi fun _ : ι => probHaar (SU N)).prod (Measure.pi fun _ : ι => probHaar (SU N)))
      = 0 ↔ f = 0 := by
  have h := crossForm_eq_zero_iff (Measure.pi fun _ : ι => probHaar (SU N))
    continuous_planeCoord planeCoord_sep hβ f
  simp only [crossForm, exp_coordKernel_planeCoord] at h
  exact h

end SU

