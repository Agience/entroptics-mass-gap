variable {N : ℕ}

/-- **The flow-side inputs give the general-`N` bundle** at the observer `sunFam hN2 c hc0 hc s₀`: module
docstring, §2. DERIVED: `2` the least colour count; `0` the lower end of the observer's scale; `12 = 2 · 6`
the block-step coupling bound of `ObserverFlowSUN.det_blockMatN_mem_slitPlane`. -/
theorem inputsAt_of_flow (hN2 : 2 ≤ N) [NeZero N] {c : ℝ} (hc0 : 0 ≤ c)
    (hc : 12 * c < Real.sin (Real.pi / N)) {s₀ r : ℝ} (hs0 : 0 ≤ s₀) (hr : s₀ < r)
    {zri zwe : ℕ → ℝ} (hri : ∀ k, zri k ≠ 0) (hwe : ∀ k, zwe k ≠ 0) {μ : OffMix} {b : ℝ}
    {Wf : ℝ → ConfFlow N} {cf : Ix0 → ℝ → (MIx →₀ ℝ)}
    (S : SubstrateCoreAt (sunFam hN2 c hc0 hc s₀) (ZCanon.zFix N zri zwe) b Wf)
    (F : GradientFlowPropsN Wf cf (ZCanon.zFix N zri zwe) μ)
    (hL : ProxyGenLim (sunFam hN2 c hc0 hc s₀) b Wf cf r)
    (h3 : ∃ ℓ : ℝ, 0 < ℓ ∧ ThreePointAtScale (ne_zero_of_two_le hN2) ℓ)
    (hfar : WDeltaRun.RunSeed N) :
    ∃ (t C : ℝ) (G : ℝ → ℝ),
      SUNBest.InputsAt hN2 (sunFam hN2 c hc0 hc s₀) r t |C| zri zwe μ G := by
  have hE := expandR_of_strong F.props.expand
  obtain ⟨t, C, ht, hS⟩ := uv_of_scale S.b_pos S.top S.scale
  have hU := ClaySUFinal.classMoments_of_siteExp (NeZero.ne N) (sunFam hN2 c hc0 hc s₀) ht hS
  have hphys := sunFam_physRange hN2 hc0 hc hs0 hr
  have hCO : CompOS (NeZero.ne N) (CRen N (ZCanon.zFix N zri zwe) μ) :=
    ⟨convC_of_core S F.props, os0C_of_scale_expand_coef S.b_pos S.scale hE F.props.coef,
      os1C_of_scale_expand S.b_pos S.scale hE,
      covC_of_scale_strong S.b_pos S.scale F.props.expand F.props.cov,
      compNondeg_of_core S F.props F.nondeg⟩
  obtain ⟨G, hK, hAF⟩ := S.af
  obtain ⟨ℓ, hℓ, h3'⟩ := h3
  exact ⟨t, C, G,
    { t_pos := ht
      moments := hU
      phys := hphys
      far := hfar
      hri := hri
      hwe := hwe
      kernel := hK
      af := hAF
      low := obsLower_of_scale (ne_zero_of_two_le hN2) hℓ zri zwe h3'
      ward := wardT_of_core S F.props
      comp := hCO
      approx := approxK_of_expandRP_SU hN2 hU hphys hCO (expandRP_of_strong S.b_pos F.props.expand)
        (proxyGen_of_lim (uB_of_core S) (proxyBound_of_core S) hL) }⟩

/-- **The `SU(N)` capstone at the block-step observer**: module docstring, §2. DERIVED: `2` the least
colour count; `0` the lower end of the observer's scale; `12 = 2 · 6` the block-step coupling bound of
`ObserverFlowSUN.det_blockMatN_mem_slitPlane`. -/
theorem clayStatementAt_sun_flow (hN2 : 2 ≤ N) [NeZero N] {c : ℝ} (hc0 : 0 ≤ c)
    (hc : 12 * c < Real.sin (Real.pi / N)) {s₀ r : ℝ} (hs0 : 0 ≤ s₀) (hr : s₀ < r)
    {zri zwe : ℕ → ℝ} (hri : ∀ k, zri k ≠ 0) (hwe : ∀ k, zwe k ≠ 0) {μ : OffMix} {b : ℝ}
    {Wf : ℝ → ConfFlow N} {cf : Ix0 → ℝ → (MIx →₀ ℝ)}
    (S : SubstrateCoreAt (sunFam hN2 c hc0 hc s₀) (ZCanon.zFix N zri zwe) b Wf)
    (F : GradientFlowPropsN Wf cf (ZCanon.zFix N zri zwe) μ)
    (hL : ProxyGenLim (sunFam hN2 c hc0 hc s₀) b Wf cf r)
    (h3 : ∃ ℓ : ℝ, 0 < ℓ ∧ ThreePointAtScale (ne_zero_of_two_le hN2) ℓ)
    (hfar : WDeltaRun.RunSeed N) :
    ClayStatementAt hN2 (sunFam hN2 c hc0 hc s₀) (SymPlaqClass N) (symPlaq_refl N) := by
  obtain ⟨t, C, G, I⟩ := inputsAt_of_flow hN2 hc0 hc hs0 hr hri hwe S F hL h3 hfar
  exact SUNBest.clayStatementAt_N_best I

/-- **The flow-side inputs at `SU(N)`**: some block-step observer `sunFam hN2 c hc0 hc s₀`, margin
`r > s₀ ≥ 0`, channel factors, substrate core, flow bundle, `ProxyGenLim`, three-point clause and gap.
DERIVED: `2` the least colour count; `0` the lower end of the observer's scale. -/
def FlowInputsN (N : ℕ) (hN2 : 2 ≤ N) : Prop :=
  haveI : NeZero N := ⟨by omega⟩
  ∃ (c : ℝ) (hc0 : 0 ≤ c) (hc : 12 * c < Real.sin (Real.pi / N)) (s₀ r : ℝ) (_ : 0 ≤ s₀) (_ : s₀ < r)
    (zri zwe : ℕ → ℝ) (_ : ∀ k, zri k ≠ 0) (_ : ∀ k, zwe k ≠ 0) (μ : OffMix) (b : ℝ)
    (Wf : ℝ → ConfFlow N) (cf : Ix0 → ℝ → (MIx →₀ ℝ)),
    SubstrateCoreAt (sunFam hN2 c hc0 hc s₀) (ZCanon.zFix N zri zwe) b Wf
      ∧ GradientFlowPropsN Wf cf (ZCanon.zFix N zri zwe) μ
      ∧ ProxyGenLim (sunFam hN2 c hc0 hc s₀) b Wf cf r
      ∧ (∃ ℓ : ℝ, 0 < ℓ ∧ ThreePointAtScale (ne_zero_of_two_le hN2) ℓ)
      ∧ WDeltaRun.RunSeed N

/-- **`FlowInputsN` gives `SUNBest.ClayInputsN`.** DERIVED: `2` the least colour count. -/
theorem clayInputsN_of_flow (hN2 : 2 ≤ N) (h : FlowInputsN N hN2) : SUNBest.ClayInputsN N hN2 := by
  haveI : NeZero N := ⟨by omega⟩
  obtain ⟨c, hc0, hc, s₀, r, hs0, hr, zri, zwe, hri, hwe, μ, b, Wf, cf, S, F, hL, h3, hfar⟩ := h
  obtain ⟨t, C, G, I⟩ := inputsAt_of_flow hN2 hc0 hc hs0 hr hri hwe S F hL h3 hfar
  exact ⟨sunFam hN2 c hc0 hc s₀, r, t, |C|, zri, zwe, μ, G, I⟩

/-- **`ClayStatementDy` from the flow-side inputs at every `N ≥ 2`** (`SUNBest.clayStatement_of_inputs`).
DERIVED: `2` the least colour count. -/
theorem clayStatement_of_flow (h : ∀ (N : ℕ) (hN2 : 2 ≤ N), FlowInputsN N hN2) :
    MassGap.ClayStatementDy :=
  SUNBest.clayStatement_of_inputs fun N hN2 => clayInputsN_of_flow hN2 (h N hN2)

end MassGap.SUNFromScale

